      @rwx V.U.is_eq(size, 1, P.Bool.and_r(U32.is_eq(t, 1), U32.is_eq(size, 1), P.Bool.and_l(Bool.and(U32.is_eq(t, 1), U32.is_eq(size, 1)), U32.is_eq(pt, 3), P.Bool.and_l(Bool.and(Bool.and(U32.is_eq(t, 1), U32.is_eq(size, 1)), U32.is_eq(pt, 3)), U32.is_eq(ps, 4), eca)))) : {size == 1 : U32}
