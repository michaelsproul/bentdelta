law CT.copy.f:
  for +size: U32
  for +mode: U32
  for +km: Nat
  for +ekm: {V.U.N(mode) == km : Nat}
  for +hm: {Cmp.is_le(Nat.cmp(km, 8n)) == True{} : Bool}
  {CT.S(U32.add(U32.add(19, U32.mul(16, mode)), 0), 3, size, mode) == True{} : Bool}

def CT.copy.f(size, mode, km, ekm, hm):
  match km:
    case 0n:
      @rwx V.U.eq_N(mode, 0, ekm) : {mode == 0 : U32}
      {==}
    case 1n:
      @rwx V.U.eq_N(mode, 1, ekm) : {mode == 1 : U32}
      {==}
    case 2n:
      @rwx V.U.eq_N(mode, 2, ekm) : {mode == 2 : U32}
      {==}
    case 3n:
      @rwx V.U.eq_N(mode, 3, ekm) : {mode == 3 : U32}
      {==}
    case 4n:
      @rwx V.U.eq_N(mode, 4, ekm) : {mode == 4 : U32}
      {==}
    case 5n:
      @rwx V.U.eq_N(mode, 5, ekm) : {mode == 5 : U32}
      {==}
    case 6n:
      @rwx V.U.eq_N(mode, 6, ekm) : {mode == 6 : U32}
      {==}
    case 7n:
      @rwx V.U.eq_N(mode, 7, ekm) : {mode == 7 : U32}
      {==}
    case 8n:
      @rwx V.U.eq_N(mode, 8, ekm) : {mode == 8 : U32}
      {==}
    case 9n+r:
      @absurd hm


law CT.copy.c:
  for +size: U32
  for +mode: U32
  for +hm: {Cmp.is_le(Nat.cmp(V.U.N(mode), 8n)) == True{} : Bool}
  for +c: Bool
  for +ec: {Bool.and(U32.is_le(4, size), U32.is_le(size, 18)) == c : Bool}
  {CT.S(N.op.single(3, size, mode), 3, size, mode) == True{} : Bool}

def CT.copy.c(size, mode, hm, c, ec):
  match c:
    case True{}:
      CT.copy.e(size, mode, V.U.N(size), V.U.N(mode), {==}, {==},
        V.U.le_N(4, size, P.Bool.and_l(U32.is_le(4, size), U32.is_le(size, 18), ec)),
        V.U.le_N(size, 18, P.Bool.and_r(U32.is_le(4, size), U32.is_le(size, 18), ec)), hm)
    case False{}:
      @unfold N.op.single N.u32.pick
      @simp -CT.S
      @rwx ec : {Bool.and(U32.is_le(4, size), U32.is_le(size, 18)) == False{} : Bool}
      @simp -CT.S
      CT.copy.f(size, mode, V.U.N(mode), {==}, hm)

# A COPY alone.
law CT.copy:
  for +size: U32
  for +mode: U32
  for +hm: {Cmp.is_le(Nat.cmp(V.U.N(mode), 8n)) == True{} : Bool}
  {CT.S(N.op.single(3, size, mode), 3, size, mode) == True{} : Bool}

def CT.copy(size, mode, hm):
  CT.copy.c(size, mode, hm, Bool.and(U32.is_le(4, size), U32.is_le(size, 18)), {==})


law CT.dbl.a.e:
  for +pm: U32
  for +mode: U32
  for +k: Nat
  for +ek: {V.U.N(pm) == k : Nat}
  for +hb: {Cmp.is_le(Nat.cmp(k, 8n)) == True{} : Bool}
  {CT.D(Bool.pick(U32, Bool.and(Bool.and(Bool.and(U32.is_eq(1, 1), U32.is_eq(1, 1)), U32.is_eq(3, 3)), U32.is_eq(4, 4)), U32.add(247, pm), Bool.pick(U32, Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(U32.is_eq(1, 3), U32.is_le(4, 1)), U32.is_le(1, 18)), U32.is_eq(3, 1)), U32.is_le(1, 4)), U32.is_le(4, 4)), U32.is_le(1, 6)), U32.is_le(mode, 5)), U32.add(U32.add(U32.add(163, U32.mul(mode, 12)), U32.mul(U32.sub(4, 1), 3)), U32.sub(1, 4)), Bool.pick(U32, Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(U32.is_eq(1, 3), U32.is_le(4, 1)), U32.is_le(1, 18)), U32.is_eq(3, 1)), U32.is_le(1, 4)), U32.is_le(4, 4)), U32.is_eq(1, 4)), U32.is_ge(mode, 6)), U32.add(U32.add(235, U32.mul(U32.sub(mode, 6), 4)), U32.sub(4, 1)), 0))), 3, 4, pm, 1, 1, mode) == True{} : Bool}

def CT.dbl.a.e(pm, mode, k, ek, hb):
  match k:
    case 0n:
      @rwx V.U.eq_N(pm, 0, ek) : {pm == 0 : U32}
      {==}
    case 1n:
      @rwx V.U.eq_N(pm, 1, ek) : {pm == 1 : U32}
      {==}
    case 2n:
      @rwx V.U.eq_N(pm, 2, ek) : {pm == 2 : U32}
      {==}
    case 3n:
      @rwx V.U.eq_N(pm, 3, ek) : {pm == 3 : U32}
      {==}
    case 4n:
      @rwx V.U.eq_N(pm, 4, ek) : {pm == 4 : U32}
      {==}
    case 5n:
      @rwx V.U.eq_N(pm, 5, ek) : {pm == 5 : U32}
      {==}
    case 6n:
      @rwx V.U.eq_N(pm, 6, ek) : {pm == 6 : U32}
      {==}
    case 7n:
      @rwx V.U.eq_N(pm, 7, ek) : {pm == 7 : U32}
      {==}
    case 8n:
      @rwx V.U.eq_N(pm, 8, ek) : {pm == 8 : U32}
      {==}
    case 9n+r:
      @absurd hb


law CT.dbl.b.e:
  for +pt: U32
  for +ps: U32
  for +pm: U32
  for +t: U32
  for +size: U32
  for +mode: U32
  for +ks: Nat
  for +kp: Nat
  for +km: Nat
  for +eks: {V.U.N(size) == ks : Nat}
  for +ekp: {V.U.N(ps) == kp : Nat}
  for +ekm: {V.U.N(mode) == km : Nat}
  for +et: {t == 3 : U32}
  for +ept: {pt == 1 : U32}
  for +slo: {Cmp.is_le(Nat.cmp(4n, ks)) == True{} : Bool}
  for +shi: {Cmp.is_le(Nat.cmp(ks, 6n)) == True{} : Bool}
  for +plo: {Cmp.is_le(Nat.cmp(1n, kp)) == True{} : Bool}
  for +phi: {Cmp.is_le(Nat.cmp(kp, 4n)) == True{} : Bool}
  for +mhi: {Cmp.is_le(Nat.cmp(km, 5n)) == True{} : Bool}
  {CT.D(N.op.double(pt, ps, pm, t, size, mode), pt, ps, pm, t, size, mode) == True{} : Bool}

def CT.dbl.b.e(pt, ps, pm, t, size, mode, ks, kp, km, eks, ekp, ekm, et, ept, slo, shi, plo, phi, mhi):
  match ks kp km:
    case 0n _ _:
      @absurd slo
    case 1n _ _:
      @absurd slo
    case 2n _ _:
      @absurd slo
    case 3n _ _:
      @absurd slo
    case 4n 0n _:
      @absurd plo
    case 4n 1n 0n:
      @rwx et : {t == 3 : U32}
      @rwx ept : {pt == 1 : U32}
      @rwx V.U.eq_N(size, 4, eks) : {size == 4 : U32}
      @rwx V.U.eq_N(ps, 1, ekp) : {ps == 1 : U32}
      @rwx V.U.eq_N(mode, 0, ekm) : {mode == 0 : U32}
      {==}
    case 4n 1n 1n:
      @rwx et : {t == 3 : U32}
      @rwx ept : {pt == 1 : U32}
      @rwx V.U.eq_N(size, 4, eks) : {size == 4 : U32}
      @rwx V.U.eq_N(ps, 1, ekp) : {ps == 1 : U32}
      @rwx V.U.eq_N(mode, 1, ekm) : {mode == 1 : U32}
      {==}
    case 4n 1n 2n:
      @rwx et : {t == 3 : U32}
      @rwx ept : {pt == 1 : U32}
      @rwx V.U.eq_N(size, 4, eks) : {size == 4 : U32}
      @rwx V.U.eq_N(ps, 1, ekp) : {ps == 1 : U32}
      @rwx V.U.eq_N(mode, 2, ekm) : {mode == 2 : U32}
      {==}
    case 4n 1n 3n:
      @rwx et : {t == 3 : U32}
      @rwx ept : {pt == 1 : U32}
      @rwx V.U.eq_N(size, 4, eks) : {size == 4 : U32}
      @rwx V.U.eq_N(ps, 1, ekp) : {ps == 1 : U32}
      @rwx V.U.eq_N(mode, 3, ekm) : {mode == 3 : U32}
      {==}
    case 4n 1n 4n:
      @rwx et : {t == 3 : U32}
      @rwx ept : {pt == 1 : U32}
      @rwx V.U.eq_N(size, 4, eks) : {size == 4 : U32}
      @rwx V.U.eq_N(ps, 1, ekp) : {ps == 1 : U32}
      @rwx V.U.eq_N(mode, 4, ekm) : {mode == 4 : U32}
      {==}
    case 4n 1n 5n:
      @rwx et : {t == 3 : U32}
      @rwx ept : {pt == 1 : U32}
      @rwx V.U.eq_N(size, 4, eks) : {size == 4 : U32}
      @rwx V.U.eq_N(ps, 1, ekp) : {ps == 1 : U32}
      @rwx V.U.eq_N(mode, 5, ekm) : {mode == 5 : U32}
      {==}
    case 4n 1n 6n+r:
      @absurd mhi
    case 4n 2n 0n:
