    case 256n+r:
      @absurd hb

# The decoder's table holds the code table.
law CT.tab:
  for +c: U32
  for +hc: {U32.is_lt(c, 256) == True{} : Bool}
  {A.T.word(A.A.to(D.ct.table()), c) == D.ct.entry(c) : U32}

def CT.tab(c, hc):
  @rw CT.tt()
  CT.tab.e(c, V.U.N(c), {==}, P.Nat.lt_succ_le(V.U.N(c), 255n, V.U.lt_N(c, 256, hc)))
