import Base
import ../bytes.bend as B
import ../vcdiff.bend as D
import ../encode.bend as N
import ./nat.bend as P
import ./u32.bend as V
import ./array.bend as A
import ./spec.bend as Q

# The encoder's opcodes fit the code table: op.single and op.double pick
# entries whose halves are the instructions written, with sizes in the
# instruction section exactly when op.sized says. Each is checked case by
# case over the values the encoder uses.
#
# Source: proofs/ctab.bp (generated by a script; tools/bpp.py writes
# proofs/ctab.bend from it).

# A table half fits an instruction of type k, size n and mode m (as
# Q.SP.hok does for a half of that type, size and mode).
def CT.hok3(+h: U32, +k: U32, +n: U32, +m: U32) -> Bool:
  U32.is_eq(Q.SP.ht(h), k)
    && (U32.is_eq(Q.SP.hs(h), 0) || U32.is_eq(Q.SP.hs(h), n))
    && (U32.is_ne(k, 3) || U32.is_eq(Q.SP.hm(h), m))

# A single opcode c for an instruction (k, n, m).
def CT.S(+c: U32, +k: U32, +n: U32, +m: U32) -> Bool:
  Bool.and(U32.is_lt(c, 256), Bool.and(CT.hok3(Q.SP.e1(c), k, n, m), Bool.and(CT.hok3(Q.SP.e2(c), 0, 0, 0),
    Bool.and(Bool.or(Bool.and(Q.SP.z(Q.SP.e1(c)), N.op.sized(c)), Bool.and(Bool.not(Q.SP.z(Q.SP.e1(c))), Bool.not(N.op.sized(c)))), Bool.not(Q.SP.z(Q.SP.e2(c)))))))

# A double opcode c for instructions (pt, ps, pm) then (t, size, mode).
def CT.D(+c: U32, +pt: U32, +ps: U32, +pm: U32, +t: U32, +size: U32, +mode: U32) -> Bool:
  Bool.and(U32.is_lt(c, 256), Bool.and(CT.hok3(Q.SP.e1(c), pt, ps, pm), Bool.and(CT.hok3(Q.SP.e2(c), t, size, mode),
    Bool.and(Bool.not(Q.SP.z(Q.SP.e1(c))), Bool.not(Q.SP.z(Q.SP.e2(c)))))))


law CT.add.e:
  for +size: U32
  for +k: Nat
  for +ek: {V.U.N(size) == k : Nat}
  for +hb: {Cmp.is_le(Nat.cmp(k, 17n)) == True{} : Bool}
  {CT.S(N.op.single(1, size, 0), 1, size, 0) == True{} : Bool}

def CT.add.e(size, k, ek, hb):
  match k:
    case 0n:
      @rwx V.U.eq_N(size, 0, ek) : {size == 0 : U32}
      {==}
    case 1n:
      @rwx V.U.eq_N(size, 1, ek) : {size == 1 : U32}
      {==}
    case 2n:
      @rwx V.U.eq_N(size, 2, ek) : {size == 2 : U32}
      {==}
    case 3n:
      @rwx V.U.eq_N(size, 3, ek) : {size == 3 : U32}
      {==}
    case 4n:
      @rwx V.U.eq_N(size, 4, ek) : {size == 4 : U32}
      {==}
    case 5n:
      @rwx V.U.eq_N(size, 5, ek) : {size == 5 : U32}
      {==}
    case 6n:
      @rwx V.U.eq_N(size, 6, ek) : {size == 6 : U32}
      {==}
    case 7n:
      @rwx V.U.eq_N(size, 7, ek) : {size == 7 : U32}
      {==}
    case 8n:
      @rwx V.U.eq_N(size, 8, ek) : {size == 8 : U32}
      {==}
    case 9n:
      @rwx V.U.eq_N(size, 9, ek) : {size == 9 : U32}
      {==}
    case 10n:
      @rwx V.U.eq_N(size, 10, ek) : {size == 10 : U32}
      {==}
    case 11n:
      @rwx V.U.eq_N(size, 11, ek) : {size == 11 : U32}
      {==}
    case 12n:
      @rwx V.U.eq_N(size, 12, ek) : {size == 12 : U32}
      {==}
    case 13n:
      @rwx V.U.eq_N(size, 13, ek) : {size == 13 : U32}
      {==}
    case 14n:
      @rwx V.U.eq_N(size, 14, ek) : {size == 14 : U32}
      {==}
    case 15n:
      @rwx V.U.eq_N(size, 15, ek) : {size == 15 : U32}
      {==}
    case 16n:
      @rwx V.U.eq_N(size, 16, ek) : {size == 16 : U32}
      {==}
    case 17n:
      @rwx V.U.eq_N(size, 17, ek) : {size == 17 : U32}
      {==}
    case 18n+r:
      @absurd hb


law CT.add.c:
  for +size: U32
  for +c: Bool
  for +ec: {U32.is_le(size, 17) == c : Bool}
  {CT.S(N.op.single(1, size, 0), 1, size, 0) == True{} : Bool}

def CT.add.c(size, c, ec):
  match c:
    case True{}:
      CT.add.e(size, V.U.N(size), {==}, V.U.le_N(size, 17, ec))
    case False{}:
      @unfold N.op.single N.u32.pick
      @simp -CT.S
      @rwx ec : {U32.is_le(size, 17) == False{} : Bool}
      @simp -CT.S
      {==}

# An ADD alone.
law CT.add:
  for +size: U32
  {CT.S(N.op.single(1, size, 0), 1, size, 0) == True{} : Bool}

def CT.add(size):
  CT.add.c(size, U32.is_le(size, 17), {==})

# A RUN alone.
law CT.run:
  for +size: U32
  {CT.S(N.op.single(2, size, 0), 2, size, 0) == True{} : Bool}

def CT.run(size):
  {==}


law CT.copy.e:
  for +size: U32
  for +mode: U32
  for +ks: Nat
  for +km: Nat
  for +eks: {V.U.N(size) == ks : Nat}
  for +ekm: {V.U.N(mode) == km : Nat}
  for +lo: {Cmp.is_le(Nat.cmp(4n, ks)) == True{} : Bool}
  for +hi: {Cmp.is_le(Nat.cmp(ks, 18n)) == True{} : Bool}
  for +hm: {Cmp.is_le(Nat.cmp(km, 8n)) == True{} : Bool}
  {CT.S(N.op.single(3, size, mode), 3, size, mode) == True{} : Bool}

def CT.copy.e(size, mode, ks, km, eks, ekm, lo, hi, hm):
