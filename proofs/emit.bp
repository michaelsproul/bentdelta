# A single opcode
# ===============

law EM.pick_le:
  for +c: Bool
  for +a: U32
  for +b: U32
  for +n: Nat
  for +ha: {Cmp.is_le(Nat.cmp(V.U.N(a), n)) == True{} : Bool}
  for +hb: {Cmp.is_le(Nat.cmp(V.U.N(b), n)) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(V.U.N(B.u32.pick(c, a, b)), n)) == True{} : Bool}

def EM.pick_le(c, a, b, n, ha, hb):
  match c:
    case True{}:
      ha
    case False{}:
      hb

# A varint takes 5 bytes at most.
law EM.vl5:
  for +v: U32
  {Cmp.is_le(Nat.cmp(V.U.N(B.B.var.len(v)), 5n)) == True{} : Bool}

def EM.vl5(v):
  @unfold B.B.var.len
  EM.pick_le(U32.is_lt(v, 128), 1, B.u32.pick(U32.is_lt(v, 16384), 2, B.u32.pick(U32.is_lt(v, 2097152), 3, B.u32.pick(U32.is_lt(v, 268435456), 4, 5))), 5n, {==},
    EM.pick_le(U32.is_lt(v, 16384), 2, B.u32.pick(U32.is_lt(v, 2097152), 3, B.u32.pick(U32.is_lt(v, 268435456), 4, 5)), 5n, {==},
      EM.pick_le(U32.is_lt(v, 2097152), 3, B.u32.pick(U32.is_lt(v, 268435456), 4, 5), 5n, {==},
        EM.pick_le(U32.is_lt(v, 268435456), 4, 5, 5n, {==}, {==}))))

law EM.zs_t:
  for +z1: Bool
  for +s: Bool
  for +h: {Bool.or(Bool.and(z1, s), Bool.and(Bool.not(z1), Bool.not(s))) == True{} : Bool}
  for +hs: {s == True{} : Bool}
  {z1 == True{} : Bool}

def EM.zs_t(z1, s, h, hs):
  match z1:
    case True{}:
      {==}
    case False{}:
      (%hs : {Bool.or(Bool.and(False{}, _), Bool.and(Bool.not(False{}), Bool.not(_))) == True{} : Bool}; h)

law EM.zs_f:
  for +z1: Bool
  for +s: Bool
  for +h: {Bool.or(Bool.and(z1, s), Bool.and(Bool.not(z1), Bool.not(s))) == True{} : Bool}
  for +hs: {s == False{} : Bool}
  {z1 == False{} : Bool}

def EM.zs_f(z1, s, h, hs):
  match z1:
    case True{}:
      P.Bool.false_true({True{} == False{} : Bool}, (%hs : {Bool.or(Bool.and(True{}, _), Bool.and(Bool.not(True{}), Bool.not(_))) == True{} : Bool}; h))
    case False{}:
      {==}

def EM.tit(+r: TI) -> A.Tr:
  match r:
    case TI{t, n}:
      t

def EM.tin(+r: TI) -> U32:
  match r:
    case TI{t, n}:
      n

# The instruction bytes of a single opcode pc for ph.
law EM.ins_sg.t:
  for +pc: U32
  for +ph: Q.HF
  for +ps: U32
  for +hz1: {Q.SP.z(Q.SP.e1(pc)) == True{} : Bool}
  for +hz2: {Bool.not(Q.SP.z(Q.SP.e2(pc))) == True{} : Bool}
  for +hps: {ps == Q.SP.size(ph) : U32}
  {Q.SP.ins(Q.OP{pc, ph, Q.HN{}}) == K.WD.app(pc <> [], R.VI.var(ps)) : List<&2, U32>}

def EM.ins_sg.t(pc, ph, ps, hz1, hz2, hps):
  @simp
  @unfold Q.SP.sz
  @rwx hz1 : {Q.SP.z(Q.SP.e1(pc)) == True{} : Bool}
  @rwx EM.notT(Q.SP.z(Q.SP.e2(pc)), hz2) : {Q.SP.z(Q.SP.e2(pc)) == False{} : Bool}
  @simp
  @rwx- hps : {ps == Q.SP.size(ph) : U32}
  @rw K.WD.app_nil(R.VI.var(ps))
  {==}

law EM.ins_sg.f:
  for +pc: U32
  for +ph: Q.HF
  for +hz1: {Q.SP.z(Q.SP.e1(pc)) == False{} : Bool}
  for +hz2: {Bool.not(Q.SP.z(Q.SP.e2(pc))) == True{} : Bool}
  {Q.SP.ins(Q.OP{pc, ph, Q.HN{}}) == pc <> [] : List<&2, U32>}

def EM.ins_sg.f(pc, ph, hz1, hz2):
  @simp
  @unfold Q.SP.sz
  @rwx hz1 : {Q.SP.z(Q.SP.e1(pc)) == False{} : Bool}
  @rwx EM.notT(Q.SP.z(Q.SP.e2(pc)), hz2) : {Q.SP.z(Q.SP.e2(pc)) == False{} : Bool}
  @simp
  {==}

law EM.ar1:
  for +il: U32
  for +vl: U32
  for +BIG: U32
  for +hvl: {Cmp.is_le(Nat.cmp(V.U.N(vl), 5n)) == True{} : Bool}
  for +hB: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(il), 12n), V.U.N(BIG))) == True{} : Bool}
  {V.U.N(U32.add(U32.add(il, 1), vl)) == Nat.add(Nat.add(V.U.N(il), 1n), V.U.N(vl)) : Nat}

def EM.ar1(il, vl, BIG, hvl, hB):
  @rw V.U.add_N(U32.add(il, 1), vl, BIG, EM.ar1.b(il, vl, BIG, hvl, hB))
  @rw V.U.add_N(il, 1, BIG, EM.le_k(V.U.N(il), 1n, 12n, V.U.N(BIG), {==}, hB))
  {==}

law EM.ar1.b:
  for +il: U32
  for +vl: U32
  for +BIG: U32
  for +hvl: {Cmp.is_le(Nat.cmp(V.U.N(vl), 5n)) == True{} : Bool}
  for +hB: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(il), 12n), V.U.N(BIG))) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(U32.add(il, 1)), V.U.N(vl)), V.U.N(BIG))) == True{} : Bool}

def EM.ar1.b(il, vl, BIG, hvl, hB):
  @rw V.U.add_N(il, 1, BIG, EM.le_k(V.U.N(il), 1n, 12n, V.U.N(BIG), {==}, hB))
