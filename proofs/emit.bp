  for +hwok: {EM.wok(EW{Q.XC{ts, tt, seg, cpl, w0, w1}, E, Es, A.A.to(D.ct.table()), BIG}) == True{} : Bool}
  for +hrun: {S.S.has(C.CP.rep(V.U.N(size), b), tt, uoff) == True{} : Bool}
  for +hsz: {Cmp.is_le(Nat.cmp(1n, V.U.N(size))) == True{} : Bool}
  for +hend: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(uoff), V.U.N(size)), V.U.N(w1))) == True{} : Bool}
  {EM.inv(EM.run(uoff, size, b, ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}), EM.gq(EM.run.e1(uoff, size, b, ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}), EM.run.g(ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}, EG{ops, ph, dd, di, da}), Q.HR{size, b}), EW{Q.XC{ts, tt, seg, cpl, w0, w1}, E, Es, A.A.to(D.ct.table()), BIG}) == True{} : Bool}

