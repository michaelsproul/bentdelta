  {Q.SP.run(EM.ghs(EM.gq(ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}, EG{ops, ph, dd, di, da}, h)), x, s) == Q.SP.run(EM.happ(EM.hs(ops, ph), h <> []), x, s) : Q.ST}

