import Base
import ../bytes.bend as B
import ../vcdiff.bend as D
import ../encode.bend as N
import ./nat.bend as P
import ./word.bend as W
import ./u32.bend as V
import ./array.bend as A
import ./bytes.bend as Y
import ./seq.bend as S
import ./bits.bend as Z
import ./words.bend as K
import ./copy.bend as C
import ./varint.bend as R
import ./spec.bend as Q
import ./sem.bend as M
import ./dec.bend as X
import ./dwin.bend as J
import ./ctab.bend as T

# The encoder's emitter (encode.bend) writes the three sections of a window
# as the spec (proofs/spec) reads them: each emitter step is mirrored by a
# function on trees, and the mirror keeps the sections, the cache and the
# target position in step with the instructions written so far.
#
# Source: proofs/emit.bp (tools/bpp.py writes proofs/emit.bend from it).

# Sections
# ========

law EM.add0:
  for +p: U32
  {U32.add(0, p) == p : U32}

def EM.add0(p):
  @rw V.U.add_comm(0, p)
  @rw V.U.add_zero_r(p)
  {==}

# Writing ys after the L a tree holds: it holds L then ys.
law EM.sec:
  for +d: Nat
  for +L: List<&2, U32>
  for +ys: List<&2, U32>
  for +t: A.Tr
  for +p: U32
  for +e: U32
  for +hp: {A.T.pf(d, t) == True{} : Bool}
  for +hd: {Nat.cmp(d, 32n) == LT{} : Cmp}
  for +he: {Cmp.is_le(Nat.cmp(V.U.N(e), Nat.double(Nat.double(P.Nat.pow2(d))))) == True{} : Bool}
  for +hl: {V.U.N(p) == S.S.len(L) : Nat}
  for +hb: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(p), S.S.len(ys)), V.U.N(e))) == True{} : Bool}
  for +h: {S.S.has(L, t, 0) == True{} : Bool}
  {S.S.has(K.WD.app(L, ys), S.S.puts(ys, t, p), 0) == True{} : Bool}

def EM.sec(d, L, ys, t, p, e, hp, hd, he, hl, hb, h):
  @rw K.WD.has_app(L, ys, S.S.puts(ys, t, p), 0, p, hl)
  @rw EM.add0(p)
  @rw S.S.has_puts_lt(d, L, t, p, ys, 0, e, hp, hd, he, hb, (%Equal.sym(Nat, V.U.N(p), S.S.len(L), hl) : {Cmp.is_le(Nat.cmp(S.S.len(L), _)) == True{} : Bool}; C.CP.le_refl(S.S.len(L))))
  @rw S.S.has_puts(d, ys, t, p, e, hp, hd, he, hb)
  @rwx h : {S.S.has(L, t, 0) == True{} : Bool}
  {==}

# Growing
# =======

# The size B.grow doubles to.
def GR.n2(+need: U32) -> U32:
  B.u32.pick((need < 1073741824 : U32), (need << 1n : U32), need)

# B.grow on a tree: the tree, or a bigger one holding its first used bytes.
def GR.t(+t: A.Tr, +used: U32, +need: U32) -> A.Tr:
  Bool.pick(A.Tr, U32.is_le(B.B.words(need), A.T.size(t)), t,
    S.S.puts(S.S.sl(V.U.N(used), t, 0), A.T.new(B.B.depth(B.B.words(GR.n2(need))), 0), 0))

# Its depth, when t has depth d.
def GR.d(+t: A.Tr, +used: U32, +need: U32, +d: Nat) -> Nat:
  Bool.pick(Nat, U32.is_le(B.B.words(need), A.T.size(t)), d, B.B.depth(B.B.words(GR.n2(need))))

law GR.b0:
  for +used: U32
  {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(used), V.U.N(0)), V.U.N(used))) == True{} : Bool}

def GR.b0(used):
  @simp
  @rw P.Nat.add_zero_r(V.U.N(used))
  C.CP.le_refl(V.U.N(used))

law GR.code.c:
  for +t: A.Tr
  for +used: U32
  for +need: U32
  for +c: Bool
  for +ec: {U32.is_le(B.B.words(need), A.T.size(t)) == c : Bool}
  {B.B.grow.if(c, A.A.from(t), used, need) == A.A.from(GR.t(t, used, need)) : Array<U32>}

def GR.code.c(t, used, need, c, ec):
  match c:
    case True{}:
      @unfold GR.t
      @rwx ec : {U32.is_le(B.B.words(need), A.T.size(t)) == True{} : Bool}
      @simp
      {==}
    case False{}:
      @unfold GR.t
      @rwx ec : {U32.is_le(B.B.words(need), A.T.size(t)) == False{} : Bool}
      @simp
      @unfold B.B.zeros
      @fold GR.n2
      @rw A.A.new_from(B.B.depth(B.B.words(GR.n2(need))), 0)
      @rw C.CP.copy(A.T.new(B.B.depth(B.B.words(GR.n2(need))), 0), 0, t, 0, used, used, GR.b0(used), GR.b0(used))
      @unfold B.B.grow.k
      @simp
      {==}

law GR.code:
  for +t: A.Tr
  for +used: U32
  for +need: U32
  {B.B.grow(A.A.from(t), used, need) == A.A.from(GR.t(t, used, need)) : Array<U32>}

def GR.code(t, used, need):
  @unfold B.B.grow
  @rw A.A.size_from(t)
  @unfold B.B.grow.go
  @simp
  GR.code.c(t, used, need, U32.is_le(B.B.words(need), A.T.size(t)), {==})

law GR.pf.c:
  for +t: A.Tr
  for +used: U32
  for +need: U32
  for +d: Nat
  for +hp: {A.T.pf(d, t) == True{} : Bool}
  for +c: Bool
  for +ec: {U32.is_le(B.B.words(need), A.T.size(t)) == c : Bool}
  {A.T.pf(GR.d(t, used, need, d), GR.t(t, used, need)) == True{} : Bool}

def GR.pf.c(t, used, need, d, hp, c, ec):
  match c:
    case True{}:
      @unfold GR.d GR.t
      @rwx ec : {U32.is_le(B.B.words(need), A.T.size(t)) == True{} : Bool}
      @simp
      hp
    case False{}:
      @unfold GR.d GR.t
      @rwx ec : {U32.is_le(B.B.words(need), A.T.size(t)) == False{} : Bool}
      @simp -A.T.new
      S.S.pf_puts(B.B.depth(B.B.words(GR.n2(need))), S.S.sl(V.U.N(used), t, 0), A.T.new(B.B.depth(B.B.words(GR.n2(need))), 0), 0, A.T.pf_new(B.B.depth(B.B.words(GR.n2(need))), 0))

# The grown tree is perfect.
law GR.pf:
  for +t: A.Tr
  for +used: U32
  for +need: U32
  for +d: Nat
  for +hp: {A.T.pf(d, t) == True{} : Bool}
  {A.T.pf(GR.d(t, used, need, d), GR.t(t, used, need)) == True{} : Bool}

def GR.pf(t, used, need, d, hp):
  GR.pf.c(t, used, need, d, hp, U32.is_le(B.B.words(need), A.T.size(t)), {==})

law GR.lt.c:
  for +t: A.Tr
  for +used: U32
  for +need: U32
  for +d: Nat
  for +hd: {Nat.cmp(d, 32n) == LT{} : Cmp}
  for +c: Bool
  for +ec: {U32.is_le(B.B.words(need), A.T.size(t)) == c : Bool}
  {Nat.cmp(GR.d(t, used, need, d), 32n) == LT{} : Cmp}

def GR.lt.c(t, used, need, d, hd, c, ec):
  match c:
    case True{}:
      @unfold GR.d
      @rwx ec : {U32.is_le(B.B.words(need), A.T.size(t)) == True{} : Bool}
      @simp
      hd
    case False{}:
      @unfold GR.d
      @rwx ec : {U32.is_le(B.B.words(need), A.T.size(t)) == False{} : Bool}
      @simp
      Y.BD.lt(B.B.words(GR.n2(need)))

law GR.lt:
  for +t: A.Tr
  for +used: U32
  for +need: U32
  for +d: Nat
  for +hd: {Nat.cmp(d, 32n) == LT{} : Cmp}
  {Nat.cmp(GR.d(t, used, need, d), 32n) == LT{} : Cmp}

def GR.lt(t, used, need, d, hd):
  GR.lt.c(t, used, need, d, hd, U32.is_le(B.B.words(need), A.T.size(t)), {==})

# The words of n bytes, as a value.
law GR.Nw:
  for +n: U32
  for +hn: {U32.is_lt(n, 2147483648) == True{} : Bool}
  {V.U.N(B.B.words(n)) == P.Nat.half(P.Nat.half(Nat.add(V.U.N(n), 3n))) : Nat}

def GR.Nw(n, hn):
  %Equal.sym(Nat, V.U.N(U32.shr(U32.shr((n + 3 : U32)))), P.Nat.half(V.U.N(U32.shr((n + 3 : U32)))),
    V.U.N_shr(U32.shr((n + 3 : U32)))) :
    {_ == P.Nat.half(P.Nat.half(Nat.add(V.U.N(n), 3n))) : Nat}
  %Equal.sym(Nat, V.U.N(U32.shr((n + 3 : U32))), P.Nat.half(V.U.N((n + 3 : U32))), V.U.N_shr((n + 3 : U32))) :
    {P.Nat.half(_) == P.Nat.half(P.Nat.half(Nat.add(V.U.N(n), 3n))) : Nat}
  %Equal.sym(Nat, V.U.N((n + 3 : U32)), Nat.add(V.U.N(n), V.U.N(3)),
    V.U.add_top(n, 3, V.U.bit_lt_pow(n, 31n, 31n, hn, {==}, {==}), {==})) :
    {P.Nat.half(P.Nat.half(_)) == P.Nat.half(P.Nat.half(Nat.add(V.U.N(n), 3n))) : Nat}
  {==}

law GR.lw:
  for +n: U32
  for +hn: {U32.is_lt(n, 2147483648) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(V.U.N(n), Nat.double(Nat.double(V.U.N(B.B.words(n)))))) == True{} : Bool}

def GR.lw(n, hn):
  @rw GR.Nw(n, hn)
  P.Nat.le_words(V.U.N(n))

law GR.le_dbl:
  for +x: Nat
  {Cmp.is_le(Nat.cmp(x, Nat.double(x))) == True{} : Bool}

def GR.le_dbl(x):
  @rw P.Nat.double_add(x)
  P.Nat.cmp_add_r(x, x)

# Words are below 2^30.
law GR.wb:
  for +n: U32
  {U32.is_le(B.B.words(n), U32.shln(1, 31n)) == True{} : Bool}

def GR.wb(n):
  V.U.lt_to_le(B.B.words(n), U32.shln(1, 31n),
    V.U.lt_of_top(B.B.words(n), U32.shln(1, 31n),
      (%Equal.sym(Bool, V.U.bit(U32.shr(U32.shr((n + 3 : U32))), 31n),
          V.U.bit(U32.shr((n + 3 : U32)), 32n), V.U.bit_shr(U32.shr((n + 3 : U32)), 31n)) :
          {_ == False{} : Bool}
        V.U.bit_beyond(U32.shr((n + 3 : U32)), 32n, {==})),
      {==}))

law GR.n2.c:
  for +need: U32
  for +hn: {U32.is_lt(need, 2147483648) == True{} : Bool}
  for +c: Bool
  for +ec: {U32.is_lt(need, 1073741824) == c : Bool}
  {Bool.and(Cmp.is_le(Nat.cmp(V.U.N(need), V.U.N(GR.n2(need)))), U32.is_lt(GR.n2(need), 2147483648)) == True{} : Bool}

def GR.n2.c(need, hn, c, ec):
  match c:
    case True{}:
      @unfold GR.n2
      @rwx ec : {U32.is_lt(need, 1073741824) == True{} : Bool}
      @unfold B.u32.pick
      @simp
      @goal {Bool.and(Cmp.is_le(Nat.cmp(V.U.N(need), V.U.N(U32.shl(need)))), U32.is_lt(U32.shl(need), 2147483648)) == True{} : Bool}
      @rw V.U.N_shl(need, V.U.bit_lt_pow(need, 30n, 31n, ec, {==}, {==}))
      @rw GR.le_dbl(V.U.N(need))
      @rw V.U.lt_of_top(U32.shl(need), U32.shln(1, 31n), (%Equal.sym(Bool, V.U.bit(U32.shl(need), 31n), V.U.bit(need, 30n), V.U.bit_shl(need, 30n, {==})) : {_ == False{} : Bool}; V.U.bit_lt_pow(need, 30n, 30n, ec, {==}, {==})), {==})
      {==}
    case False{}:
      @unfold GR.n2
      @rwx ec : {U32.is_lt(need, 1073741824) == False{} : Bool}
      @unfold B.u32.pick
      @simp
      @rw C.CP.le_refl(V.U.N(need))
      @rwx hn : {U32.is_lt(need, 2147483648) == True{} : Bool}
      {==}

law GR.n2_ge:
  for +need: U32
  for +hn: {U32.is_lt(need, 2147483648) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(V.U.N(need), V.U.N(GR.n2(need)))) == True{} : Bool}

def GR.n2_ge(need, hn):
  P.Bool.and_l(Cmp.is_le(Nat.cmp(V.U.N(need), V.U.N(GR.n2(need)))), U32.is_lt(GR.n2(need), 2147483648), GR.n2.c(need, hn, U32.is_lt(need, 1073741824), {==}))

law GR.n2_lt:
  for +need: U32
  for +hn: {U32.is_lt(need, 2147483648) == True{} : Bool}
  {U32.is_lt(GR.n2(need), 2147483648) == True{} : Bool}

def GR.n2_lt(need, hn):
  P.Bool.and_r(Cmp.is_le(Nat.cmp(V.U.N(need), V.U.N(GR.n2(need)))), U32.is_lt(GR.n2(need), 2147483648), GR.n2.c(need, hn, U32.is_lt(need, 1073741824), {==}))

law GR.dd2:
  for +a: Nat
  for +b: Nat
  for +h: {Cmp.is_le(Nat.cmp(a, b)) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(Nat.double(Nat.double(a)), Nat.double(Nat.double(b)))) == True{} : Bool}

def GR.dd2(a, b, h):
  P.Nat.double_mono(Nat.double(a), Nat.double(b), P.Nat.double_mono(a, b, h))

# A new tree of the doubled size holds need bytes.
law GR.capF:
  for +need: U32
  for +hn: {U32.is_lt(need, 2147483648) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(V.U.N(need), Nat.double(Nat.double(P.Nat.pow2(B.B.depth(B.B.words(GR.n2(need)))))))) == True{} : Bool}

def GR.capF(need, hn):
  P.Nat.le_trans(V.U.N(need), V.U.N(GR.n2(need)), Nat.double(Nat.double(P.Nat.pow2(B.B.depth(B.B.words(GR.n2(need)))))), GR.n2_ge(need, hn),
    P.Nat.le_trans(V.U.N(GR.n2(need)), Nat.double(Nat.double(V.U.N(B.B.words(GR.n2(need))))), Nat.double(Nat.double(P.Nat.pow2(B.B.depth(B.B.words(GR.n2(need)))))),
      GR.lw(GR.n2(need), GR.n2_lt(need, hn)),
      GR.dd2(V.U.N(B.B.words(GR.n2(need))), P.Nat.pow2(B.B.depth(B.B.words(GR.n2(need)))),
        (%V.U.N_pow(B.B.depth(B.B.words(GR.n2(need))), Y.BD.lt(B.B.words(GR.n2(need)))) : {Cmp.is_le(Nat.cmp(V.U.N(B.B.words(GR.n2(need))), _)) == True{} : Bool};
          V.U.le_N(B.B.words(GR.n2(need)), U32.shln(1, B.B.depth(B.B.words(GR.n2(need)))), Y.BD.le(B.B.words(GR.n2(need)), GR.wb(GR.n2(need))))))))

law GR.cap.c:
  for +t: A.Tr
  for +used: U32
  for +need: U32
  for +d: Nat
  for +hp: {A.T.pf(d, t) == True{} : Bool}
  for +hd: {Nat.cmp(d, 32n) == LT{} : Cmp}
  for +hn: {U32.is_lt(need, 2147483648) == True{} : Bool}
  for +c: Bool
  for +ec: {U32.is_le(B.B.words(need), A.T.size(t)) == c : Bool}
  {Cmp.is_le(Nat.cmp(V.U.N(need), Nat.double(Nat.double(P.Nat.pow2(GR.d(t, used, need, d)))))) == True{} : Bool}

def GR.cap.c(t, used, need, d, hp, hd, hn, c, ec):
  match c:
    case True{}:
      @unfold GR.d
      @rwx ec : {U32.is_le(B.B.words(need), A.T.size(t)) == True{} : Bool}
      @simp
      P.Nat.le_trans(V.U.N(need), Nat.double(Nat.double(V.U.N(B.B.words(need)))), Nat.double(Nat.double(P.Nat.pow2(d))), GR.lw(need, hn),
        GR.dd2(V.U.N(B.B.words(need)), P.Nat.pow2(d),
          (%V.U.N_pow(d, hd) : {Cmp.is_le(Nat.cmp(V.U.N(B.B.words(need)), _)) == True{} : Bool};
            (%A.T.size_pf(d, t, hp) : {Cmp.is_le(Nat.cmp(V.U.N(B.B.words(need)), V.U.N(_))) == True{} : Bool};
              V.U.le_N(B.B.words(need), A.T.size(t), ec)))))
    case False{}:
      @unfold GR.d
      @rwx ec : {U32.is_le(B.B.words(need), A.T.size(t)) == False{} : Bool}
      @simp
      GR.capF(need, hn)

# The grown tree holds need bytes.
law GR.cap:
  for +t: A.Tr
  for +used: U32
  for +need: U32
  for +d: Nat
  for +hp: {A.T.pf(d, t) == True{} : Bool}
  for +hd: {Nat.cmp(d, 32n) == LT{} : Cmp}
  for +hn: {U32.is_lt(need, 2147483648) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(V.U.N(need), Nat.double(Nat.double(P.Nat.pow2(GR.d(t, used, need, d)))))) == True{} : Bool}

def GR.cap(t, used, need, d, hp, hd, hn):
  GR.cap.c(t, used, need, d, hp, hd, hn, U32.is_le(B.B.words(need), A.T.size(t)), {==})

law GR.keep.c:
  for +t: A.Tr
  for +used: U32
  for +need: U32
  for +L: List<&2, U32>
  for +hn: {U32.is_lt(need, 2147483648) == True{} : Bool}
  for +hl: {S.S.len(L) == V.U.N(used) : Nat}
  for +hu: {Cmp.is_le(Nat.cmp(V.U.N(used), V.U.N(need))) == True{} : Bool}
  for +h: {S.S.has(L, t, 0) == True{} : Bool}
  for +c: Bool
  for +ec: {U32.is_le(B.B.words(need), A.T.size(t)) == c : Bool}
  {S.S.has(L, GR.t(t, used, need), 0) == True{} : Bool}

def GR.keep.c(t, used, need, L, hn, hl, hu, h, c, ec):
  match c:
    case True{}:
      @unfold GR.t
      @rwx ec : {U32.is_le(B.B.words(need), A.T.size(t)) == True{} : Bool}
      @simp
      h
    case False{}:
      @unfold GR.t
      @rwx ec : {U32.is_le(B.B.words(need), A.T.size(t)) == False{} : Bool}
      @simp -A.T.new
      @rwx- hl : {S.S.len(L) == V.U.N(used) : Nat}
      @rw X.DX.puts_held(L, [], t, 0, A.T.new(B.B.depth(B.B.words(GR.n2(need))), 0), 0, (%Equal.sym(List<&2, U32>, K.WD.app(L, []), L, K.WD.app_nil(L)) : {S.S.has(_, t, 0) == True{} : Bool}; h))
      S.S.has_puts(B.B.depth(B.B.words(GR.n2(need))), L, A.T.new(B.B.depth(B.B.words(GR.n2(need))), 0), 0, need, A.T.pf_new(B.B.depth(B.B.words(GR.n2(need))), 0), Y.BD.lt(B.B.words(GR.n2(need))), GR.capF(need, hn),
        (%Equal.sym(Nat, S.S.len(L), V.U.N(used), hl) : {Cmp.is_le(Nat.cmp(_, V.U.N(need))) == True{} : Bool}; hu))

# The grown tree keeps the bytes it held.
law GR.keep:
  for +t: A.Tr
  for +used: U32
  for +need: U32
  for +L: List<&2, U32>
  for +hn: {U32.is_lt(need, 2147483648) == True{} : Bool}
  for +hl: {S.S.len(L) == V.U.N(used) : Nat}
  for +hu: {Cmp.is_le(Nat.cmp(V.U.N(used), V.U.N(need))) == True{} : Bool}
  for +h: {S.S.has(L, t, 0) == True{} : Bool}
  {S.S.has(L, GR.t(t, used, need), 0) == True{} : Bool}

def GR.keep(t, used, need, L, hn, hl, hu, h):
  GR.keep.c(t, used, need, L, hn, hl, hu, h, U32.is_le(B.B.words(need), A.T.size(t)), {==})

# The emitter on trees
# ====================

type ET is Data:
  ET{td: A.Tr, ti: A.Tr, ta: A.Tr, tc: A.Tr, dl: U32, il: U32, al: U32,
    slot: U32, uoff: U32, pt: U32, ps: U32, pm: U32, pc: U32}

def EM.em(+e: ET) -> N.Em:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      N.Em{A.A.from(td), A.A.from(ti), A.A.from(ta), A.A.from(tc), dl, il, al, slot, uoff, pt, ps, pm, pc}

# A tree and a length.
type TI is Data:
  TI{t: A.Tr, n: U32}

def EM.ti(+r: TI) -> Array<U32> & U32:
  match r:
    case TI{t, n}:
      (A.A.from(t), n)

# em.single: the pending instruction as a single opcode.
def EM.sgi(+z: Bool, +ps: U32, +t: A.Tr, +il: U32) -> TI:
  match z:
    case True{}:
      TI{S.S.puts(R.VI.var(ps), t, il), U32.add(il, B.B.var.len(ps))}
    case False{}:
      TI{t, il}

def EM.sgo(+z: Bool, +ps: U32, +pc: U32, +t: A.Tr, +il: U32) -> TI:
  match z:
    case False{}:
      TI{t, il}
    case True{}:
      EM.sgi(N.op.sized(pc), ps, Y.BP.put(t, il, pc), U32.add(il, 1))

def EM.sg(+pt: U32, +ps: U32, +pc: U32, +t: A.Tr, +il: U32) -> TI:
  EM.sgo(U32.is_ne(pt, 0), ps, pc, t, il)

law EM.sgi_code:
  for +z: Bool
  for +ps: U32
  for +t: A.Tr
  for +il: U32
  {N.em.single.if(z, A.A.from(t), il, ps) == EM.ti(EM.sgi(z, ps, t, il)) : Array<U32> & U32}

def EM.sgi_code(z, ps, t, il):
  match z:
    case True{}:
      @simp
      @rw R.VI.put(t, il, ps)
      {==}
    case False{}:
      {==}

law EM.sgo_code:
  for +z: Bool
  for +ps: U32
  for +pc: U32
  for +t: A.Tr
  for +il: U32
  {N.em.single.go(z, ps, pc, A.A.from(t), il) == EM.ti(EM.sgo(z, ps, pc, t, il)) : Array<U32> & U32}

def EM.sgo_code(z, ps, pc, t, il):
  match z:
    case False{}:
      {==}
    case True{}:
      @simp
      @rw Y.BP.put_from(t, il, pc)
      @rw EM.sgi_code(N.op.sized(pc), ps, Y.BP.put(t, il, pc), U32.add(il, 1))
      {==}

law EM.sg_code:
  for +pt: U32
  for +ps: U32
  for +pc: U32
  for +t: A.Tr
  for +il: U32
  {N.em.single(pt, ps, pc, A.A.from(t), il) == EM.ti(EM.sg(pt, ps, pc, t, il)) : Array<U32> & U32}

def EM.sg_code(pt, ps, pc, t, il):
  @unfold N.em.single EM.sg
  EM.sgo_code(U32.is_ne(pt, 0), ps, pc, t, il)

# em.queue: pair with the pending instruction, or hold this one back.
def EM.qk(+td: A.Tr, +ta: A.Tr, +tc: A.Tr, +dl: U32, +al: U32, +slot: U32, +uoff: U32, +t: U32, +size: U32, +mode: U32, +r: TI) -> ET:
  match r:
    case TI{ti, il}:
      ET{td, ti, ta, tc, dl, il, al, slot, uoff, t, size, mode, N.op.single(t, size, mode)}

def EM.qg(+dbl: Bool, +td: A.Tr, +ti: A.Tr, +ta: A.Tr, +tc: A.Tr, +dl: U32, +il: U32, +al: U32, +slot: U32, +uoff: U32, +pt: U32, +ps: U32, +pc: U32, +code: U32, +t: U32, +size: U32, +mode: U32) -> ET:
  match dbl:
    case True{}:
      ET{td, Y.BP.put(ti, il, code), ta, tc, dl, U32.add(il, 1), al, slot, uoff, 0, 0, 0, 0}
    case False{}:
      EM.qk(td, ta, tc, dl, al, slot, uoff, t, size, mode, EM.sg(pt, ps, pc, ti, il))

def EM.q(+t: U32, +size: U32, +mode: U32, +e: ET) -> ET:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      EM.qg(U32.is_ne(N.op.double(pt, ps, pm, t, size, mode), 0), td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pc, N.op.double(pt, ps, pm, t, size, mode), t, size, mode)

law EM.qg_code:
  for +dbl: Bool
  for +td: A.Tr
  for +ti: A.Tr
  for +ta: A.Tr
  for +tc: A.Tr
  for +dl: U32
  for +il: U32
  for +al: U32
  for +slot: U32
  for +uoff: U32
  for +pt: U32
  for +ps: U32
  for +pc: U32
  for +code: U32
  for +t: U32
  for +size: U32
  for +mode: U32
  {N.em.queue.go(dbl, A.A.from(td), A.A.from(ti), A.A.from(ta), A.A.from(tc), dl, il, al, slot, uoff, pt, ps, pc, code, t, size, mode) == EM.em(EM.qg(dbl, td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pc, code, t, size, mode)) : N.Em}

def EM.qg_code(dbl, td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pc, code, t, size, mode):
  match dbl:
    case True{}:
      @simp
      @unfold N.em.queue.dbl
      @rw Y.BP.put_from(ti, il, code)
      {==}
    case False{}:
      @simp
      @rw EM.sg_code(pt, ps, pc, ti, il)
      @unfold EM.sg
      EM.qk_code(td, ta, tc, dl, al, slot, uoff, t, size, mode, EM.sgo(U32.is_ne(pt, 0), ps, pc, ti, il))

law EM.qk_code:
  for +td: A.Tr
  for +ta: A.Tr
  for +tc: A.Tr
  for +dl: U32
  for +al: U32
  for +slot: U32
  for +uoff: U32
  for +t: U32
  for +size: U32
  for +mode: U32
  for +r: TI
  {N.em.queue.k(A.A.from(td), A.A.from(ta), A.A.from(tc), dl, al, slot, uoff, t, size, mode, EM.ti(r)) == EM.em(EM.qk(td, ta, tc, dl, al, slot, uoff, t, size, mode, r)) : N.Em}

def EM.qk_code(td, ta, tc, dl, al, slot, uoff, t, size, mode, r):
  match r:
    case TI{ti, il}:
      {==}

law EM.q_code:
  for +t: U32
  for +size: U32
  for +mode: U32
  for +e: ET
  {N.em.queue(t, size, mode, EM.em(e)) == EM.em(EM.q(t, size, mode, e)) : N.Em}

def EM.q_code(t, size, mode, e):
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      @simp
      EM.qg_code(U32.is_ne(N.op.double(pt, ps, pm, t, size, mode), 0), td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pc, N.op.double(pt, ps, pm, t, size, mode), t, size, mode)

# em.flush: the pending instruction, at a window's end.
def EM.flk(+td: A.Tr, +ta: A.Tr, +tc: A.Tr, +dl: U32, +al: U32, +slot: U32, +uoff: U32, +r: TI) -> ET:
  match r:
    case TI{ti, il}:
      ET{td, ti, ta, tc, dl, il, al, slot, uoff, 0, 0, 0, 0}

def EM.fl(+e: ET) -> ET:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      EM.flk(td, ta, tc, dl, al, slot, uoff, EM.sg(pt, ps, pc, ti, il))

law EM.flk_code:
  for +td: A.Tr
  for +ta: A.Tr
  for +tc: A.Tr
  for +dl: U32
  for +al: U32
  for +slot: U32
  for +uoff: U32
  for +r: TI
  {N.em.flush.k(A.A.from(td), A.A.from(ta), A.A.from(tc), dl, al, slot, uoff, EM.ti(r)) == EM.em(EM.flk(td, ta, tc, dl, al, slot, uoff, r)) : N.Em}

def EM.flk_code(td, ta, tc, dl, al, slot, uoff, r):
  match r:
    case TI{ti, il}:
      {==}

law EM.fl_code:
  for +e: ET
  {N.em.flush(EM.em(e)) == EM.em(EM.fl(e)) : N.Em}

def EM.fl_code(e):
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      @simp
      @rw EM.sg_code(pt, ps, pc, ti, il)
      EM.flk_code(td, ta, tc, dl, al, slot, uoff, EM.sg(pt, ps, pc, ti, il))

# em.room: the sections grown for an instruction with nd data bytes.
def EM.room(+nd: U32, +e: ET) -> ET:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      ET{GR.t(td, dl, U32.add(dl, nd)), GR.t(ti, il, U32.add(il, 12)), GR.t(ta, al, U32.add(al, 6)), tc, dl, il, al, slot, uoff, pt, ps, pm, pc}

law EM.room_code:
  for +nd: U32
  for +e: ET
  {N.em.room(nd, EM.em(e)) == EM.em(EM.room(nd, e)) : N.Em}

def EM.room_code(nd, e):
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      @simp
      @rw GR.code(td, dl, U32.add(dl, nd))
      @rw GR.code(ti, il, U32.add(il, 12))
      @rw GR.code(ta, al, U32.add(al, 6))
      {==}

# em.add: tt[pos, pos + size) into the data section.
def EM.add.go(+tt: A.Tr, +pos: U32, +size: U32, +e: ET) -> ET:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      EM.q(1, size, 0, ET{S.S.puts(S.S.sl(V.U.N(size), tt, pos), td, dl), ti, ta, tc, U32.add(dl, size), il, al, slot, U32.add(pos, size), pt, ps, pm, pc})

def EM.add(+tt: A.Tr, +pos: U32, +size: U32, +e: ET) -> ET:
  EM.add.go(tt, pos, size, EM.room(size, e))

def EM.dl(+e: ET) -> U32:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      dl

law EM.add.go_code:
  for +tt: A.Tr
  for +pos: U32
  for +size: U32
  for +e: ET
  for +E: U32
  for +hd: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(size), V.U.N(EM.dl(e))), V.U.N(E))) == True{} : Bool}
  for +hs: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(size), V.U.N(pos)), V.U.N(E))) == True{} : Bool}
  {N.em.add.go(A.A.from(tt), pos, size, EM.em(e)) == (A.A.from(tt), EM.em(EM.add.go(tt, pos, size, e))) : Array<U32> & N.Em}

def EM.add.go_code(tt, pos, size, e, E, hd, hs):
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      @simp -N.em.queue -EM.q
      @rw C.CP.copy(td, dl, tt, pos, size, E, hd, hs)
      @unfold N.em.add.k
      @simp -N.em.queue -EM.q
      @rwx EM.q_code(1, size, 0, ET{S.S.puts(S.S.sl(V.U.N(size), tt, pos), td, dl), ti, ta, tc, U32.add(dl, size), il, al, slot, U32.add(pos, size), pt, ps, pm, pc}) : {N.em.queue(1, size, 0, N.Em{A.A.from(S.S.puts(S.S.sl(V.U.N(size), tt, pos), td, dl)), A.A.from(ti), A.A.from(ta), A.A.from(tc), U32.add(dl, size), il, al, slot, U32.add(pos, size), pt, ps, pm, pc}) == EM.em(EM.q(1, size, 0, ET{S.S.puts(S.S.sl(V.U.N(size), tt, pos), td, dl), ti, ta, tc, U32.add(dl, size), il, al, slot, U32.add(pos, size), pt, ps, pm, pc})) : N.Em}
      {==}

law EM.dl_room:
  for +nd: U32
  for +e: ET
  {EM.dl(EM.room(nd, e)) == EM.dl(e) : U32}

def EM.dl_room(nd, e):
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      {==}

law EM.add_code:
  for +tt: A.Tr
  for +pos: U32
  for +size: U32
  for +e: ET
  for +E: U32
  for +hd: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(size), V.U.N(EM.dl(e))), V.U.N(E))) == True{} : Bool}
  for +hs: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(size), V.U.N(pos)), V.U.N(E))) == True{} : Bool}
  {N.em.add(A.A.from(tt), pos, size, EM.em(e)) == (A.A.from(tt), EM.em(EM.add(tt, pos, size, e))) : Array<U32> & N.Em}

def EM.add_code(tt, pos, size, e, E, hd, hs):
  @unfold N.em.add EM.add
  @rw EM.room_code(size, e)
  EM.add.go_code(tt, pos, size, EM.room(size, e), E, (%Equal.sym(U32, EM.dl(EM.room(size, e)), EM.dl(e), EM.dl_room(size, e)) : {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(size), V.U.N(_)), V.U.N(E))) == True{} : Bool}; hd), hs)

# em.run: size copies of byte b.
def EM.run.go(+pos: U32, +size: U32, +b: U32, +e: ET) -> ET:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      EM.q(2, size, 0, ET{Y.BP.put(td, dl, b), ti, ta, tc, U32.add(dl, 1), il, al, slot, U32.add(pos, size), pt, ps, pm, pc})

def EM.run(+pos: U32, +size: U32, +b: U32, +e: ET) -> ET:
  EM.run.go(pos, size, b, EM.room(1, e))

law EM.run.go_code:
  for +pos: U32
  for +size: U32
  for +b: U32
  for +e: ET
  {N.em.run.go(pos, size, b, EM.em(e)) == EM.em(EM.run.go(pos, size, b, e)) : N.Em}

def EM.run.go_code(pos, size, b, e):
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      @simp -N.em.queue -EM.q
      @rw Y.BP.put_from(td, dl, b)
      @rwx EM.q_code(2, size, 0, ET{Y.BP.put(td, dl, b), ti, ta, tc, U32.add(dl, 1), il, al, slot, U32.add(pos, size), pt, ps, pm, pc}) : {N.em.queue(2, size, 0, N.Em{A.A.from(Y.BP.put(td, dl, b)), A.A.from(ti), A.A.from(ta), A.A.from(tc), U32.add(dl, 1), il, al, slot, U32.add(pos, size), pt, ps, pm, pc}) == EM.em(EM.q(2, size, 0, ET{Y.BP.put(td, dl, b), ti, ta, tc, U32.add(dl, 1), il, al, slot, U32.add(pos, size), pt, ps, pm, pc})) : N.Em}
      {==}

law EM.run_code:
  for +pos: U32
  for +size: U32
  for +b: U32
  for +e: ET
  {N.em.run(pos, size, b, EM.em(e)) == EM.em(EM.run(pos, size, b, e)) : N.Em}

def EM.run_code(pos, size, b, e):
  @unfold N.em.run EM.run
  @rw EM.room_code(1, e)
  EM.run.go_code(pos, size, b, EM.room(1, e))

# Addresses
# =========

# The cache, address section and mode after an address, and the value
# written.
type AT is Data:
  AT{tc: A.Tr, ta: A.Tr, al: U32, mode: U32, v: U32}

def EM.aet(+a: AT) -> N.AE:
  match a:
    case AT{tc, ta, al, mode, v}:
      N.AE{A.A.from(tc), A.A.from(ta), al, mode}

# The value and mode SELF, HERE and the NEAR slots give.
def EM.eb(+addr: U32, +here: U32, +tc: A.Tr) -> N.EB:
  N.ea.near(addr, A.T.word(tc, 771), 5, N.ea.near(addr, A.T.word(tc, 770), 4, N.ea.near(addr, A.T.word(tc, 769), 3, N.ea.near(addr, A.T.word(tc, 768), 2, N.ea.self(addr, here)))))

def EM.eput(+same: Bool, +d: U32, +m: U32, +r768: U32, +ta: A.Tr, +al: U32, +tc: A.Tr) -> AT:
  match same:
    case True{}:
      AT{tc, Y.BP.put(ta, al, U32.and(r768, 255)), U32.add(al, 1), U32.add(6, U32.shrn(r768, 8n)), U32.and(r768, 255)}
    case False{}:
      AT{tc, S.S.puts(R.VI.var(d), ta, al), U32.add(al, B.B.var.len(d)), m, d}

def EM.efin(+addr: U32, +sm: U32, +ta: A.Tr, +al: U32, +slot: U32, +tc: A.Tr, +e: N.EB) -> AT:
  match e:
    case N.EB{b5, m5}:
      EM.eput(Bool.and(U32.is_ge(b5, 128), U32.is_eq(sm, addr)), b5, m5, U32.mod(addr, 768), ta, al, Q.SP.cput(tc, slot, addr))

def EM.ea(+addr: U32, +here: U32, +ta: A.Tr, +al: U32, +slot: U32, +tc: A.Tr) -> AT:
  EM.efin(addr, A.T.word(tc, U32.mod(addr, 768)), ta, al, slot, tc, EM.eb(addr, here, tc))

law EM.eput_code:
  for +same: Bool
  for +d: U32
  for +m: U32
  for +r768: U32
  for +ta: A.Tr
  for +al: U32
  for +tc: A.Tr
  {N.ea.put(same, d, m, r768, A.A.from(ta), al, A.A.from(tc)) == EM.aet(EM.eput(same, d, m, r768, ta, al, tc)) : N.AE}

def EM.eput_code(same, d, m, r768, ta, al, tc):
  match same:
    case True{}:
      @simp
      @rw Y.BP.put_from(ta, al, U32.and(r768, 255))
      {==}
    case False{}:
      @simp
      @rw R.VI.put(ta, al, d)
      @unfold N.ea.var
      @simp
      {==}

law EM.efin_code:
  for +addr: U32
  for +sm: U32
  for +ta: A.Tr
  for +al: U32
  for +slot: U32
  for +tc: A.Tr
  for +e: N.EB
  {N.ea.fin(addr, sm, A.A.from(ta), al, slot, A.A.from(tc), e) == EM.aet(EM.efin(addr, sm, ta, al, slot, tc, e)) : N.AE}

def EM.efin_code(addr, sm, ta, al, slot, tc, e):
  match e:
    case N.EB{b5, m5}:
      @simp
      @rw X.DX.cput(tc, slot, addr)
      @rw EM.eput_code(Bool.and(U32.is_ge(b5, 128), U32.is_eq(sm, addr)), b5, m5, U32.mod(addr, 768), ta, al, Q.SP.cput(tc, slot, addr))
      {==}

law EM.ea_code:
  for +addr: U32
  for +here: U32
  for +ta: A.Tr
  for +al: U32
  for +slot: U32
  for +tc: A.Tr
  {N.ea.r0(addr, here, A.A.from(ta), al, slot, (A.A.from(tc), A.T.word(tc, 768))) == EM.aet(EM.ea(addr, here, ta, al, slot, tc)) : N.AE}

def EM.ea_code(addr, here, ta, al, slot, tc):
  @unfold N.ea.r0
  @rw A.A.get_from(tc, 769)
  @unfold N.ea.r1
  @simp
  @rw A.A.get_from(tc, 770)
  @unfold N.ea.r2
  @simp
  @rw A.A.get_from(tc, 771)
  @unfold N.ea.r3
  @simp
  @rw A.A.get_from(tc, U32.mod(addr, 768))
  @unfold N.ea.k
  @simp -N.ea.near -N.ea.fin
  @rw EM.efin_code(addr, A.T.word(tc, U32.mod(addr, 768)), ta, al, slot, tc, N.ea.near(addr, A.T.word(tc, 771), 5, N.ea.near(addr, A.T.word(tc, 770), 4, N.ea.near(addr, A.T.word(tc, 769), 3, N.ea.near(addr, A.T.word(tc, 768), 2, N.ea.self(addr, here))))))
  {==}

# em.copy: a COPY of size bytes from window address addr.
def EM.copy.k(+td: A.Tr, +ti: A.Tr, +dl: U32, +il: U32, +slot: U32, +pos: U32, +size: U32, +pt: U32, +ps: U32, +pm: U32, +pc: U32, +a: AT) -> ET:
  match a:
    case AT{tc, ta, al, mode, v}:
      EM.q(3, size, mode, ET{td, ti, ta, tc, dl, il, al, U32.and(U32.add(slot, 1), 3), U32.add(pos, size), pt, ps, pm, pc})

def EM.copy.go(+pos: U32, +size: U32, +addr: U32, +here: U32, +e: ET) -> ET:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      EM.copy.k(td, ti, dl, il, slot, pos, size, pt, ps, pm, pc, EM.ea(addr, here, ta, al, slot, tc))

def EM.copy(+pos: U32, +size: U32, +addr: U32, +here: U32, +e: ET) -> ET:
  EM.copy.go(pos, size, addr, here, EM.room(0, e))

law EM.copy.k_code:
  for +td: A.Tr
  for +ti: A.Tr
  for +dl: U32
  for +il: U32
  for +slot: U32
  for +pos: U32
  for +size: U32
  for +pt: U32
  for +ps: U32
  for +pm: U32
  for +pc: U32
  for +a: AT
  {N.em.copy.k(A.A.from(td), A.A.from(ti), dl, il, slot, pos, size, pt, ps, pm, pc, EM.aet(a)) == EM.em(EM.copy.k(td, ti, dl, il, slot, pos, size, pt, ps, pm, pc, a)) : N.Em}

def EM.copy.k_code(td, ti, dl, il, slot, pos, size, pt, ps, pm, pc, a):
  match a:
    case AT{tc, ta, al, mode, v}:
      @simp -N.em.queue -EM.q
      @rwx EM.q_code(3, size, mode, ET{td, ti, ta, tc, dl, il, al, U32.and(U32.add(slot, 1), 3), U32.add(pos, size), pt, ps, pm, pc}) : {N.em.queue(3, size, mode, N.Em{A.A.from(td), A.A.from(ti), A.A.from(ta), A.A.from(tc), dl, il, al, U32.and(U32.add(slot, 1), 3), U32.add(pos, size), pt, ps, pm, pc}) == EM.em(EM.q(3, size, mode, ET{td, ti, ta, tc, dl, il, al, U32.and(U32.add(slot, 1), 3), U32.add(pos, size), pt, ps, pm, pc})) : N.Em}
      {==}

law EM.copy.go_code:
  for +pos: U32
  for +size: U32
  for +addr: U32
  for +here: U32
  for +e: ET
  {N.em.copy.go(pos, size, addr, here, EM.em(e)) == EM.em(EM.copy.go(pos, size, addr, here, e)) : N.Em}

def EM.copy.go_code(pos, size, addr, here, e):
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      @simp -N.ea.r0 -N.em.copy.k -EM.copy.k -EM.ea
      @rw A.A.get_from(tc, 768)
      @rw EM.ea_code(addr, here, ta, al, slot, tc)
      @rw EM.copy.k_code(td, ti, dl, il, slot, pos, size, pt, ps, pm, pc, EM.ea(addr, here, ta, al, slot, tc))
      {==}

law EM.copy_code:
  for +pos: U32
  for +size: U32
  for +addr: U32
  for +here: U32
  for +e: ET
  {N.em.copy(pos, size, addr, here, EM.em(e)) == EM.em(EM.copy(pos, size, addr, here, e)) : N.Em}

def EM.copy_code(pos, size, addr, here, e):
  @unfold N.em.copy EM.copy
  @rw EM.room_code(0, e)
  EM.copy.go_code(pos, size, addr, here, EM.room(0, e))

# The rest
# ========

def EM.uo(+e: ET) -> U32:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      uoff

law EM.uo_code:
  for +e: ET
  {N.em.uoff(EM.em(e)) == (EM.uo(e), EM.em(e)) : U32 & N.Em}

def EM.uo_code(e):
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      {==}

# em.gap: an ADD up to pos.
def EM.gapi(+z: Bool, +tt: A.Tr, +u: U32, +pos: U32, +e: ET) -> ET:
  match z:
    case True{}:
      EM.add(tt, u, U32.sub(pos, u), e)
    case False{}:
      e

def EM.gap(+tt: A.Tr, +pos: U32, +e: ET) -> ET:
  EM.gapi(U32.is_lt(EM.uo(e), pos), tt, EM.uo(e), pos, e)

law EM.gapi_code:
  for +z: Bool
  for +tt: A.Tr
  for +u: U32
  for +pos: U32
  for +e: ET
  for +E: U32
  for +hd: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(U32.sub(pos, u)), V.U.N(EM.dl(e))), V.U.N(E))) == True{} : Bool}
  for +hs: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(U32.sub(pos, u)), V.U.N(u)), V.U.N(E))) == True{} : Bool}
  {N.em.gap.if(z, A.A.from(tt), u, pos, EM.em(e)) == (A.A.from(tt), EM.em(EM.gapi(z, tt, u, pos, e))) : Array<U32> & N.Em}

def EM.gapi_code(z, tt, u, pos, e, E, hd, hs):
  match z:
    case True{}:
      @simp -N.em.add -EM.add
      EM.add_code(tt, u, U32.sub(pos, u), e, E, hd, hs)
    case False{}:
      {==}

law EM.gap_code:
  for +tt: A.Tr
  for +pos: U32
  for +e: ET
  for +E: U32
  for +hd: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(U32.sub(pos, EM.uo(e))), V.U.N(EM.dl(e))), V.U.N(E))) == True{} : Bool}
  for +hs: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(U32.sub(pos, EM.uo(e))), V.U.N(EM.uo(e))), V.U.N(E))) == True{} : Bool}
  {N.em.gap(A.A.from(tt), pos, EM.em(e)) == (A.A.from(tt), EM.em(EM.gap(tt, pos, e))) : Array<U32> & N.Em}

def EM.gap_code(tt, pos, e, E, hd, hs):
  @unfold N.em.gap EM.gap
  @rw EM.uo_code(e)
  @unfold N.em.gap.k
  @simp -N.em.gap.if -EM.gapi
  EM.gapi_code(U32.is_lt(EM.uo(e), pos), tt, EM.uo(e), pos, e, E, hd, hs)

# em.inst: a RUN or COPY, cut to start at the bytes not yet written.
def EM.igo(+run: Bool, +pos: U32, +size: U32, +val: U32, +here: U32, +e: ET) -> ET:
  match run:
    case True{}:
      EM.run(pos, size, val, e)
    case False{}:
      EM.copy(pos, size, val, here, e)

def EM.iif(+z: Bool, +tt: A.Tr, +run: Bool, +pos: U32, +size: U32, +val: U32, +cpl: U32, +w0: U32, +e: ET) -> ET:
  match z:
    case True{}:
      EM.igo(run, pos, size, val, U32.add(cpl, U32.sub(pos, w0)), EM.gap(tt, pos, e))
    case False{}:
      e

# How much of an instruction at pos the bytes before u cut off.
def EM.cut(+pos: U32, +u: U32) -> U32:
  N.u32.pick(U32.is_lt(pos, u), U32.sub(u, pos), 0)

def EM.inst(+tt: A.Tr, +run: Bool, +pos: U32, +size: U32, +val: U32, +cpl: U32, +w0: U32, +e: ET) -> ET:
  EM.iif(U32.is_lt(EM.cut(pos, EM.uo(e)), size), tt, run, U32.add(pos, EM.cut(pos, EM.uo(e))), U32.sub(size, EM.cut(pos, EM.uo(e))), N.u32.pick(run, val, U32.add(val, EM.cut(pos, EM.uo(e)))), cpl, w0, e)

law EM.igo_code:
  for +run: Bool
  for +pos: U32
  for +size: U32
  for +val: U32
  for +here: U32
  for +e: ET
  {N.em.inst.go(run, pos, size, val, here, EM.em(e)) == EM.em(EM.igo(run, pos, size, val, here, e)) : N.Em}

def EM.igo_code(run, pos, size, val, here, e):
  match run:
    case True{}:
      @simp -N.em.run -EM.run
      EM.run_code(pos, size, val, e)
    case False{}:
      @simp -N.em.copy -EM.copy
      EM.copy_code(pos, size, val, here, e)

law EM.iif_code:
  for +z: Bool
  for +tt: A.Tr
  for +run: Bool
  for +pos: U32
  for +size: U32
  for +val: U32
  for +cpl: U32
  for +w0: U32
  for +e: ET
  for +E: U32
  for +hd: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(U32.sub(pos, EM.uo(e))), V.U.N(EM.dl(e))), V.U.N(E))) == True{} : Bool}
  for +hs: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(U32.sub(pos, EM.uo(e))), V.U.N(EM.uo(e))), V.U.N(E))) == True{} : Bool}
  {N.em.inst.if(z, A.A.from(tt), run, pos, size, val, cpl, w0, EM.em(e)) == (A.A.from(tt), EM.em(EM.iif(z, tt, run, pos, size, val, cpl, w0, e))) : Array<U32> & N.Em}

def EM.iif_code(z, tt, run, pos, size, val, cpl, w0, e, E, hd, hs):
  match z:
    case True{}:
      @simp -N.em.gap -EM.gap -N.em.inst.k -EM.igo
      @rw EM.gap_code(tt, pos, e, E, hd, hs)
      @unfold N.em.inst.k
      @simp -N.em.inst.go -EM.igo
      @rw EM.igo_code(run, pos, size, val, U32.add(cpl, U32.sub(pos, w0)), EM.gap(tt, pos, e))
      {==}
    case False{}:
      {==}

law EM.inst_code:
  for +tt: A.Tr
  for +run: Bool
  for +pos: U32
  for +size: U32
  for +val: U32
  for +cpl: U32
  for +w0: U32
  for +e: ET
  for +E: U32
  for +hd: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(U32.sub(U32.add(pos, EM.cut(pos, EM.uo(e))), EM.uo(e))), V.U.N(EM.dl(e))), V.U.N(E))) == True{} : Bool}
  for +hs: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(U32.sub(U32.add(pos, EM.cut(pos, EM.uo(e))), EM.uo(e))), V.U.N(EM.uo(e))), V.U.N(E))) == True{} : Bool}
  {N.em.inst(A.A.from(tt), run, pos, size, val, cpl, w0, EM.em(e)) == (A.A.from(tt), EM.em(EM.inst(tt, run, pos, size, val, cpl, w0, e))) : Array<U32> & N.Em}

def EM.inst_code(tt, run, pos, size, val, cpl, w0, e, E, hd, hs):
  @unfold N.em.inst EM.inst
  @rw EM.uo_code(e)
  @unfold N.em.inst.cut
  @simp -N.em.inst.if -EM.iif
  @fold EM.cut
  EM.iif_code(U32.is_lt(EM.cut(pos, EM.uo(e)), size), tt, run, U32.add(pos, EM.cut(pos, EM.uo(e))), U32.sub(size, EM.cut(pos, EM.uo(e))), N.u32.pick(run, val, U32.add(val, EM.cut(pos, EM.uo(e)))), cpl, w0, e, E, hd, hs)

# em.reset: a fresh emitter for a window from w0.
def EM.reset(+w0: U32, +e: ET) -> ET:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      ET{td, ti, ta, A.T.new(10n, 0), 0, 0, 0, 0, w0, 0, 0, 0, 0}

def EM.tc(+e: ET) -> A.Tr:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      tc

law EM.reset_code:
  for +w0: U32
  for +e: ET
  for +hp: {A.T.pf(10n, EM.tc(e)) == True{} : Bool}
  {N.em.reset(w0, EM.em(e)) == EM.em(EM.reset(w0, e)) : N.Em}

def EM.reset_code(w0, e, hp):
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      @simp -A.T.new
      @rw J.DW.clr(10n, tc, hp)
      {==}

# em.idle: nothing of the window written yet.
law EM.idle_code:
  for +e: ET
  {N.em.idle(EM.em(e)) == (Bool.and(U32.is_eq(EM.il(e), 0), U32.is_eq(EM.pt(e), 0)), EM.em(e)) : Bool & N.Em}

def EM.idle_code(e):
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      {==}

def EM.il(+e: ET) -> U32:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      il

def EM.pt(+e: ET) -> U32:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      pt

# Lists of halves and opcodes
# ===========================

def EM.happ(+a: List<&2, Q.HF>, +b: List<&2, Q.HF>) -> List<&2, Q.HF>:
  match a:
    case []:
      b
    case h <> r:
      h <> EM.happ(r, b)

def EM.oapp(+a: List<&2, Q.OP>, +b: List<&2, Q.OP>) -> List<&2, Q.OP>:
  match a:
    case []:
      b
    case o <> r:
      o <> EM.oapp(r, b)

law EM.run_app:
  for +a: List<&2, Q.HF>
  for +b: List<&2, Q.HF>
  for +x: Q.XC
  for +s: Q.ST
  {Q.SP.run(EM.happ(a, b), x, s) == Q.SP.run(b, x, Q.SP.run(a, x, s)) : Q.ST}

def EM.run_app(a, b, x, s):
  match a:
    case []:
      {==}
    case h <> r:
      EM.run_app(r, b, x, Q.SP.next(x, s, h))

law EM.vhs_app:
  for +a: List<&2, Q.HF>
  for +b: List<&2, Q.HF>
  for +x: Q.XC
  for +s: Q.ST
  {Q.SP.vhs(EM.happ(a, b), x, s) == Bool.and(Q.SP.vhs(a, x, s), Q.SP.vhs(b, x, Q.SP.run(a, x, s))) : Bool}

def EM.vhs_app(a, b, x, s):
  match a:
    case []:
      {==}
    case h <> r:
      @simp
      @rw EM.vhs_app(r, b, x, Q.SP.next(x, s, h))
      @rw K.WD.and_assoc(Q.SP.vst(x, s, h), Q.SP.vhs(r, x, Q.SP.next(x, s, h)), Q.SP.vhs(b, x, Q.SP.run(r, x, Q.SP.next(x, s, h))))
      {==}

law EM.bnds_app:
  for +a: List<&2, Q.HF>
  for +b: List<&2, Q.HF>
  for +x: Q.XC
  for +s: Q.ST
  for +E: U32
  for +Es: U32
  {Q.SP.bnds(EM.happ(a, b), x, s, E, Es) == Bool.and(Q.SP.bnds(a, x, s, E, Es), Q.SP.bnds(b, x, Q.SP.run(a, x, s), E, Es)) : Bool}

def EM.bnds_app(a, b, x, s, E, Es):
  match a:
    case []:
      {==}
    case h <> r:
      @simp
      @rw EM.bnds_app(r, b, x, Q.SP.next(x, s, h), E, Es)
      @rw K.WD.and_assoc(Q.SP.bnd(x, s, h, E, Es), Q.SP.bnds(r, x, Q.SP.next(x, s, h), E, Es), Q.SP.bnds(b, x, Q.SP.run(r, x, Q.SP.next(x, s, h)), E, Es))
      {==}

law EM.doks_app:
  for +a: List<&2, Q.HF>
  for +b: List<&2, Q.HF>
  {Q.SP.doks(EM.happ(a, b)) == Bool.and(Q.SP.doks(a), Q.SP.doks(b)) : Bool}

def EM.doks_app(a, b):
  match a:
    case []:
      {==}
    case h <> r:
      @simp
      @rw EM.doks_app(r, b)
      @rw K.WD.and_assoc(Q.SP.dok(h), Q.SP.doks(r), Q.SP.doks(b))
      {==}

law EM.datl_app:
  for +a: List<&2, Q.HF>
  for +b: List<&2, Q.HF>
  {Q.SP.datl(EM.happ(a, b)) == K.WD.app(Q.SP.datl(a), Q.SP.datl(b)) : List<&2, U32>}

def EM.datl_app(a, b):
  match a:
    case []:
      {==}
    case h <> r:
      @simp
      @rw EM.datl_app(r, b)
      @rw K.WD.app_assoc(Q.SP.dat(h), Q.SP.datl(r), Q.SP.datl(b))
      {==}

law EM.adrl_app:
  for +a: List<&2, Q.HF>
  for +b: List<&2, Q.HF>
  {Q.SP.adrl(EM.happ(a, b)) == K.WD.app(Q.SP.adrl(a), Q.SP.adrl(b)) : List<&2, U32>}

def EM.adrl_app(a, b):
  match a:
    case []:
      {==}
    case h <> r:
      @simp
      @rw EM.adrl_app(r, b)
      @rw K.WD.app_assoc(Q.SP.adr(h), Q.SP.adrl(r), Q.SP.adrl(b))
      {==}

law EM.halves_app:
  for +a: List<&2, Q.OP>
  for +b: List<&2, Q.OP>
  {Q.SP.halves(EM.oapp(a, b)) == EM.happ(Q.SP.halves(a), Q.SP.halves(b)) : List<&2, Q.HF>}

def EM.halves_app(a, b):
  match a:
    case Nil{}:
      {==}
    case Con{Q.OP{c, h1, h2}, r}:
      @simp
      @rw EM.halves_app(r, b)
      {==}

law EM.insl_app:
  for +a: List<&2, Q.OP>
  for +b: List<&2, Q.OP>
  {Q.SP.insl(EM.oapp(a, b)) == K.WD.app(Q.SP.insl(a), Q.SP.insl(b)) : List<&2, U32>}

def EM.insl_app(a, b):
  match a:
    case []:
      {==}
    case o <> r:
      @simp
      @rw EM.insl_app(r, b)
      @rw K.WD.app_assoc(Q.SP.ins(o), Q.SP.insl(r), Q.SP.insl(b))
      {==}

law EM.coks_app:
  for +a: List<&2, Q.OP>
  for +b: List<&2, Q.OP>
  for +tb: A.Tr
  {Q.SP.coks(EM.oapp(a, b), tb) == Bool.and(Q.SP.coks(a, tb), Q.SP.coks(b, tb)) : Bool}

def EM.coks_app(a, b, tb):
  match a:
    case []:
      {==}
    case o <> r:
      @simp
      @rw EM.coks_app(r, b, tb)
      @rw K.WD.and_assoc(Q.SP.cok(tb, o), Q.SP.coks(r, tb), Q.SP.coks(b, tb))
      {==}

# A tree holds its own bytes.
law EM.has_sl:
  for +n: Nat
  for +t: A.Tr
  for +p: U32
  {S.S.has(S.S.sl(n, t, p), t, p) == True{} : Bool}

def EM.has_sl(n, t, p):
  match n:
    case 0n:
      {==}
    case 1n+k:
      @simp -S.S.sl -S.S.has
      @unfold S.S.sl
      @simp -S.S.sl
      @rw Y.BP.byt_255(t, p)
      @rw V.U.is_eq_refl(Y.BP.byt(t, p))
      @rw EM.has_sl(k, t, U32.add(p, 1))
      {==}

# Empty halves
# ============

# A single opcode's second half is empty: it does nothing but must start
# inside the target.

law EM.next_hn:
  for +x: Q.XC
  for +s: Q.ST
  {Q.SP.next(x, s, Q.HN{}) == s : Q.ST}

def EM.next_hn(x, s):
  match s:
    case Q.ST{opos, c, slot}:
      {==}

law EM.vst_hn:
  for +x: Q.XC
  for +s: Q.ST
  {Q.SP.vst(x, s, Q.HN{}) == True{} : Bool}

def EM.vst_hn(x, s):
  match s:
    case Q.ST{opos, c, slot}:
      {==}

law EM.bnd_hn:
  for +x: Q.XC
  for +s: Q.ST
  for +E: U32
  for +Es: U32
  {Q.SP.bnd(x, s, Q.HN{}, E, Es) == Bool.and(Cmp.is_le(Nat.cmp(V.U.N(Q.SP.so(s)), V.U.N(E))), True{}) : Bool}

def EM.bnd_hn(x, s, E, Es):
  match s:
    case Q.ST{opos, c, slot}:
      {==}

law EM.ins_run:
  for +a: List<&2, Q.HF>
  for +b: List<&2, Q.HF>
  for +x: Q.XC
  for +s: Q.ST
  {Q.SP.run(EM.happ(a, Q.HN{} <> b), x, s) == Q.SP.run(EM.happ(a, b), x, s) : Q.ST}

def EM.ins_run(a, b, x, s):
  @rw EM.run_app(a, Q.HN{} <> b, x, s)
  @rw EM.run_app(a, b, x, s)
  @simp
  @rw EM.next_hn(x, Q.SP.run(a, x, s))
  {==}

law EM.ins_vhs:
  for +a: List<&2, Q.HF>
  for +b: List<&2, Q.HF>
  for +x: Q.XC
  for +s: Q.ST
  {Q.SP.vhs(EM.happ(a, Q.HN{} <> b), x, s) == Q.SP.vhs(EM.happ(a, b), x, s) : Bool}

def EM.ins_vhs(a, b, x, s):
  @rw EM.vhs_app(a, Q.HN{} <> b, x, s)
  @rw EM.vhs_app(a, b, x, s)
  @simp
  @rw EM.vst_hn(x, Q.SP.run(a, x, s))
  @rw EM.next_hn(x, Q.SP.run(a, x, s))
  @simp
  {==}

law EM.ins_doks:
  for +a: List<&2, Q.HF>
  for +b: List<&2, Q.HF>
  {Q.SP.doks(EM.happ(a, Q.HN{} <> b)) == Q.SP.doks(EM.happ(a, b)) : Bool}

def EM.ins_doks(a, b):
  @rw EM.doks_app(a, Q.HN{} <> b)
  @rw EM.doks_app(a, b)
  @simp
  {==}

law EM.ins_datl:
  for +a: List<&2, Q.HF>
  for +b: List<&2, Q.HF>
  {Q.SP.datl(EM.happ(a, Q.HN{} <> b)) == Q.SP.datl(EM.happ(a, b)) : List<&2, U32>}

def EM.ins_datl(a, b):
  @rw EM.datl_app(a, Q.HN{} <> b)
  @rw EM.datl_app(a, b)
  @simp
  {==}

law EM.ins_adrl:
  for +a: List<&2, Q.HF>
  for +b: List<&2, Q.HF>
  {Q.SP.adrl(EM.happ(a, Q.HN{} <> b)) == Q.SP.adrl(EM.happ(a, b)) : List<&2, U32>}

def EM.ins_adrl(a, b):
  @rw EM.adrl_app(a, Q.HN{} <> b)
  @rw EM.adrl_app(a, b)
  @simp
  {==}

law EM.ins_bnds:
  for +a: List<&2, Q.HF>
  for +b: List<&2, Q.HF>
  for +x: Q.XC
  for +s: Q.ST
  for +E: U32
  for +Es: U32
  for +h: {Cmp.is_le(Nat.cmp(V.U.N(Q.SP.so(Q.SP.run(a, x, s))), V.U.N(E))) == True{} : Bool}
  {Q.SP.bnds(EM.happ(a, Q.HN{} <> b), x, s, E, Es) == Q.SP.bnds(EM.happ(a, b), x, s, E, Es) : Bool}

def EM.ins_bnds(a, b, x, s, E, Es, h):
  @rw EM.bnds_app(a, Q.HN{} <> b, x, s, E, Es)
  @rw EM.bnds_app(a, b, x, s, E, Es)
  @simp
  @rw EM.bnd_hn(x, Q.SP.run(a, x, s), E, Es)
  @rwx h : {Cmp.is_le(Nat.cmp(V.U.N(Q.SP.so(Q.SP.run(a, x, s))), V.U.N(E))) == True{} : Bool}
  @rw EM.next_hn(x, Q.SP.run(a, x, s))
  @simp
  {==}

# The invariant
# =============

# What the window says: its facts x (target from w0 to w1), the bound E
# on target positions, Es on source positions, the decoder's table tb, and
# a bound BIG below 2^31 on the sections' sizes.
type EW is Data:
  EW{x: Q.XC, E: U32, Es: U32, tb: A.Tr, BIG: U32}

# The instructions written so far (ops, and the pending half ph, or HN),
# and the depths of the three sections' trees.
type EG is Data:
  EG{ops: List<&2, Q.OP>, ph: Q.HF, dd: Nat, di: Nat, da: Nat}

def EM.pend(+h: Q.HF) -> List<&2, Q.HF>:
  match h:
    case Q.HN{}:
      []
    case Q.HA{n, xs}:
      Q.HA{n, xs} <> []
    case Q.HR{n, b}:
      Q.HR{n, b} <> []
    case Q.HC{n, m, v}:
      Q.HC{n, m, v} <> []

# Every half written, the pending one last.
def EM.hs(+ops: List<&2, Q.OP>, +ph: Q.HF) -> List<&2, Q.HF>:
  EM.happ(Q.SP.halves(ops), EM.pend(ph))

def EM.w0(+w: EW) -> U32:
  match w:
    case EW{x, E, Es, tb, BIG}:
      match x:
        case Q.XC{ts, tt, seg, cpl, wst, oend}:
          wst

def EM.w1(+w: EW) -> U32:
  match w:
    case EW{x, E, Es, tb, BIG}:
      match x:
        case Q.XC{ts, tt, seg, cpl, wst, oend}:
          oend

def EM.x(+w: EW) -> Q.XC:
  match w:
    case EW{x, E, Es, tb, BIG}:
      x

def EM.s0(+w: EW) -> Q.ST:
  Q.SP.s0(EM.w0(w))

# A tree of depth d holds this many bytes.
def EM.cap(+d: Nat) -> Nat:
  Nat.double(Nat.double(P.Nat.pow2(d)))

# Sections
def EM.S1(+e: ET, +H: List<&2, Q.HF>) -> Bool:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      Bool.and(S.S.has(Q.SP.datl(H), td, 0), Q.SP.lenis(Q.SP.datl(H), dl))

def EM.S2(+e: ET, +ops: List<&2, Q.OP>) -> Bool:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      Bool.and(S.S.has(Q.SP.insl(ops), ti, 0), Q.SP.lenis(Q.SP.insl(ops), il))

def EM.S3(+e: ET, +H: List<&2, Q.HF>) -> Bool:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      Bool.and(S.S.has(Q.SP.adrl(H), ta, 0), Q.SP.lenis(Q.SP.adrl(H), al))

# What the halves do
def EM.V(+H: List<&2, Q.HF>, +ops: List<&2, Q.OP>, +w: EW) -> Bool:
  match w:
    case EW{x, E, Es, tb, BIG}:
      Bool.and(Q.SP.vhs(H, x, EM.s0(w)), Bool.and(Q.SP.bnds(H, x, EM.s0(w), E, Es), Bool.and(Q.SP.doks(H), Q.SP.coks(ops, tb))))

# Shapes, and room for the pending instruction's opcode and size
def EM.P(+e: ET, +g: EG) -> Bool:
  match e g:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc} EG{ops, ph, dd, di, da}:
      Bool.and(A.T.pf(dd, td), Bool.and(Cmp.is_lt(Nat.cmp(dd, 32n)), Bool.and(A.T.pf(di, ti), Bool.and(Cmp.is_lt(Nat.cmp(di, 32n)),
        Bool.and(A.T.pf(da, ta), Bool.and(Cmp.is_lt(Nat.cmp(da, 32n)), Cmp.is_le(Nat.cmp(Nat.add(V.U.N(il), 6n), EM.cap(di)))))))))

# Where the halves leave the target, and the sections' sizes
def EM.R(+e: ET, +H: List<&2, Q.HF>, +w: EW) -> Bool:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      Bool.and(U32.is_eq(uoff, Q.SP.so(Q.SP.run(H, EM.x(w), EM.s0(w)))), Bool.and(U32.is_eq(slot, Q.SP.ss(Q.SP.run(H, EM.x(w), EM.s0(w)))),
        Bool.and(U32.is_le(EM.w0(w), uoff), Bool.and(U32.is_le(uoff, EM.w1(w)),
        Bool.and(Cmp.is_le(Nat.cmp(V.U.N(dl), V.U.N(U32.sub(uoff, EM.w0(w))))),
        Bool.and(Cmp.is_le(Nat.cmp(V.U.N(il), Nat.double(Nat.double(Nat.double(V.U.N(U32.sub(uoff, EM.w0(w)))))))),
          Cmp.is_le(Nat.cmp(V.U.N(al), Nat.double(Nat.double(Nat.double(V.U.N(U32.sub(uoff, EM.w0(w))))))))))))))

# The pending instruction
def EM.D(+e: ET, +ph: Q.HF) -> Bool:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      Bool.and(U32.is_eq(pt, Q.SP.kind(ph)), Bool.and(U32.is_eq(ps, Q.SP.size(ph)), Bool.and(U32.is_eq(pm, Q.SP.mode(ph)),
        Bool.and(Bool.or(U32.is_eq(pt, 0), U32.is_eq(pc, N.op.single(pt, ps, pm))), Cmp.is_le(Nat.cmp(V.U.N(pm), 8n))))))

def EM.inv(+e: ET, +g: EG, +w: EW) -> Bool:
  match g:
    case EG{ops, ph, dd, di, da}:
      Bool.and(EM.S1(e, EM.hs(ops, ph)), Bool.and(EM.S2(e, ops), Bool.and(EM.S3(e, EM.hs(ops, ph)),
        Bool.and(EM.V(EM.hs(ops, ph), ops, w), Bool.and(EM.P(e, EG{ops, ph, dd, di, da}), Bool.and(EM.R(e, EM.hs(ops, ph), w), EM.D(e, ph)))))))

# The cache, as the halves leave it.
def EM.tcok(+e: ET, +H: List<&2, Q.HF>, +w: EW) -> Bool:
  True{}

# Queueing
# ========

law EM.happ_nil:
  for +a: List<&2, Q.HF>
  {EM.happ(a, []) == a : List<&2, Q.HF>}

def EM.happ_nil(a):
  match a:
    case []:
      {==}
    case h <> r:
      @simp
      @rw EM.happ_nil(r)
      {==}

law EM.happ_assoc:
  for +a: List<&2, Q.HF>
  for +b: List<&2, Q.HF>
  for +c: List<&2, Q.HF>
  {EM.happ(EM.happ(a, b), c) == EM.happ(a, EM.happ(b, c)) : List<&2, Q.HF>}

def EM.happ_assoc(a, b, c):
  match a:
    case []:
      {==}
    case h <> r:
      @simp
      @rw EM.happ_assoc(r, b, c)
      {==}

# After a double opcode: the pending half and the new one, in an opcode.
law EM.hs_dbl:
  for +ops: List<&2, Q.OP>
  for +ph: Q.HF
  for +h: Q.HF
  for +c: U32
  for +hp: {EM.pend(ph) == ph <> [] : List<&2, Q.HF>}
  {EM.hs(EM.oapp(ops, Q.OP{c, ph, h} <> []), Q.HN{}) == EM.happ(EM.hs(ops, ph), h <> []) : List<&2, Q.HF>}

def EM.hs_dbl(ops, ph, h, c, hp):
  @unfold EM.hs
  @rw EM.halves_app(ops, Q.OP{c, ph, h} <> [])
  @rwx hp : {EM.pend(ph) == ph <> [] : List<&2, Q.HF>}
  @simp
  @rw EM.happ_nil(EM.happ(Q.SP.halves(ops), ph <> h <> []))
  @rw EM.happ_assoc(Q.SP.halves(ops), ph <> [], h <> [])
  @simp
  {==}

# After writing the pending half alone: it, an empty half, the new one.
law EM.hs_sg:
  for +ops: List<&2, Q.OP>
  for +ph: Q.HF
  for +h: Q.HF
  for +c: U32
  for +hp: {EM.pend(ph) == ph <> [] : List<&2, Q.HF>}
  for +hh: {EM.pend(h) == h <> [] : List<&2, Q.HF>}
  {EM.hs(EM.oapp(ops, Q.OP{c, ph, Q.HN{}} <> []), h) == EM.happ(EM.hs(ops, ph), Q.HN{} <> h <> []) : List<&2, Q.HF>}

def EM.hs_sg(ops, ph, h, c, hp, hh):
  @unfold EM.hs
  @rw EM.halves_app(ops, Q.OP{c, ph, Q.HN{}} <> [])
  @rwx hp : {EM.pend(ph) == ph <> [] : List<&2, Q.HF>}
  @rwx hh : {EM.pend(h) == h <> [] : List<&2, Q.HF>}
  @simp
  @rw EM.happ_assoc(Q.SP.halves(ops), ph <> Q.HN{} <> [], h <> [])
  @rw EM.happ_assoc(Q.SP.halves(ops), ph <> [], Q.HN{} <> h <> [])
  @simp
  {==}

# Nothing pending: the new half is pending.
law EM.hs_none:
  for +ops: List<&2, Q.OP>
  for +h: Q.HF
  for +hh: {EM.pend(h) == h <> [] : List<&2, Q.HF>}
  {EM.hs(ops, h) == EM.happ(EM.hs(ops, Q.HN{}), h <> []) : List<&2, Q.HF>}

def EM.hs_none(ops, h, hh):
  @unfold EM.hs
  @rwx hh : {EM.pend(h) == h <> [] : List<&2, Q.HF>}
  @simp
  @rw EM.happ_nil(Q.SP.halves(ops))
  {==}

law EM.lenis_mk:
  for +xs: List<&2, U32>
  for +n: U32
  for +h: {S.S.len(xs) == V.U.N(n) : Nat}
  {Q.SP.lenis(xs, n) == True{} : Bool}

def EM.lenis_mk(xs, n, h):
  @unfold Q.SP.lenis
  @rename U32.to_nat V.U.N
  @rwx h : {S.S.len(xs) == V.U.N(n) : Nat}
  @rw P.Nat.cmp_refl(V.U.N(n))
  {==}

law EM.and2:
  for +a: Bool
  for +b: Bool
  for +ha: {a == True{} : Bool}
  for +hb: {b == True{} : Bool}
  {Bool.and(a, b) == True{} : Bool}

def EM.and2(a, b, ha, hb):
  @rwx ha : {a == True{} : Bool}
  @rwx hb : {b == True{} : Bool}
  {==}

# Writing ys after a section of n bytes: it holds n + |ys| bytes.
law EM.secw:
  for +d: Nat
  for +L: List<&2, U32>
  for +ys: List<&2, U32>
  for +t: A.Tr
  for +n: U32
  for +k: U32
  for +B: U32
  for +hp: {A.T.pf(d, t) == True{} : Bool}
  for +hd: {Nat.cmp(d, 32n) == LT{} : Cmp}
  for +hh: {S.S.has(L, t, 0) == True{} : Bool}
  for +hl: {Q.SP.lenis(L, n) == True{} : Bool}
  for +hk: {S.S.len(ys) == V.U.N(k) : Nat}
  for +hc: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(n), V.U.N(k)), EM.cap(d))) == True{} : Bool}
  for +hB: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(n), V.U.N(k)), V.U.N(B))) == True{} : Bool}
  {Bool.and(S.S.has(K.WD.app(L, ys), S.S.puts(ys, t, n), 0), Q.SP.lenis(K.WD.app(L, ys), U32.add(n, k))) == True{} : Bool}

def EM.secw(d, L, ys, t, n, k, B, hp, hd, hh, hl, hk, hc, hB):
  EM.and2(S.S.has(K.WD.app(L, ys), S.S.puts(ys, t, n), 0), Q.SP.lenis(K.WD.app(L, ys), U32.add(n, k)),
    EM.sec(d, L, ys, t, n, U32.add(n, k), hp, hd,
      (%Equal.sym(Nat, V.U.N(U32.add(n, k)), Nat.add(V.U.N(n), V.U.N(k)), V.U.add_N(n, k, B, hB)) : {Cmp.is_le(Nat.cmp(_, EM.cap(d))) == True{} : Bool}; hc),
      Equal.sym(Nat, S.S.len(L), V.U.N(n), M.SM.lenis(L, n, hl)),
      (%Equal.sym(Nat, S.S.len(ys), V.U.N(k), hk) : {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(n), _), V.U.N(U32.add(n, k)))) == True{} : Bool}; (%Equal.sym(Nat, V.U.N(U32.add(n, k)), Nat.add(V.U.N(n), V.U.N(k)), V.U.add_N(n, k, B, hB)) : {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(n), V.U.N(k)), _)) == True{} : Bool}; C.CP.le_refl(Nat.add(V.U.N(n), V.U.N(k))))),
      hh),
    EM.lenis_mk(K.WD.app(L, ys), U32.add(n, k), EM.secw.len(L, ys, n, k, B, hl, hk, hB)))

law EM.secw.len:
  for +L: List<&2, U32>
  for +ys: List<&2, U32>
  for +n: U32
  for +k: U32
  for +B: U32
  for +hl: {Q.SP.lenis(L, n) == True{} : Bool}
  for +hk: {S.S.len(ys) == V.U.N(k) : Nat}
  for +hB: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(n), V.U.N(k)), V.U.N(B))) == True{} : Bool}
  {S.S.len(K.WD.app(L, ys)) == V.U.N(U32.add(n, k)) : Nat}

def EM.secw.len(L, ys, n, k, B, hl, hk, hB):
  @rw K.WD.len_app(L, ys)
  @rw M.SM.lenis(L, n, hl)
  @rwx hk : {S.S.len(ys) == V.U.N(k) : Nat}
  @rw V.U.add_N(n, k, B, hB)
  {==}

# The instructions after queueing h: a double opcode, the pending half
# alone then h pending, or just h pending.
def EM.gqs(+sg: Bool, +ops: List<&2, Q.OP>, +ph: Q.HF, +h: Q.HF, +pc: U32, +dd: Nat, +di: Nat, +da: Nat) -> EG:
  match sg:
    case True{}:
      EG{EM.oapp(ops, Q.OP{pc, ph, Q.HN{}} <> []), h, dd, di, da}
    case False{}:
      EG{ops, h, dd, di, da}

def EM.gqd(+dbl: Bool, +sg: Bool, +ops: List<&2, Q.OP>, +ph: Q.HF, +h: Q.HF, +code: U32, +pc: U32, +dd: Nat, +di: Nat, +da: Nat) -> EG:
  match dbl:
    case True{}:
      EG{EM.oapp(ops, Q.OP{code, ph, h} <> []), Q.HN{}, dd, di, da}
    case False{}:
      EM.gqs(sg, ops, ph, h, pc, dd, di, da)

def EM.gq(+e: ET, +g: EG, +h: Q.HF) -> EG:
  match e g:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc} EG{ops, ph, dd, di, da}:
      EM.gqd(U32.is_ne(N.op.double(pt, ps, pm, Q.SP.kind(h), Q.SP.size(h), Q.SP.mode(h)), 0), U32.is_ne(pt, 0), ops, ph, h, N.op.double(pt, ps, pm, Q.SP.kind(h), Q.SP.size(h), Q.SP.mode(h)), pc, dd, di, da)


law EM.P.pd:
  for +td: A.Tr
  for +ti: A.Tr
  for +ta: A.Tr
  for +tc: A.Tr
  for +dl: U32
  for +il: U32
  for +al: U32
  for +slot: U32
  for +uoff: U32
  for +pt: U32
  for +ps: U32
  for +pm: U32
  for +pc: U32
  for +ops: List<&2, Q.OP>
  for +ph: Q.HF
  for +dd: Nat
  for +di: Nat
  for +da: Nat
  for +h: {EM.P(ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}, EG{ops, ph, dd, di, da}) == True{} : Bool}
  {A.T.pf(dd, td) == True{} : Bool}

def EM.P.pd(td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc, ops, ph, dd, di, da, h):
  P.Bool.and_l(A.T.pf(dd, td), Bool.and(Cmp.is_lt(Nat.cmp(dd, 32n)), Bool.and(A.T.pf(di, ti), Bool.and(Cmp.is_lt(Nat.cmp(di, 32n)), Bool.and(A.T.pf(da, ta), Bool.and(Cmp.is_lt(Nat.cmp(da, 32n)), Cmp.is_le(Nat.cmp(Nat.add(V.U.N(il), 6n), EM.cap(di)))))))), h)

law EM.P.dd:
  for +td: A.Tr
  for +ti: A.Tr
  for +ta: A.Tr
  for +tc: A.Tr
  for +dl: U32
  for +il: U32
  for +al: U32
  for +slot: U32
  for +uoff: U32
  for +pt: U32
  for +ps: U32
  for +pm: U32
