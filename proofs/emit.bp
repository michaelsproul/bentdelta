# A RUN leaves the cache as its half does.
law EM.run_tc:
  for +td: A.Tr
  for +ti: A.Tr
  for +ta: A.Tr
  for +tc: A.Tr
  for +dl: U32
  for +il: U32
  for +al: U32
  for +slot: U32
  for +uoff: U32
  for +pt: U32
  for +ps: U32
  for +pm: U32
  for +pc: U32
  for +ops: List<&2, Q.OP>
  for +ph: Q.HF
  for +dd: Nat
  for +di: Nat
  for +da: Nat
  for +ts: A.Tr
  for +tt: A.Tr
  for +seg: U32
  for +cpl: U32
  for +w0: U32
  for +w1: U32
  for +E: U32
  for +Es: U32
  for +BIG: U32
  for +size: U32
  for +b: U32
  for +hinv: {EM.inv(ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}, EG{ops, ph, dd, di, da}, EW{Q.XC{ts, tt, seg, cpl, w0, w1}, E, Es, A.A.to(D.ct.table()), BIG}) == True{} : Bool}
  for +hc: {tc == Q.SP.sc(Q.SP.run(EM.hs(ops, ph), Q.XC{ts, tt, seg, cpl, w0, w1}, Q.SP.s0(w0))) : A.Tr}
  {EM.tc(EM.run(uoff, size, b, ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc})) == Q.SP.sc(Q.SP.run(EM.ghs(EM.gq(EM.run.e1(uoff, size, b, ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}), EM.run.g(ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}, EG{ops, ph, dd, di, da}), Q.HR{size, b})), Q.XC{ts, tt, seg, cpl, w0, w1}, Q.SP.s0(w0))) : A.Tr}

def EM.run_tc(td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc, ops, ph, dd, di, da, ts, tt, seg, cpl, w0, w1, E, Es, BIG, size, b, hinv, hc):
  @simp -EM.tc -EM.run -EM.gq -EM.ghs -Q.SP.run -Y.BP.put -GR.t -GR.d
  @rw EM.q_run(Y.BP.put(GR.t(td, dl, U32.add(dl, 1)), dl, b), GR.t(ti, il, U32.add(il, 12)), GR.t(ta, al, U32.add(al, 6)), tc, U32.add(dl, 1), il, al, slot, U32.add(uoff, size), pt, ps, pm, pc, ops, ph, Q.HR{size, b}, GR.d(td, dl, U32.add(dl, 1), dd), GR.d(ti, il, U32.add(il, 12), di), GR.d(ta, al, U32.add(al, 6), da), Q.XC{ts, tt, seg, cpl, w0, w1}, Q.SP.s0(w0), V.U.is_eq(pt, Q.SP.kind(ph), EM.D.t(td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc, ph, EM.inv.d(td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc, ops, ph, dd, di, da, Q.XC{ts, tt, seg, cpl, w0, w1}, E, Es, A.A.to(D.ct.table()), BIG, hinv))), {==})
  @rw EM.run1(EM.hs(ops, ph), Q.HR{size, b}, Q.XC{ts, tt, seg, cpl, w0, w1}, Q.SP.s0(w0))
  @rw EM.next_r(Q.XC{ts, tt, seg, cpl, w0, w1}, Q.SP.run(EM.hs(ops, ph), Q.XC{ts, tt, seg, cpl, w0, w1}, Q.SP.s0(w0)), size, b)
  @unfold EM.run EM.run.go EM.room
  @simp -EM.tc -EM.q -Q.SP.run -Y.BP.put -GR.t
  @rw EM.q_tc(Y.BP.put(GR.t(td, dl, U32.add(dl, 1)), dl, b), GR.t(ti, il, U32.add(il, 12)), GR.t(ta, al, U32.add(al, 6)), tc, U32.add(dl, 1), il, al, slot, U32.add(uoff, size), pt, ps, pm, pc, 2, size, 0)
  hc


# Addresses decode back
# =====================

# A value and mode that name addr from here, with the cache tc.
def EM.av(+e: N.EB, +here: U32, +tc: A.Tr, +addr: U32) -> Bool:
  match e:
    case N.EB{b, m}:
      Bool.and(U32.is_eq(Q.SP.daddr(m, b, here, tc), addr), Bool.and(Q.SP.aok(m, b, here), Cmp.is_le(Nat.cmp(V.U.N(m), 5n))))

law EM.subsub:
  for +x: U32
  for +y: U32
  {U32.sub(x, U32.sub(x, y)) == y : U32}

def EM.subsub(x, y):
  @rw-[1] V.U.add_sub(x, y)
  @rw V.U.sub_add_l(U32.sub(x, y), y)
  {==}

law EM.addsub:
  for +n: U32
  for +a: U32
  {U32.add(n, U32.sub(a, n)) == a : U32}

def EM.addsub(n, a):
  @rw V.U.add_comm(n, U32.sub(a, n))
  @rw V.U.add_sub(a, n)
  {==}

law EM.av_self.c:
  for +addr: U32
  for +here: U32
  for +tc: A.Tr
  for +hle: {U32.is_le(addr, here) == True{} : Bool}
  for +c: Bool
  for +ec: {Bool.and(U32.is_ge(addr, 128), U32.is_lt(U32.sub(here, addr), addr)) == c : Bool}
  {EM.av(N.ea.self(addr, here), here, tc, addr) == True{} : Bool}

def EM.av_self.c(addr, here, tc, hle, c, ec):
  match c:
    case True{}:
      @unfold N.ea.self
      @rwx ec : {Bool.and(U32.is_ge(addr, 128), U32.is_lt(U32.sub(here, addr), addr)) == True{} : Bool}
      @unfold N.u32.pick
      @simp
      @unfold Q.SP.daddr B.u32.pick Q.SP.aok
      @simp
      @rw EM.subsub(here, addr)
      @rw V.U.is_eq_refl(addr)
      @rw V.U.N_le(U32.sub(here, addr), here, EM.sub_le(here, addr, hle))
      {==}
    case False{}:
      @unfold N.ea.self
      @rwx ec : {Bool.and(U32.is_ge(addr, 128), U32.is_lt(U32.sub(here, addr), addr)) == False{} : Bool}
      @unfold N.u32.pick
      @simp
      @unfold Q.SP.daddr B.u32.pick Q.SP.aok
      @simp
      @rw V.U.is_eq_refl(addr)
      {==}

# SELF or HERE name addr.
law EM.av_self:
  for +addr: U32
  for +here: U32
  for +tc: A.Tr
  for +hle: {U32.is_le(addr, here) == True{} : Bool}
  {EM.av(N.ea.self(addr, here), here, tc, addr) == True{} : Bool}

def EM.av_self(addr, here, tc, hle):
  EM.av_self.c(addr, here, tc, hle, Bool.and(U32.is_ge(addr, 128), U32.is_lt(U32.sub(here, addr), addr)), {==})

law EM.av_near2.c:
  for +addr: U32
  for +here: U32
  for +tc: A.Tr
  for +b: U32
  for +m: U32
  for +hav: {EM.av(N.EB{b, m}, here, tc, addr) == True{} : Bool}
  for +c: Bool
  for +ec: {Bool.and(Bool.and(U32.is_ge(b, 128), U32.is_ge(addr, A.T.word(tc, 768))), U32.is_lt(U32.sub(addr, A.T.word(tc, 768)), b)) == c : Bool}
  {EM.av(N.ea.near(addr, A.T.word(tc, 768), 2, N.EB{b, m}), here, tc, addr) == True{} : Bool}

def EM.av_near2.c(addr, here, tc, b, m, hav, c, ec):
  match c:
    case True{}:
      @simp -EM.av
      @rwx ec : {Bool.and(Bool.and(U32.is_ge(b, 128), U32.is_ge(addr, A.T.word(tc, 768))), U32.is_lt(U32.sub(addr, A.T.word(tc, 768)), b)) == True{} : Bool}
      @unfold N.u32.pick
      @simp
      @unfold Q.SP.daddr B.u32.pick Q.SP.aok
      @simp
      @rw EM.addsub(A.T.word(tc, 768), addr)
      @rw V.U.is_eq_refl(addr)
      {==}
    case False{}:
      @simp -EM.av
      @rwx ec : {Bool.and(Bool.and(U32.is_ge(b, 128), U32.is_ge(addr, A.T.word(tc, 768))), U32.is_lt(U32.sub(addr, A.T.word(tc, 768)), b)) == False{} : Bool}
      @unfold N.u32.pick
      @simp -EM.av
      hav

