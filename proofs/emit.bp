# RUN's state before queueing, and ghost
def EM.run.e1(+pos: U32, +size: U32, +b: U32, +e: ET) -> ET:
  match e:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      ET{Y.BP.put(GR.t(td, dl, U32.add(dl, 1)), dl, b), GR.t(ti, il, U32.add(il, 12)), GR.t(ta, al, U32.add(al, 6)), tc, U32.add(dl, 1), il, al, slot, U32.add(pos, size), pt, ps, pm, pc}

def EM.run.g(+e: ET, +g: EG) -> EG:
  match e g:
    case ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc} EG{ops, ph, dd, di, da}:
      EG{ops, ph, GR.d(td, dl, U32.add(dl, 1), dd), GR.d(ti, il, U32.add(il, 12), di), GR.d(ta, al, U32.add(al, 6), da)}

