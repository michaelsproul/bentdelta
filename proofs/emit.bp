  @rw P.Nat.add_assoc(V.U.N(il), 1n, V.U.N(vl))
  EM.le_k(V.U.N(il), Nat.add(1n, V.U.N(vl)), 12n, V.U.N(BIG), EM.ar1.c(V.U.N(vl), hvl), hB)

law EM.ar1.c:
  for +v: Nat
  for +h: {Cmp.is_le(Nat.cmp(v, 5n)) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(Nat.add(1n, v), 12n)) == True{} : Bool}

def EM.ar1.c(v, h):
  @simp
  P.Nat.le_trans(v, 5n, 11n, h, {==})


law EM.le12:
  for +il: U32
  for +vl: U32
  for +q: Nat
  for +BIG: U32
  for +hvl: {Cmp.is_le(Nat.cmp(V.U.N(vl), 5n)) == True{} : Bool}
  for +hq: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(il), 12n), q)) == True{} : Bool}
  for +hB: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(il), 12n), V.U.N(BIG))) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(U32.add(il, 1)), V.U.N(vl)), q)) == True{} : Bool}

def EM.le12(il, vl, q, BIG, hvl, hq, hB):
  @rw V.U.add_N(il, 1, BIG, EM.le_k(V.U.N(il), 1n, 12n, V.U.N(BIG), {==}, hB))
  @simp
  @rw P.Nat.add_assoc(V.U.N(il), 1n, V.U.N(vl))
  EM.le_k(V.U.N(il), Nat.add(1n, V.U.N(vl)), 12n, q, EM.ar1.c(V.U.N(vl), hvl), hq)

# The pending half written alone: its opcode, then its size if the table
# has none.
law EM.sgi.sec:
  for +z: Bool
  for +ps: U32
  for +pc: U32
  for +ti: A.Tr
  for +il: U32
  for +di: Nat
  for +BIG: U32
  for +L: List<&2, U32>
  for +ph: Q.HF
  for +ez: {N.op.sized(pc) == z : Bool}
  for +hzs: {Bool.or(Bool.and(Q.SP.z(Q.SP.e1(pc)), N.op.sized(pc)), Bool.and(Bool.not(Q.SP.z(Q.SP.e1(pc))), Bool.not(N.op.sized(pc)))) == True{} : Bool}
  for +hz2: {Bool.not(Q.SP.z(Q.SP.e2(pc))) == True{} : Bool}
  for +hps: {ps == Q.SP.size(ph) : U32}
  for +hpf: {A.T.pf(di, ti) == True{} : Bool}
  for +hdi: {Nat.cmp(di, 32n) == LT{} : Cmp}
  for +hh: {S.S.has(L, ti, 0) == True{} : Bool}
  for +hl: {Q.SP.lenis(L, il) == True{} : Bool}
  for +hP12: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(il), 12n), EM.cap(di))) == True{} : Bool}
  for +hB: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(il), 12n), V.U.N(BIG))) == True{} : Bool}
  {Bool.and(S.S.has(K.WD.app(L, Q.SP.ins(Q.OP{pc, ph, Q.HN{}})), EM.tit(EM.sgi(z, ps, Y.BP.put(ti, il, pc), U32.add(il, 1))), 0), Q.SP.lenis(K.WD.app(L, Q.SP.ins(Q.OP{pc, ph, Q.HN{}})), EM.tin(EM.sgi(z, ps, Y.BP.put(ti, il, pc), U32.add(il, 1))))) == True{} : Bool}

def EM.sgi.sec(z, ps, pc, ti, il, di, BIG, L, ph, ez, hzs, hz2, hps, hpf, hdi, hh, hl, hP12, hB):
  match z:
    case True{}:
      @rw EM.ins_sg.t(pc, ph, ps, EM.zs_t(Q.SP.z(Q.SP.e1(pc)), N.op.sized(pc), hzs, ez), hz2, hps)
      @simp -S.S.puts -R.VI.var
      @rwx- K.WD.app_assoc(L, pc <> [], R.VI.var(ps)) : {K.WD.app(K.WD.app(L, pc <> []), R.VI.var(ps)) == K.WD.app(L, pc <> R.VI.var(ps)) : List<&2, U32>}
      EM.secw(di, K.WD.app(L, pc <> []), R.VI.var(ps), Y.BP.put(ti, il, pc), U32.add(il, 1), B.B.var.len(ps), BIG,
        A.T.pf_set(di, ti, U32.shrn(il, 2n), Y.BP.ins(A.T.word(ti, U32.shrn(il, 2n)), B.B.sh(il), pc), hpf), hdi,
        P.Bool.and_l(S.S.has(K.WD.app(L, pc <> []), S.S.puts(pc <> [], ti, il), 0), Q.SP.lenis(K.WD.app(L, pc <> []), U32.add(il, 1)), EM.secw(di, L, pc <> [], ti, il, 1, BIG, hpf, hdi, hh, hl, {==}, EM.le_k(V.U.N(il), 1n, 12n, EM.cap(di), {==}, hP12), EM.le_k(V.U.N(il), 1n, 12n, V.U.N(BIG), {==}, hB))), P.Bool.and_r(S.S.has(K.WD.app(L, pc <> []), S.S.puts(pc <> [], ti, il), 0), Q.SP.lenis(K.WD.app(L, pc <> []), U32.add(il, 1)), EM.secw(di, L, pc <> [], ti, il, 1, BIG, hpf, hdi, hh, hl, {==}, EM.le_k(V.U.N(il), 1n, 12n, EM.cap(di), {==}, hP12), EM.le_k(V.U.N(il), 1n, 12n, V.U.N(BIG), {==}, hB))), R.VI.len_var(ps),
        EM.le12(il, B.B.var.len(ps), EM.cap(di), BIG, EM.vl5(ps), hP12, hB), EM.le12(il, B.B.var.len(ps), V.U.N(BIG), BIG, EM.vl5(ps), hB, hB))
    case False{}:
      @rw EM.ins_sg.f(pc, ph, EM.zs_f(Q.SP.z(Q.SP.e1(pc)), N.op.sized(pc), hzs, ez), hz2)
      @simp -S.S.puts
      EM.secw(di, L, pc <> [], ti, il, 1, BIG, hpf, hdi, hh, hl, {==}, EM.le_k(V.U.N(il), 1n, 12n, EM.cap(di), {==}, hP12), EM.le_k(V.U.N(il), 1n, 12n, V.U.N(BIG), {==}, hB))

law EM.sgi.pf:
  for +z: Bool
  for +ps: U32
  for +pc: U32
  for +ti: A.Tr
  for +il: U32
  for +di: Nat
  for +hpf: {A.T.pf(di, ti) == True{} : Bool}
  {A.T.pf(di, EM.tit(EM.sgi(z, ps, Y.BP.put(ti, il, pc), U32.add(il, 1)))) == True{} : Bool}

def EM.sgi.pf(z, ps, pc, ti, il, di, hpf):
  match z:
    case True{}:
      @simp -S.S.puts
      S.S.pf_puts(di, R.VI.var(ps), Y.BP.put(ti, il, pc), U32.add(il, 1), A.T.pf_set(di, ti, U32.shrn(il, 2n), Y.BP.ins(A.T.word(ti, U32.shrn(il, 2n)), B.B.sh(il), pc), hpf))
    case False{}:
      A.T.pf_set(di, ti, U32.shrn(il, 2n), Y.BP.ins(A.T.word(ti, U32.shrn(il, 2n)), B.B.sh(il), pc), hpf)

# The opcode and size take 6 bytes at most.
law EM.sgi.le:
  for +z: Bool
  for +ps: U32
  for +pc: U32
  for +ti: A.Tr
  for +il: U32
  for +BIG: U32
  for +hB: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(il), 12n), V.U.N(BIG))) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(V.U.N(EM.tin(EM.sgi(z, ps, Y.BP.put(ti, il, pc), U32.add(il, 1)))), Nat.add(V.U.N(il), 6n))) == True{} : Bool}

def EM.sgi.le(z, ps, pc, ti, il, BIG, hB):
  match z:
    case True{}:
      @simp
      @rw V.U.add_N(U32.add(il, 1), B.B.var.len(ps), BIG, EM.le12(il, B.B.var.len(ps), V.U.N(BIG), BIG, EM.vl5(ps), hB, hB))
      @rw V.U.add_N(il, 1, BIG, EM.le_k(V.U.N(il), 1n, 12n, V.U.N(BIG), {==}, hB))
      @simp
      @rw P.Nat.add_assoc(V.U.N(il), 1n, V.U.N(B.B.var.len(ps)))
      @rw P.Nat.cmp_add_l(V.U.N(il), Nat.add(1n, V.U.N(B.B.var.len(ps))), 6n)
      @simp
      P.Nat.le_trans(V.U.N(B.B.var.len(ps)), 5n, 5n, EM.vl5(ps), {==})
    case False{}:
      @simp
      @rw V.U.add_N(il, 1, BIG, EM.le_k(V.U.N(il), 1n, 12n, V.U.N(BIG), {==}, hB))
      @rw P.Nat.cmp_add_l(V.U.N(il), 1n, 6n)
      {==}


# The pending half's own opcode fits the table.
law EM.cs_ph:
  for +ph: Q.HF
  for +pt: U32
  for +ps: U32
  for +pm: U32
  for +hpt: {pt == Q.SP.kind(ph) : U32}
  for +hps: {ps == Q.SP.size(ph) : U32}
  for +hpm: {pm == Q.SP.mode(ph) : U32}
  for +hpm8: {Cmp.is_le(Nat.cmp(V.U.N(pm), 8n)) == True{} : Bool}
  for +hne: {U32.is_ne(pt, 0) == True{} : Bool}
  {T.CT.S(N.op.single(pt, ps, pm), pt, ps, pm) == True{} : Bool}

def EM.cs_ph(ph, pt, ps, pm, hpt, hps, hpm, hpm8, hne):
  match ph:
    case Q.HN{}:
      P.Bool.false_true({T.CT.S(N.op.single(pt, ps, pm), pt, ps, pm) == True{} : Bool}, (%hpt : {U32.is_ne(_, 0) == True{} : Bool}; hne))
    case Q.HA{n, xs}:
      @rwx hpt : {pt == 1 : U32}
      @rwx hps : {ps == n : U32}
      @rwx hpm : {pm == 0 : U32}
      T.CT.add(n)
    case Q.HR{n, b}:
      @rwx hpt : {pt == 2 : U32}
      @rwx hps : {ps == n : U32}
      @rwx hpm : {pm == 0 : U32}
      T.CT.run(n)
    case Q.HC{n, m, v}:
      @rwx hpt : {pt == 3 : U32}
      @rwx hps : {ps == n : U32}
      @rwx hpm : {pm == m : U32}
      T.CT.copy(n, m, (%hpm : {Cmp.is_le(Nat.cmp(V.U.N(_), 8n)) == True{} : Bool}; hpm8))

law EM.cok_sg:
  for +pc: U32
  for +ph: Q.HF
  for +pt: U32
  for +ps: U32
  for +pm: U32
  for +hpt: {pt == Q.SP.kind(ph) : U32}
  for +hps: {ps == Q.SP.size(ph) : U32}
  for +hpm: {pm == Q.SP.mode(ph) : U32}
  for +hpc: {pc == N.op.single(pt, ps, pm) : U32}
  for +hcs: {T.CT.S(N.op.single(pt, ps, pm), pt, ps, pm) == True{} : Bool}
  {Q.SP.cok(A.A.to(D.ct.table()), Q.OP{pc, ph, Q.HN{}}) == True{} : Bool}

def EM.cok_sg(pc, ph, pt, ps, pm, hpt, hps, hpm, hpc, hcs):
  @rwx hpc : {pc == N.op.single(pt, ps, pm) : U32}
  @unfold Q.SP.cok
  @simp -Q.SP.hok -D.ct.table -A.A.to -D.ct.entry -N.op.single
  @rw T.CT.tab(N.op.single(pt, ps, pm), EM.CS.lt(N.op.single(pt, ps, pm), pt, ps, pm, hcs))
  @rw V.U.is_eq_refl(D.ct.entry(N.op.single(pt, ps, pm)))
  @rwx EM.CS.lt(N.op.single(pt, ps, pm), pt, ps, pm, hcs) : {U32.is_lt(N.op.single(pt, ps, pm), 256) == True{} : Bool}
  @simp -Q.SP.hok -N.op.single
  @unfold Q.SP.hok
  @rwx- hpt : {pt == Q.SP.kind(ph) : U32}
  @rwx- hps : {ps == Q.SP.size(ph) : U32}
  @rwx- hpm : {pm == Q.SP.mode(ph) : U32}
  @simp -N.op.single
  EM.and2(T.CT.hok3(Q.SP.e1(N.op.single(pt, ps, pm)), pt, ps, pm), T.CT.hok3(Q.SP.e2(N.op.single(pt, ps, pm)), 0, 0, 0), EM.CS.h1(N.op.single(pt, ps, pm), pt, ps, pm, hcs), EM.CS.h2(N.op.single(pt, ps, pm), pt, ps, pm, hcs))

# The state before the new half stays inside E.
law EM.so_le:
  for +a: List<&2, Q.HF>
  for +h: Q.HF
  for +x: Q.XC
  for +s: Q.ST
  for +E: U32
  for +Es: U32
  for +hb: {Q.SP.bnds(EM.happ(a, h <> []), x, s, E, Es) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(V.U.N(Q.SP.so(Q.SP.run(a, x, s))), V.U.N(E))) == True{} : Bool}

def EM.so_le(a, h, x, s, E, Es, hb):
  P.Nat.le_trans(V.U.N(Q.SP.so(Q.SP.run(a, x, s))), Nat.add(U32.to_nat(Q.SP.size(h)), U32.to_nat(Q.SP.so(Q.SP.run(a, x, s)))), V.U.N(E),
    P.Nat.le_add_l(U32.to_nat(Q.SP.size(h)), U32.to_nat(Q.SP.so(Q.SP.run(a, x, s)))),
    P.Bool.and_l(Cmp.is_le(Nat.cmp(Nat.add(U32.to_nat(Q.SP.size(h)), U32.to_nat(Q.SP.so(Q.SP.run(a, x, s)))), U32.to_nat(E))), Q.SP.hbnd(x, Q.SP.run(a, x, s), h, Es),
      P.Bool.and_l(Q.SP.bnd(x, Q.SP.run(a, x, s), h, E, Es), True{},
        P.Bool.and_r(Q.SP.bnds(a, x, s, E, Es), Q.SP.bnds(h <> [], x, Q.SP.run(a, x, s), E, Es),
          (%EM.bnds_app(a, h <> [], x, s, E, Es) : {_ == True{} : Bool}; hb)))))


