  {EM.pend(ph) == ph <> [] : List<&2, Q.HF>}

def EM.pend_ne(ph, pt, hpt, hne):
  match ph:
    case Q.HN{}:
      P.Bool.false_true({EM.pend(Q.HN{}) == Q.HN{} <> [] : List<&2, Q.HF>}, (%hpt : {U32.is_ne(_, 0) == True{} : Bool}; hne))
    case Q.HA{n, xs}:
      {==}
    case Q.HR{n, b}:
      {==}
    case Q.HC{n, m, v}:
      {==}

