# A half after the others
# =======================

law EM.next_a:
  for +x: Q.XC
  for +s: Q.ST
  for +n: U32
  for +xs: List<&2, U32>
  {Q.SP.next(x, s, Q.HA{n, xs}) == Q.ST{U32.add(Q.SP.so(s), n), Q.SP.sc(s), Q.SP.ss(s)} : Q.ST}

def EM.next_a(x, s, n, xs):
  match s:
    case Q.ST{opos, c, slot}:
      {==}

law EM.next_r:
  for +x: Q.XC
  for +s: Q.ST
  for +n: U32
  for +b: U32
  {Q.SP.next(x, s, Q.HR{n, b}) == Q.ST{U32.add(Q.SP.so(s), n), Q.SP.sc(s), Q.SP.ss(s)} : Q.ST}

def EM.next_r(x, s, n, b):
  match s:
    case Q.ST{opos, c, slot}:
      {==}

law EM.next_c:
  for +x: Q.XC
  for +s: Q.ST
  for +n: U32
  for +m: U32
  for +v: U32
  {Q.SP.next(x, s, Q.HC{n, m, v}) == Q.ST{U32.add(Q.SP.so(s), n), Q.SP.cput(Q.SP.sc(s), Q.SP.ss(s), Q.SP.daddr(m, v, Q.SP.here(x, Q.SP.so(s)), Q.SP.sc(s))), U32.and(U32.add(Q.SP.ss(s), 1), 3)} : Q.ST}

def EM.next_c(x, s, n, m, v):
  match s:
    case Q.ST{opos, c, slot}:
      {==}

law EM.vst_of:
  for +x: Q.XC
  for +s: Q.ST
  for +f: Q.HF
  for +h: {Q.SP.vh(x, Q.SP.so(s), Q.SP.sc(s), f) == True{} : Bool}
  {Q.SP.vst(x, s, f) == True{} : Bool}

def EM.vst_of(x, s, f, h):
  match s:
    case Q.ST{opos, c, slot}:
      h

law EM.bnd_of:
  for +x: Q.XC
  for +s: Q.ST
  for +f: Q.HF
  for +E: U32
  for +Es: U32
  for +h1: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(Q.SP.size(f)), V.U.N(Q.SP.so(s))), V.U.N(E))) == True{} : Bool}
  for +h2: {Q.SP.hbnd(x, Q.ST{Q.SP.so(s), Q.SP.sc(s), Q.SP.ss(s)}, f, Es) == True{} : Bool}
  {Q.SP.bnd(x, s, f, E, Es) == True{} : Bool}

def EM.bnd_of(x, s, f, E, Es, h1, h2):
  match s:
    case Q.ST{opos, c, slot}:
      @unfold Q.SP.bnd
      @rename U32.to_nat V.U.N
      @simp -Q.SP.hbnd -Q.SP.size
      EM.and2(Cmp.is_le(Nat.cmp(Nat.add(V.U.N(Q.SP.size(f)), V.U.N(opos)), V.U.N(E))), Q.SP.hbnd(x, Q.ST{opos, c, slot}, f, Es), h1, h2)

# The halves then one more: run, and what holds.
law EM.run1:
  for +a: List<&2, Q.HF>
  for +h: Q.HF
  for +x: Q.XC
  for +s: Q.ST
  {Q.SP.run(EM.happ(a, h <> []), x, s) == Q.SP.next(x, Q.SP.run(a, x, s), h) : Q.ST}

def EM.run1(a, h, x, s):
  @rw EM.run_app(a, h <> [], x, s)
  {==}

law EM.vhs1:
  for +a: List<&2, Q.HF>
  for +h: Q.HF
  for +x: Q.XC
  for +s: Q.ST
  for +ha: {Q.SP.vhs(a, x, s) == True{} : Bool}
  for +hh: {Q.SP.vst(x, Q.SP.run(a, x, s), h) == True{} : Bool}
  {Q.SP.vhs(EM.happ(a, h <> []), x, s) == True{} : Bool}

def EM.vhs1(a, h, x, s, ha, hh):
  @rw EM.vhs_app(a, h <> [], x, s)
  @rwx ha : {Q.SP.vhs(a, x, s) == True{} : Bool}
  @simp -Q.SP.vst -Q.SP.run
  @rwx hh : {Q.SP.vst(x, Q.SP.run(a, x, s), h) == True{} : Bool}
  {==}

law EM.bnds1:
  for +a: List<&2, Q.HF>
  for +h: Q.HF
  for +x: Q.XC
  for +s: Q.ST
  for +E: U32
  for +Es: U32
  for +ha: {Q.SP.bnds(a, x, s, E, Es) == True{} : Bool}
  for +hh: {Q.SP.bnd(x, Q.SP.run(a, x, s), h, E, Es) == True{} : Bool}
  {Q.SP.bnds(EM.happ(a, h <> []), x, s, E, Es) == True{} : Bool}

def EM.bnds1(a, h, x, s, E, Es, ha, hh):
  @rw EM.bnds_app(a, h <> [], x, s, E, Es)
  @rwx ha : {Q.SP.bnds(a, x, s, E, Es) == True{} : Bool}
  @simp -Q.SP.bnd -Q.SP.run
  @rwx hh : {Q.SP.bnd(x, Q.SP.run(a, x, s), h, E, Es) == True{} : Bool}
  {==}

law EM.doks1:
  for +a: List<&2, Q.HF>
  for +h: Q.HF
  for +ha: {Q.SP.doks(a) == True{} : Bool}
  for +hh: {Q.SP.dok(h) == True{} : Bool}
  {Q.SP.doks(EM.happ(a, h <> [])) == True{} : Bool}

def EM.doks1(a, h, ha, hh):
  @rw EM.doks_app(a, h <> [])
  @rwx ha : {Q.SP.doks(a) == True{} : Bool}
  @simp -Q.SP.dok
  @rwx hh : {Q.SP.dok(h) == True{} : Bool}
  {==}

law EM.datl1:
  for +a: List<&2, Q.HF>
  for +h: Q.HF
  {Q.SP.datl(EM.happ(a, h <> [])) == K.WD.app(Q.SP.datl(a), Q.SP.dat(h)) : List<&2, U32>}

def EM.datl1(a, h):
  @rw EM.datl_app(a, h <> [])
  @simp -Q.SP.dat
  @rw K.WD.app_nil(Q.SP.dat(h))
  {==}

law EM.adrl1:
  for +a: List<&2, Q.HF>
  for +h: Q.HF
  {Q.SP.adrl(EM.happ(a, h <> [])) == K.WD.app(Q.SP.adrl(a), Q.SP.adr(h)) : List<&2, U32>}

def EM.adrl1(a, h):
  @rw EM.adrl_app(a, h <> [])
  @simp -Q.SP.adr
  @rw K.WD.app_nil(Q.SP.adr(h))
  {==}

# Arithmetic
# ==========

law EM.subadd:
  for +u: U32
  for +s: U32
  for +w: U32
  {U32.sub(U32.add(u, s), w) == U32.add(U32.sub(u, w), s) : U32}

def EM.subadd(u, s, w):
  @rw-[1] V.U.add_sub(u, w)
  @rw V.U.add_assoc(U32.sub(u, w), w, s)
  @rw V.U.add_comm(w, s)
  @rw- V.U.add_assoc(U32.sub(u, w), s, w)
  @rw V.U.sub_add(U32.add(U32.sub(u, w), s), w)
  {==}

# u - w is at most u.
law EM.sub_le:
  for +u: U32
  for +w: U32
  for +h: {U32.is_le(w, u) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(V.U.N(U32.sub(u, w)), V.U.N(u))) == True{} : Bool}

def EM.sub_le(u, w, h):
  @rw- V.U.sub_nat(u, w, h)
  P.Nat.cmp_add_r(V.U.N(U32.sub(u, w)), V.U.N(w))

# The bytes of the window up to u + s.
law EM.kadd:
  for +u: U32
  for +s: U32
  for +w: U32
  for +B: U32
  for +hlo: {U32.is_le(w, u) == True{} : Bool}
  for +hb: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(u), V.U.N(s)), V.U.N(B))) == True{} : Bool}
  {V.U.N(U32.sub(U32.add(u, s), w)) == Nat.add(V.U.N(U32.sub(u, w)), V.U.N(s)) : Nat}

def EM.kadd(u, s, w, B, hlo, hb):
  @rw EM.subadd(u, s, w)
  @rw V.U.add_N(U32.sub(u, w), s, B, P.Nat.le_trans(Nat.add(V.U.N(U32.sub(u, w)), V.U.N(s)), Nat.add(V.U.N(u), V.U.N(s)), V.U.N(B), C.CP.le_add_r(V.U.N(U32.sub(u, w)), V.U.N(u), V.U.N(s), EM.sub_le(u, w, hlo)), hb))
  {==}

# u - w at most v - w, for w <= u <= v.
law EM.k_le:
  for +u: U32
  for +v: U32
  for +w: U32
  for +hlo: {U32.is_le(w, u) == True{} : Bool}
  for +hhi: {U32.is_le(u, v) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(V.U.N(U32.sub(u, w)), V.U.N(U32.sub(v, w)))) == True{} : Bool}

def EM.k_le(u, v, w, hlo, hhi):
  @rw- P.Nat.cmp_add_rr(V.U.N(U32.sub(u, w)), V.U.N(U32.sub(v, w)), V.U.N(w))
  @rw V.U.sub_nat(u, w, hlo)
  @rw V.U.sub_nat(v, w, V.U.N_le(w, v, P.Nat.le_trans(V.U.N(w), V.U.N(u), V.U.N(v), V.U.le_N(w, u, hlo), V.U.le_N(u, v, hhi))))
  V.U.le_N(u, v, hhi)

law EM.dd3_mono:
  for +a: Nat
  for +b: Nat
  for +h: {Cmp.is_le(Nat.cmp(a, b)) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(Nat.double(Nat.double(Nat.double(a))), Nat.double(Nat.double(Nat.double(b))))) == True{} : Bool}

def EM.dd3_mono(a, b, h):
  P.Nat.double_mono(Nat.double(Nat.double(a)), Nat.double(Nat.double(b)), GR.dd2(a, b, h))

law EM.dd3_add:
  for +a: Nat
  for +b: Nat
  {Nat.double(Nat.double(Nat.double(Nat.add(a, b)))) == Nat.add(Nat.double(Nat.double(Nat.double(a))), Nat.double(Nat.double(Nat.double(b)))) : Nat}

def EM.dd3_add(a, b):
  @rw P.Nat.double_distr(a, b)
  @rw P.Nat.double_distr(Nat.double(a), Nat.double(b))
  @rw P.Nat.double_distr(Nat.double(Nat.double(a)), Nat.double(Nat.double(b)))
  {==}

law EM.le_dd3:
  for +a: Nat
  {Cmp.is_le(Nat.cmp(a, Nat.double(Nat.double(Nat.double(a))))) == True{} : Bool}

def EM.le_dd3(a):
  P.Nat.le_trans(a, Nat.double(a), Nat.double(Nat.double(Nat.double(a))), GR.le_dbl(a),
    P.Nat.le_trans(Nat.double(a), Nat.double(Nat.double(a)), Nat.double(Nat.double(Nat.double(a))), GR.le_dbl(Nat.double(a)), GR.le_dbl(Nat.double(Nat.double(a)))))

# Eight more bytes of room after one more byte of the window.
law EM.k8:
  for +i: Nat
  for +k: Nat
  for +s: Nat
  for +h: {Cmp.is_le(Nat.cmp(i, Nat.double(Nat.double(Nat.double(k))))) == True{} : Bool}
  for +hs: {Cmp.is_le(Nat.cmp(1n, s)) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(Nat.add(i, 8n), Nat.double(Nat.double(Nat.double(Nat.add(k, s)))))) == True{} : Bool}

def EM.k8(i, k, s, h, hs):
  @rw EM.dd3_add(k, s)
  MT_.MT.add_le(i, Nat.double(Nat.double(Nat.double(k))), 8n, Nat.double(Nat.double(Nat.double(s))), h, EM.dd3_mono(1n, s, hs))

# A bound at k stays a bound at k + s.
law EM.kup:
  for +i: Nat
  for +k: Nat
  for +s: Nat
  for +h: {Cmp.is_le(Nat.cmp(i, Nat.double(Nat.double(Nat.double(k))))) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(i, Nat.double(Nat.double(Nat.double(Nat.add(k, s)))))) == True{} : Bool}

def EM.kup(i, k, s, h):
  P.Nat.le_trans(i, Nat.double(Nat.double(Nat.double(k))), Nat.double(Nat.double(Nat.double(Nat.add(k, s)))), h, EM.dd3_mono(k, Nat.add(k, s), P.Nat.cmp_add_r(k, s)))


# Five times: the address section's bound per target byte.
def EM.k5(+x: Nat) -> Nat:
  Nat.add(Nat.double(Nat.double(x)), x)

law EM.k5_mono:
  for +a: Nat
  for +b: Nat
  for +h: {Cmp.is_le(Nat.cmp(a, b)) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(EM.k5(a), EM.k5(b))) == True{} : Bool}

def EM.k5_mono(a, b, h):
  MT_.MT.add_le(Nat.double(Nat.double(a)), Nat.double(Nat.double(b)), a, b, GR.dd2(a, b, h), h)

law EM.kup5:
  for +i: Nat
  for +k: Nat
  for +s: Nat
  for +h: {Cmp.is_le(Nat.cmp(i, EM.k5(k))) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(i, EM.k5(Nat.add(k, s)))) == True{} : Bool}

def EM.kup5(i, k, s, h):
  P.Nat.le_trans(i, EM.k5(k), EM.k5(Nat.add(k, s)), h, EM.k5_mono(k, Nat.add(k, s), P.Nat.cmp_add_r(k, s)))

law EM.k5_add:
  for +k: Nat
  for +s: Nat
  {EM.k5(Nat.add(k, s)) == Nat.add(EM.k5(k), EM.k5(s)) : Nat}

def EM.k5_add(k, s):
  @unfold EM.k5
  @rw P.Nat.double_distr(k, s)
  @rw P.Nat.double_distr(Nat.double(k), Nat.double(s))
  @rw P.Nat.add_swap_mid(Nat.double(Nat.double(k)), Nat.double(Nat.double(s)), k, s)
  {==}

# A bound at k, with 5 more, is a bound at k + s for s >= 1.
law EM.k5b:
  for +i: Nat
  for +k: Nat
  for +s: Nat
  for +h: {Cmp.is_le(Nat.cmp(i, EM.k5(k))) == True{} : Bool}
  for +hs: {Cmp.is_le(Nat.cmp(1n, s)) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(Nat.add(i, 5n), EM.k5(Nat.add(k, s)))) == True{} : Bool}

def EM.k5b(i, k, s, h, hs):
  @rw EM.k5_add(k, s)
  MT_.MT.add_le(i, EM.k5(k), 5n, EM.k5(s), h, EM.k5_mono(1n, s, hs))

law EM.k5_dd3:
  for +x: Nat
  {Cmp.is_le(Nat.cmp(EM.k5(x), Nat.double(Nat.double(Nat.double(x))))) == True{} : Bool}

def EM.k5_dd3(x):
  @unfold EM.k5
  @rw P.Nat.double_add(Nat.double(Nat.double(x)))
  P.Nat.le_trans(Nat.add(Nat.double(Nat.double(x)), x), Nat.add(Nat.double(Nat.double(x)), Nat.double(Nat.double(x))), Nat.add(Nat.double(Nat.double(x)), Nat.double(Nat.double(x))),
    (%Equal.sym(Cmp, Nat.cmp(Nat.add(Nat.double(Nat.double(x)), x), Nat.add(Nat.double(Nat.double(x)), Nat.double(Nat.double(x)))), Nat.cmp(x, Nat.double(Nat.double(x))), P.Nat.cmp_add_l(Nat.double(Nat.double(x)), x, Nat.double(Nat.double(x)))) : {Cmp.is_le(_) == True{} : Bool};
      P.Nat.le_trans(x, Nat.double(x), Nat.double(Nat.double(x)), GR.le_dbl(x), GR.le_dbl(Nat.double(x)))),
    C.CP.le_refl(Nat.add(Nat.double(Nat.double(x)), Nat.double(Nat.double(x)))))



