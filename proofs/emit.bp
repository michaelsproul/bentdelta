# The SAME slot
# =============

law EM.h8:
  for +r: U32
  {V.U.N(U32.shrn(r, 8n)) == P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(V.U.N(r))))))))) : Nat}

def EM.h8(r):
  @goal {V.U.N(U32.shr(U32.shr(U32.shr(U32.shr(U32.shr(U32.shr(U32.shr(U32.shr(r))))))))) == P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(V.U.N(r))))))))) : Nat}
  @rw V.U.N_shr(U32.shr(U32.shr(U32.shr(U32.shr(U32.shr(U32.shr(U32.shr(r))))))))
  @rw V.U.N_shr(U32.shr(U32.shr(U32.shr(U32.shr(U32.shr(U32.shr(r)))))))
  @rw V.U.N_shr(U32.shr(U32.shr(U32.shr(U32.shr(U32.shr(r))))))
  @rw V.U.N_shr(U32.shr(U32.shr(U32.shr(U32.shr(r)))))
  @rw V.U.N_shr(U32.shr(U32.shr(U32.shr(r))))
  @rw V.U.N_shr(U32.shr(U32.shr(r)))
  @rw V.U.N_shr(U32.shr(r))
  @rw V.U.N_shr(r)
  {==}

law EM.hm8:
  for +a: Nat
  for +h: {Cmp.is_le(Nat.cmp(a, 767n)) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(a)))))))), 2n)) == True{} : Bool}

def EM.hm8(a, h):
  P.Nat.half_mono(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(a))))))), 5n,
    P.Nat.half_mono(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(a)))))), 11n,
      P.Nat.half_mono(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(a))))), 23n,
        P.Nat.half_mono(P.Nat.half(P.Nat.half(P.Nat.half(P.Nat.half(a)))), 47n,
          P.Nat.half_mono(P.Nat.half(P.Nat.half(P.Nat.half(a))), 95n,
            P.Nat.half_mono(P.Nat.half(P.Nat.half(a)), 191n,
              P.Nat.half_mono(P.Nat.half(a), 383n,
                P.Nat.half_mono(a, 767n, h))))))))

# The SAME cache's slot of addr, over 256, is at most 2.
law EM.j2:
  for +addr: U32
  {Cmp.is_le(Nat.cmp(V.U.N(U32.shrn(U32.mod(addr, 768), 8n)), 2n)) == True{} : Bool}

def EM.j2(addr):
  @rw EM.h8(U32.mod(addr, 768))
  EM.hm8(V.U.N(U32.mod(addr, 768)), P.Nat.lt_succ_le(V.U.N(U32.mod(addr, 768)), 767n, UM_.UM.mod(addr, 768, {==}, {==})))

law EM.nlt0:
  for +n: Nat
  {Cmp.is_lt(Nat.cmp(n, 0n)) == False{} : Bool}

def EM.nlt0(n):
  match n:
    case 0n:
      {==}
    case 1n+p:
      {==}

# The SAME modes, 6 + x for x <= 2.
law EM.m6:
  for +x: U32
  for +h: {Cmp.is_le(Nat.cmp(V.U.N(x), 2n)) == True{} : Bool}
  {V.U.N(U32.add(6, x)) == Nat.add(V.U.N(6), V.U.N(x)) : Nat}

def EM.m6(x, h):
  V.U.add_N(6, x, 8, h)

law EM.m6.lt6:
  for +x: U32
  for +h: {Cmp.is_le(Nat.cmp(V.U.N(x), 2n)) == True{} : Bool}
  {U32.is_lt(U32.add(6, x), 6) == False{} : Bool}

def EM.m6.lt6(x, h):
  @unfold U32.is_lt
  @rw V.U.cmp_nat(U32.add(6, x), 6)
  @rw EM.m6(x, h)
  EM.nlt0(V.U.N(x))

law EM.m6.eq0:
  for +x: U32
  for +h: {Cmp.is_le(Nat.cmp(V.U.N(x), 2n)) == True{} : Bool}
  {U32.is_eq(U32.add(6, x), 0) == False{} : Bool}

def EM.m6.eq0(x, h):
  @unfold U32.is_eq
  @rw V.U.cmp_nat(U32.add(6, x), 0)
  @rw EM.m6(x, h)
  {==}

law EM.m6.eq1:
  for +x: U32
  for +h: {Cmp.is_le(Nat.cmp(V.U.N(x), 2n)) == True{} : Bool}
  {U32.is_eq(U32.add(6, x), 1) == False{} : Bool}

def EM.m6.eq1(x, h):
  @unfold U32.is_eq
  @rw V.U.cmp_nat(U32.add(6, x), 1)
  @rw EM.m6(x, h)
  {==}

law EM.m6.lt9:
  for +x: U32
  for +h: {Cmp.is_le(Nat.cmp(V.U.N(x), 2n)) == True{} : Bool}
  {U32.is_lt(U32.add(6, x), 9) == True{} : Bool}

def EM.m6.lt9(x, h):
  @unfold U32.is_lt
  @rw V.U.cmp_nat(U32.add(6, x), 9)
  @rw EM.m6(x, h)
  @goal {Cmp.is_lt(Nat.cmp(V.U.N(x), 3n)) == True{} : Bool}
  @rw P.Nat.le_lt_succ(V.U.N(x), 2n, h)
  {==}

law EM.m6.le8:
  for +x: U32
  for +h: {Cmp.is_le(Nat.cmp(V.U.N(x), 2n)) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(V.U.N(U32.add(6, x)), 8n)) == True{} : Bool}

def EM.m6.le8(x, h):
  @rw EM.m6(x, h)
  h

law EM.m6.ne1:
  for +x: U32
  for +h: {Cmp.is_le(Nat.cmp(V.U.N(x), 2n)) == True{} : Bool}
  {U32.is_ne(U32.add(6, x), 1) == True{} : Bool}

def EM.m6.ne1(x, h):
  @unfold U32.is_ne
  @rw V.U.cmp_nat(U32.add(6, x), 1)
  @rw EM.m6(x, h)
  {==}

# A mode and value that name addr from here, with the cache tc.
def EM.av8(+m: U32, +v: U32, +here: U32, +tc: A.Tr, +addr: U32) -> Bool:
  Bool.and(U32.is_eq(Q.SP.daddr(m, v, here, tc), addr), Bool.and(Q.SP.aok(m, v, here), Cmp.is_le(Nat.cmp(V.U.N(m), 8n))))

# The SAME slot names addr when it holds it.
law EM.av_same:
  for +addr: U32
  for +here: U32
  for +tc: A.Tr
  for +hs: {U32.is_eq(A.T.word(tc, U32.mod(addr, 768)), addr) == True{} : Bool}
  {EM.av8(U32.add(6, U32.shrn(U32.mod(addr, 768), 8n)), U32.and(U32.mod(addr, 768), 255), here, tc, addr) == True{} : Bool}

def EM.av_same(addr, here, tc, hs):
  @unfold EM.av8 Q.SP.daddr Q.SP.aok
  @rw EM.m6.lt6(U32.shrn(U32.mod(addr, 768), 8n), EM.j2(addr))
  @rw EM.m6.eq0(U32.shrn(U32.mod(addr, 768), 8n), EM.j2(addr))
  @rw EM.m6.eq1(U32.shrn(U32.mod(addr, 768), 8n), EM.j2(addr))
  @rw EM.m6.lt9(U32.shrn(U32.mod(addr, 768), 8n), EM.j2(addr))
  @unfold B.u32.pick
  @simp -A.T.word -U32.mod -U32.shrn -U32.add -U32.sub -U32.and -U32.or -U32.shln -V.U.N
  @rw V.U.sub_add_l(6, U32.shrn(U32.mod(addr, 768), 8n))
  @rw Z.BB.and255(U32.mod(addr, 768))
  @rw Z.BB.split8(U32.mod(addr, 768))
  @rwx hs : {U32.is_eq(A.T.word(tc, U32.mod(addr, 768)), addr) == True{} : Bool}
  @rw EM.m6.ne1(U32.shrn(U32.mod(addr, 768), 8n), EM.j2(addr))
  @rw EM.m6.le8(U32.shrn(U32.mod(addr, 768), 8n), EM.j2(addr))
  {==}

# What an address writes
# ======================

def EM.am(+a: AT) -> U32:
  match a:
    case AT{tc, ta, al, mode, v}:
      mode

def EM.avv(+a: AT) -> U32:
  match a:
    case AT{tc, ta, al, mode, v}:
      v

def EM.alen(+m: U32, +v: U32) -> U32:
  B.u32.pick(U32.is_lt(m, 6), B.B.var.len(v), 1)

# The address of mode m and value v, written at al, and the cache put.
def EM.awr(+addr: U32, +ta: A.Tr, +al: U32, +slot: U32, +tc: A.Tr, +m: U32, +v: U32) -> AT:
  AT{Q.SP.cput(tc, slot, addr), S.S.puts(Q.SP.adr.m(U32.is_lt(m, 6), v), ta, al), U32.add(al, EM.alen(m, v)), m, v}

law EM.alen_len.c:
  for +m: U32
  for +v: U32
  for +c: Bool
  for +ec: {U32.is_lt(m, 6) == c : Bool}
  {S.S.len(Q.SP.adr.m(U32.is_lt(m, 6), v)) == V.U.N(EM.alen(m, v)) : Nat}

def EM.alen_len.c(m, v, c, ec):
  match c:
    case True{}:
      @unfold EM.alen
      @rwx ec : {U32.is_lt(m, 6) == True{} : Bool}
      @unfold B.u32.pick
      @simp -S.S.len -R.VI.var -B.B.var.len
      R.VI.len_var(v)
    case False{}:
      @unfold EM.alen
      @rwx ec : {U32.is_lt(m, 6) == False{} : Bool}
      @unfold B.u32.pick
      @simp
      {==}

law EM.alen_len:
  for +m: U32
  for +v: U32
  {S.S.len(Q.SP.adr.m(U32.is_lt(m, 6), v)) == V.U.N(EM.alen(m, v)) : Nat}

def EM.alen_len(m, v):
  EM.alen_len.c(m, v, U32.is_lt(m, 6), {==})

law EM.alen5:
  for +m: U32
  for +v: U32
  {Cmp.is_le(Nat.cmp(V.U.N(EM.alen(m, v)), 5n)) == True{} : Bool}

def EM.alen5(m, v):
  @unfold EM.alen
  EM.pick_le(U32.is_lt(m, 6), B.B.var.len(v), 1, 5n, EM.vl5(v), {==})

law EM.efin_w.c:
  for +addr: U32
  for +sm: U32
  for +ta: A.Tr
  for +al: U32
  for +slot: U32
  for +tc: A.Tr
  for +b5: U32
  for +m5: U32
  for +hm: {Cmp.is_le(Nat.cmp(V.U.N(m5), 5n)) == True{} : Bool}
  for +c: Bool
  for +ec: {Bool.and(U32.is_ge(b5, 128), U32.is_eq(sm, addr)) == c : Bool}
  {EM.efin(addr, sm, ta, al, slot, tc, N.EB{b5, m5}) == EM.awr(addr, ta, al, slot, tc, EM.am(EM.efin(addr, sm, ta, al, slot, tc, N.EB{b5, m5})), EM.avv(EM.efin(addr, sm, ta, al, slot, tc, N.EB{b5, m5}))) : AT}

def EM.efin_w.c(addr, sm, ta, al, slot, tc, b5, m5, hm, c, ec):
  match c:
    case True{}:
      @unfold EM.efin
      @rwx ec : {Bool.and(U32.is_ge(b5, 128), U32.is_eq(sm, addr)) == True{} : Bool}
      @unfold EM.eput EM.am EM.avv EM.awr EM.alen
      @rw EM.m6.lt6(U32.shrn(U32.mod(addr, 768), 8n), EM.j2(addr))
      @unfold B.u32.pick
      @simp -Q.SP.cput -Y.BP.put -U32.add -U32.and -U32.mod -U32.shrn
      {==}
    case False{}:
      @unfold EM.efin
      @rwx ec : {Bool.and(U32.is_ge(b5, 128), U32.is_eq(sm, addr)) == False{} : Bool}
      @unfold EM.eput EM.am EM.avv EM.awr EM.alen
      @rw V.U.N_lt(m5, 6, P.Nat.le_lt_succ(V.U.N(m5), 5n, hm))
      @unfold B.u32.pick
      @simp -Q.SP.cput -S.S.puts -R.VI.var -U32.add -B.B.var.len
      {==}

law EM.efin_av.c:
  for +addr: U32
  for +here: U32
  for +ta: A.Tr
  for +al: U32
  for +slot: U32
  for +tc: A.Tr
  for +b5: U32
  for +m5: U32
  for +hav: {EM.av(N.EB{b5, m5}, here, tc, addr) == True{} : Bool}
  for +c: Bool
  for +ec: {Bool.and(U32.is_ge(b5, 128), U32.is_eq(A.T.word(tc, U32.mod(addr, 768)), addr)) == c : Bool}
  {EM.av8(EM.am(EM.efin(addr, A.T.word(tc, U32.mod(addr, 768)), ta, al, slot, tc, N.EB{b5, m5})), EM.avv(EM.efin(addr, A.T.word(tc, U32.mod(addr, 768)), ta, al, slot, tc, N.EB{b5, m5})), here, tc, addr) == True{} : Bool}

def EM.efin_av.c(addr, here, ta, al, slot, tc, b5, m5, hav, c, ec):
  match c:
    case True{}:
      @unfold EM.efin
      @rwx ec : {Bool.and(U32.is_ge(b5, 128), U32.is_eq(A.T.word(tc, U32.mod(addr, 768)), addr)) == True{} : Bool}
      @unfold EM.eput EM.am EM.avv
      @simp -EM.av8 -U32.add -U32.and -U32.mod -U32.shrn
      EM.av_same(addr, here, tc, P.Bool.and_r(U32.is_ge(b5, 128), U32.is_eq(A.T.word(tc, U32.mod(addr, 768)), addr), ec))
    case False{}:
      @unfold EM.efin
      @rwx ec : {Bool.and(U32.is_ge(b5, 128), U32.is_eq(A.T.word(tc, U32.mod(addr, 768)), addr)) == False{} : Bool}
      @unfold EM.eput EM.am EM.avv
      @simp -EM.av8 -EM.av
      @unfold EM.av8
      @simp -EM.av -Q.SP.daddr -Q.SP.aok
      EM.and2(U32.is_eq(Q.SP.daddr(m5, b5, here, tc), addr), Bool.and(Q.SP.aok(m5, b5, here), Cmp.is_le(Nat.cmp(V.U.N(m5), 8n))),
        P.Bool.and_l(U32.is_eq(Q.SP.daddr(m5, b5, here, tc), addr), Bool.and(Q.SP.aok(m5, b5, here), Cmp.is_le(Nat.cmp(V.U.N(m5), 5n))), hav),
        EM.and2(Q.SP.aok(m5, b5, here), Cmp.is_le(Nat.cmp(V.U.N(m5), 8n)),
          P.Bool.and_l(Q.SP.aok(m5, b5, here), Cmp.is_le(Nat.cmp(V.U.N(m5), 5n)), P.Bool.and_r(U32.is_eq(Q.SP.daddr(m5, b5, here, tc), addr), Bool.and(Q.SP.aok(m5, b5, here), Cmp.is_le(Nat.cmp(V.U.N(m5), 5n))), hav)),
          P.Nat.le_trans(V.U.N(m5), 5n, 8n, P.Bool.and_r(Q.SP.aok(m5, b5, here), Cmp.is_le(Nat.cmp(V.U.N(m5), 5n)), P.Bool.and_r(U32.is_eq(Q.SP.daddr(m5, b5, here, tc), addr), Bool.and(Q.SP.aok(m5, b5, here), Cmp.is_le(Nat.cmp(V.U.N(m5), 5n))), hav)), {==})))

law EM.ea_w.e:
  for +addr: U32
  for +here: U32
  for +ta: A.Tr
  for +al: U32
  for +slot: U32
  for +tc: A.Tr
  for +e: N.EB
  for +hav: {EM.av(e, here, tc, addr) == True{} : Bool}
  {EM.efin(addr, A.T.word(tc, U32.mod(addr, 768)), ta, al, slot, tc, e) == EM.awr(addr, ta, al, slot, tc, EM.am(EM.efin(addr, A.T.word(tc, U32.mod(addr, 768)), ta, al, slot, tc, e)), EM.avv(EM.efin(addr, A.T.word(tc, U32.mod(addr, 768)), ta, al, slot, tc, e))) : AT}

def EM.ea_w.e(addr, here, ta, al, slot, tc, e, hav):
  match e:
    case N.EB{b5, m5}:
      EM.efin_w.c(addr, A.T.word(tc, U32.mod(addr, 768)), ta, al, slot, tc, b5, m5,
        P.Bool.and_r(Q.SP.aok(m5, b5, here), Cmp.is_le(Nat.cmp(V.U.N(m5), 5n)), P.Bool.and_r(U32.is_eq(Q.SP.daddr(m5, b5, here, tc), addr), Bool.and(Q.SP.aok(m5, b5, here), Cmp.is_le(Nat.cmp(V.U.N(m5), 5n))), hav)),
        Bool.and(U32.is_ge(b5, 128), U32.is_eq(A.T.word(tc, U32.mod(addr, 768)), addr)), {==})

law EM.ea_av.e:
  for +addr: U32
  for +here: U32
  for +ta: A.Tr
  for +al: U32
  for +slot: U32
  for +tc: A.Tr
  for +e: N.EB
  for +hav: {EM.av(e, here, tc, addr) == True{} : Bool}
  {EM.av8(EM.am(EM.efin(addr, A.T.word(tc, U32.mod(addr, 768)), ta, al, slot, tc, e)), EM.avv(EM.efin(addr, A.T.word(tc, U32.mod(addr, 768)), ta, al, slot, tc, e)), here, tc, addr) == True{} : Bool}

def EM.ea_av.e(addr, here, ta, al, slot, tc, e, hav):
  match e:
    case N.EB{b5, m5}:
      EM.efin_av.c(addr, here, ta, al, slot, tc, b5, m5, hav, Bool.and(U32.is_ge(b5, 128), U32.is_eq(A.T.word(tc, U32.mod(addr, 768)), addr)), {==})

# The address of a COPY from addr, at most here, is written as some mode
# and value...
law EM.ea_w:
  for +addr: U32
  for +here: U32
  for +ta: A.Tr
  for +al: U32
  for +slot: U32
  for +tc: A.Tr
  for +hle: {U32.is_le(addr, here) == True{} : Bool}
  {EM.ea(addr, here, ta, al, slot, tc) == EM.awr(addr, ta, al, slot, tc, EM.am(EM.ea(addr, here, ta, al, slot, tc)), EM.avv(EM.ea(addr, here, ta, al, slot, tc))) : AT}

def EM.ea_w(addr, here, ta, al, slot, tc, hle):
  @unfold EM.ea
  EM.ea_w.e(addr, here, ta, al, slot, tc, EM.eb(addr, here, tc), EM.av_eb(addr, here, tc, hle))

# ... that decode back to addr.
law EM.ea_av:
  for +addr: U32
  for +here: U32
  for +ta: A.Tr
  for +al: U32
  for +slot: U32
  for +tc: A.Tr
  for +hle: {U32.is_le(addr, here) == True{} : Bool}
  {EM.av8(EM.am(EM.ea(addr, here, ta, al, slot, tc)), EM.avv(EM.ea(addr, here, ta, al, slot, tc)), here, tc, addr) == True{} : Bool}

def EM.ea_av(addr, here, ta, al, slot, tc, hle):
  @unfold EM.ea
  EM.ea_av.e(addr, here, ta, al, slot, tc, EM.eb(addr, here, tc), EM.av_eb(addr, here, tc, hle))

law EM.copy.hi:
  for +td: A.Tr
  for +ti: A.Tr
  for +ta: A.Tr
  for +tc: A.Tr
  for +dl: U32
  for +il: U32
  for +al: U32
  for +slot: U32
  for +uoff: U32
  for +pt: U32
  for +ps: U32
  for +pm: U32
  for +pc: U32
  for +ops: List<&2, Q.OP>
  for +ph: Q.HF
  for +dd: Nat
  for +di: Nat
  for +da: Nat
  for +ts: A.Tr
  for +tt: A.Tr
  for +seg: U32
  for +cpl: U32
  for +w0: U32
  for +w1: U32
  for +E: U32
  for +Es: U32
  for +BIG: U32
  for +size: U32
  for +addr: U32
  for +m: U32
  for +v: U32
  for +hinv: {EM.inv(ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}, EG{ops, ph, dd, di, da}, EW{Q.XC{ts, tt, seg, cpl, w0, w1}, E, Es, A.A.to(D.ct.table()), BIG}) == True{} : Bool}
  for +hwok: {EM.wok(EW{Q.XC{ts, tt, seg, cpl, w0, w1}, E, Es, A.A.to(D.ct.table()), BIG}) == True{} : Bool}
  for +hc: {tc == Q.SP.sc(Q.SP.run(EM.hs(ops, ph), Q.XC{ts, tt, seg, cpl, w0, w1}, Q.SP.s0(w0))) : A.Tr}
  for +hlt: {U32.is_lt(addr, U32.add(cpl, U32.sub(uoff, w0))) == True{} : Bool}
  for +hcp: {Q.SP.cpok(Q.XC{ts, tt, seg, cpl, w0, w1}, uoff, size, addr) == True{} : Bool}
  for +hcb: {Q.SP.cbnd(Q.XC{ts, tt, seg, cpl, w0, w1}, uoff, size, addr, Es) == True{} : Bool}
  for +hsz: {Cmp.is_le(Nat.cmp(1n, V.U.N(size))) == True{} : Bool}
  for +hend: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(uoff), V.U.N(size)), V.U.N(w1))) == True{} : Bool}
  for +hav: {EM.av8(m, v, U32.add(cpl, U32.sub(uoff, w0)), tc, addr) == True{} : Bool}
  {U32.is_le(U32.add(uoff, size), w1) == True{} : Bool}

def EM.copy.hi(td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc, ops, ph, dd, di, da, ts, tt, seg, cpl, w0, w1, E, Es, BIG, size, addr, m, v, hinv, hwok, hc, hlt, hcp, hcb, hsz, hend, hav):
  V.U.N_le(U32.add(uoff, size), w1, (%Equal.sym(Nat, V.U.N(U32.add(uoff, size)), Nat.add(V.U.N(uoff), V.U.N(size)), V.U.add_N(uoff, size, w1, hend)) : {Cmp.is_le(Nat.cmp(_, V.U.N(w1))) == True{} : Bool}; hend))

