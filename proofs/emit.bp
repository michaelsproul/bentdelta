  @rwx EM.notT(Q.SP.z(Q.SP.e1(c)), hz1) : {Q.SP.z(Q.SP.e1(c)) == False{} : Bool}
  @rwx EM.notT(Q.SP.z(Q.SP.e2(c)), hz2) : {Q.SP.z(Q.SP.e2(c)) == False{} : Bool}
