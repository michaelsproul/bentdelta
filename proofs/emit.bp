law EM.dbl0:
  for +ps: U32
  for +pm: U32
  for +t: U32
  for +size: U32
  for +mode: U32
  {N.op.double(0, ps, pm, t, size, mode) == 0 : U32}

def EM.dbl0(ps, pm, t, size, mode):
  @unfold N.op.double N.u32.pick
  @simp
  @rw P.Bool.and_false(Bool.and(U32.is_eq(t, 1), U32.is_eq(size, 1)))
  @rw P.Bool.and_false(Bool.and(Bool.and(U32.is_eq(t, 3), U32.is_le(4, size)), U32.is_le(size, 18)))
  @simp
  {==}


