# The flush leaves the cache.
law WP.tc_flk:
  for +td: A.Tr
  for +ta: A.Tr
  for +tc: A.Tr
  for +dl: U32
  for +al: U32
  for +slot: U32
  for +uoff: U32
  for +r: EM_.TI
