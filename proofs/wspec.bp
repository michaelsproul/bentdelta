# match.
def WP.bok(+t: A.Tr) -> Bool:
  Bool.and(A.T.pf(SC_.SC.dep(t), t), Bool.and(Cmp.is_lt(Nat.cmp(SC_.SC.dep(t), 32n)), Cmp.is_le(Nat.cmp(3n, P.Nat.pow2(SC_.SC.dep(t))))))

