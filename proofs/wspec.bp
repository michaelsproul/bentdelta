  for +e: EM_.ET
  for +g: EM_.EG
  for +w: EM_.EW
  for +h: {EM_.EM.inv(e, g, w) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(6n, EM_.EM.cap(WP.gdi(g)))) == True{} : Bool}

