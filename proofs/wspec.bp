law WP.pf_map:
  for +k: Nat
  for +i: U32
  for +slen: U32
  for +lo: U32
  for +cpl: U32
  for +t: A.Tr
  for +d: Nat
  for +hp: {A.T.pf(d, t) == True{} : Bool}
  {A.T.pf(d, SG_.SG.map(k, i, slen, lo, cpl, t)) == True{} : Bool}

def WP.pf_map(k, i, slen, lo, cpl, t, d, hp):
