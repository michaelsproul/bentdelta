      hp
    case 1n+q:
      WP.pf_map(q, U32.add(i, 1), slen, lo, cpl, SG_.SG.mput(slen, lo, cpl, i, SE_.SE.ent(t, i), t), d, SG_.SG.pf_mput(slen, lo, cpl, i, SE_.SE.ent(t, i), t, d, hp))

