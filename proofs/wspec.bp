lves(ops)), ta, 0), Q.SP.lenis(Q.SP.adrl(Q.SP.halves(ops)), al))), hs))), P.Bool.and_l(S.S.has(Q.SP.adrl(Q.SP.halves(ops)), ta, 0), Q.SP.lenis(Q.SP.adrl(Q.SP.halves(ops)), al), P.Bool.and_r(Bool.and(S.S.has(Q.SP.insl(ops), ti, 0), Q.SP.lenis(Q.SP.insl(ops), il)), Bool.and(S.S.has(Q.SP.adrl(Q.SP.halves(ops)), ta, 0), Q.SP.lenis(Q.SP.adrl(Q.SP.halves(ops)), al)), P.Bool.and_r(Bool.and(S.S.has(Q.SP.datl(Q.SP.halves(ops)), td, 0), Q.SP.lenis(Q.SP.datl(Q.SP.halves(ops)), dl)), Bool.and(Bool.and(S.S.has(Q.SP.insl(ops), ti, 0), Q.SP.lenis(Q.SP.insl(ops), il)), Bool.and(S.S.has(Q.SP.adrl(Q.SP.halves(ops)), ta, 0), Q.SP.lenis(Q.SP.adrl(Q.SP.halves(ops)), al))), hs))), P.Bool.and_r(S.S.has(Q.SP.adrl(Q.SP.halves(ops)), ta, 0), Q.SP.lenis(Q.SP.adrl(Q.SP.halves(ops)), al), P.Bool.and_r(Bool.and(S.S.has(Q.SP.insl(ops), ti, 0), Q.SP.lenis(Q.SP.insl(ops), il)), Bool.and(S.S.has(Q.SP.adrl(Q.SP.halves(ops)), ta, 0), Q.SP.lenis(Q.SP.adrl(Q.SP.halves(ops)), al)), P.Bool.and_r(Bool.and(S.S.has(Q.SP.datl(Q.SP.halves(ops)), td, 0), Q.SP.lenis(Q.SP.datl(Q.SP.halves(ops)), dl)), Bool.and(Bool.and(S.S.has(Q.SP.insl(ops), ti, 0), Q.SP.lenis(Q.SP.insl(ops), il)), Bool.and(S.S.has(Q.SP.adrl(Q.SP.halves(ops)), ta, 0), Q.SP.lenis(Q.SP.adrl(Q.SP.halves(ops)), al))), hs))), hb, hEo)

# ... as long as where win.write leaves the output.
law WP.wlen:
  for +to: A.Tr
  for +od: Nat
  for +OUT: List<&2, U32>
  for +olen: U32
  for +tt: A.Tr
  for +w0: U32
  for +tlen: U32
  for +cpl: U32
  for +off: U32
  for +e: EM_.ET
  for +g: EM_.EG
  for +Eo: U32
  for +hpf: {A.T.pf(od, to) == True{} : Bool}
  for +hod: {Nat.cmp(od, 32n) == LT{} : Cmp}
  for +hO: {S.S.has(OUT, to, 0) == True{} : Bool}
  for +hOl: {S.S.len(OUT) == V.U.N(olen) : Nat}
  for +hs: {WP.secs(e, g) == True{} : Bool}
  for +hb: {WS_.WS.hbv(olen, tt, w0, tlen, cpl, off, e, Eo) == True{} : Bool}
  for +hEo: {U32.is_lt(Eo, 2147483648) == True{} : Bool}
  {S.S.len(K.WD.app(OUT, Q.SP.wb(WP.aw(cpl, off, tlen, tt, w0, e, g)))) == V.U.N(WS_.WS.wol(olen, tt, w0, tlen, cpl, off, e)) : Nat}

def WP.wlen(to, od, OUT, olen, tt, w0, tlen, cpl, off, e, g, Eo, hpf, hod, hO, hOl, hs, hb, hEo):
  match e g:
    case EM_.ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc} EM_.EG{ops, ph, dd, di, da}:
      @goal {S.S.len(K.WD.app(OUT, Q.SP.wb(Q.AW{cpl, off, tlen, dl, il, al, ops, H.AD.T(tt, w0, tlen)}))) == V.U.N(WS_.WS.wol(olen, tt, w0, tlen, cpl, off, EM_.ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc})) : Nat}
      @rw K.WD.len_app(OUT, Q.SP.wb(Q.AW{cpl, off, tlen, dl, il, al, ops, H.AD.T(tt, w0, tlen)}))
      @rwx hOl : {S.S.len(OUT) == V.U.N(olen) : Nat}
