# A window's facts
# ================
#
# The window win.enc writes: its bytes appended to the output, and what
# makes it a window the decoder rebuilds the target with (SP.wok).
#
# Source: proofs/wspec.bp (tools/bpp.py writes proofs/wspec.bend from it).

law WP.cmpeq:
  for +c: Cmp
  for +h: {Cmp.is_eq(c) == True{} : Bool}
  {c == EQ{} : Cmp}

def WP.cmpeq(c, h):
  match c:
    case LT{}:
      P.Bool.false_true({LT{} == EQ{} : Cmp}, h)
    case EQ{}:
      {==}
    case GT{}:
      P.Bool.false_true({GT{} == EQ{} : Cmp}, h)

law WP.lenis:
  for +xs: List<&2, U32>
  for +n: U32
  for +h: {Q.SP.lenis(xs, n) == True{} : Bool}
  {S.S.len(xs) == V.U.N(n) : Nat}

def WP.lenis(xs, n, h):
  P.Nat.cmp_eq(S.S.len(xs), V.U.N(n), WP.cmpeq(Nat.cmp(S.S.len(xs), V.U.N(n)), h))

law WP.segb.go:
  for +cpl: U32
  for +off: U32
  for +z: Bool
  for +ez: {U32.is_lt(0, cpl) == z : Bool}
  {Bool.pick(List<&2, U32>, z, K.WD.app(R.VI.var(cpl), R.VI.var(off)), []) == WW_.WW.sb(z, cpl, off) : List<&2, U32>}

def WP.segb.go(cpl, off, z, ez):
  match z:
    case True{}:
      {==}
    case False{}:
      {==}

law WP.segb:
  for +cpl: U32
  for +off: U32
  {Q.SP.segb(cpl, off) == WW_.WW.sb(U32.is_lt(0, cpl), cpl, off) : List<&2, U32>}

def WP.segb(cpl, off):
  WP.segb.go(cpl, off, U32.is_lt(0, cpl), {==})

law WP.len_app2:
  for +H: List<&2, U32>
  for +X: List<&2, U32>
  for +Y: List<&2, U32>
  for +h: {S.S.len(X) == S.S.len(Y) : Nat}
  {S.S.len(K.WD.app(H, X)) == S.S.len(K.WD.app(H, Y)) : Nat}

def WP.len_app2(H, X, Y, h):
  @rw K.WD.len_app(H, X)
  @rw K.WD.len_app(H, Y)
  @rwx h : {S.S.len(X) == S.S.len(Y) : Nat}
  {==}

# The window's bytes are as long as what win.write writes.
law WP.wblen:
  for +tlen: U32
  for +cpl: U32
  for +off: U32
  for +td: A.Tr
  for +ti: A.Tr
  for +ta: A.Tr
  for +dl: U32
  for +il: U32
  for +al: U32
  for +ops: List<&2, Q.OP>
  for +sum: U32
  for +l1: {Q.SP.lenis(Q.SP.datl(Q.SP.halves(ops)), dl) == True{} : Bool}
  for +l2: {Q.SP.lenis(Q.SP.insl(ops), il) == True{} : Bool}
  for +l3: {Q.SP.lenis(Q.SP.adrl(Q.SP.halves(ops)), al) == True{} : Bool}
  {S.S.len(Q.SP.wb(Q.AW{cpl, off, tlen, dl, il, al, ops, sum})) == S.S.len(K.WD.app(K.WD.app(N.u32.pick(U32.is_lt(0, cpl), 5, 4) <> [], K.WD.app(WW_.WW.sb(U32.is_lt(0, cpl), cpl, off), K.WD.app(R.VI.var(U32.add(U32.add(U32.add(U32.add(U32.add(U32.add(U32.add(U32.add(1, B.B.var.len(tlen)), B.B.var.len(dl)), B.B.var.len(il)), B.B.var.len(al)), 4), dl), il), al)), K.WD.app(R.VI.var(tlen), K.WD.app(0 <> [], K.WD.app(R.VI.var(dl), K.WD.app(R.VI.var(il), K.WD.app(R.VI.var(al), K.WD.app(U32.shrn(sum, 24n) <> [], K.WD.app(U32.and(U32.shrn(sum, 16n), 255) <> [], K.WD.app(U32.and(U32.shrn(sum, 8n), 255) <> [], U32.and(sum, 255) <> []))))))))))), K.WD.app(S.S.sl(V.U.N(dl), td, 0), K.WD.app(S.S.sl(V.U.N(il), ti, 0), S.S.sl(V.U.N(al), ta, 0))))) : Nat}

def WP.wblen(tlen, cpl, off, td, ti, ta, dl, il, al, ops, sum, l1, l2, l3):
  @rw WW_.WW.wb_eq(tlen, cpl, off, dl, il, al, ops, sum)
  @rw WP.segb(cpl, off)
  WP.len_app2(K.WD.app(N.u32.pick(U32.is_lt(0, cpl), 5, 4) <> [], K.WD.app(WW_.WW.sb(U32.is_lt(0, cpl), cpl, off), K.WD.app(R.VI.var(U32.add(U32.add(U32.add(U32.add(U32.add(U32.add(U32.add(U32.add(1, B.B.var.len(tlen)), B.B.var.len(dl)), B.B.var.len(il)), B.B.var.len(al)), 4), dl), il), al)), K.WD.app(R.VI.var(tlen), K.WD.app(0 <> [], K.WD.app(R.VI.var(dl), K.WD.app(R.VI.var(il), K.WD.app(R.VI.var(al), K.WD.app(U32.shrn(sum, 24n) <> [], K.WD.app(U32.and(U32.shrn(sum, 16n), 255) <> [], K.WD.app(U32.and(U32.shrn(sum, 8n), 255) <> [], U32.and(sum, 255) <> []))))))))))), K.WD.app(Q.SP.datl(Q.SP.halves(ops)), K.WD.app(Q.SP.insl(ops), Q.SP.adrl(Q.SP.halves(ops)))), K.WD.app(S.S.sl(V.U.N(dl), td, 0), K.WD.app(S.S.sl(V.U.N(il), ti, 0), S.S.sl(V.U.N(al), ta, 0))), WP.len3(dl, il, al, td, ti, ta, ops, l1, l2, l3))

law WP.len3:
  for +dl: U32
  for +il: U32
  for +al: U32
  for +td: A.Tr
  for +ti: A.Tr
  for +ta: A.Tr
  for +ops: List<&2, Q.OP>
  for +l1: {Q.SP.lenis(Q.SP.datl(Q.SP.halves(ops)), dl) == True{} : Bool}
  for +l2: {Q.SP.lenis(Q.SP.insl(ops), il) == True{} : Bool}
  for +l3: {Q.SP.lenis(Q.SP.adrl(Q.SP.halves(ops)), al) == True{} : Bool}
  {S.S.len(K.WD.app(Q.SP.datl(Q.SP.halves(ops)), K.WD.app(Q.SP.insl(ops), Q.SP.adrl(Q.SP.halves(ops))))) == S.S.len(K.WD.app(S.S.sl(V.U.N(dl), td, 0), K.WD.app(S.S.sl(V.U.N(il), ti, 0), S.S.sl(V.U.N(al), ta, 0)))) : Nat}

def WP.len3(dl, il, al, td, ti, ta, ops, l1, l2, l3):
  @rw K.WD.len_app(Q.SP.datl(Q.SP.halves(ops)), K.WD.app(Q.SP.insl(ops), Q.SP.adrl(Q.SP.halves(ops))))
  @rw K.WD.len_app(Q.SP.insl(ops), Q.SP.adrl(Q.SP.halves(ops)))
  @rw K.WD.len_app(S.S.sl(V.U.N(dl), td, 0), K.WD.app(S.S.sl(V.U.N(il), ti, 0), S.S.sl(V.U.N(al), ta, 0)))
  @rw K.WD.len_app(S.S.sl(V.U.N(il), ti, 0), S.S.sl(V.U.N(al), ta, 0))
  @rw WP.lenis(Q.SP.datl(Q.SP.halves(ops)), dl, l1)
  @rw WP.lenis(Q.SP.insl(ops), il, l2)
  @rw WP.lenis(Q.SP.adrl(Q.SP.halves(ops)), al, l3)
  @rw S.S.len_sl(V.U.N(dl), td, 0)
  @rw S.S.len_sl(V.U.N(il), ti, 0)
  @rw S.S.len_sl(V.U.N(al), ta, 0)
  {==}

# The window
# ----------

# A window, from the emitter's state and ghost at its end.
def WP.aw(+cpl: U32, +off: U32, +tlen: U32, +tt: A.Tr, +w0: U32, +e: EM_.ET, +g: EM_.EG) -> Q.AW:
  match e g:
    case EM_.ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc} EM_.EG{ops, ph, dd, di, da}:
      Q.AW{cpl, off, tlen, dl, il, al, ops, H.AD.T(tt, w0, tlen)}

# The emitter's sections hold the window's sections.
def WP.secs(+e: EM_.ET, +g: EM_.EG) -> Bool:
  match e g:
    case EM_.ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc} EM_.EG{ops, ph, dd, di, da}:
      Bool.and(Bool.and(S.S.has(Q.SP.datl(Q.SP.halves(ops)), td, 0), Q.SP.lenis(Q.SP.datl(Q.SP.halves(ops)), dl)), Bool.and(Bool.and(S.S.has(Q.SP.insl(ops), ti, 0), Q.SP.lenis(Q.SP.insl(ops), il)), Bool.and(S.S.has(Q.SP.adrl(Q.SP.halves(ops)), ta, 0), Q.SP.lenis(Q.SP.adrl(Q.SP.halves(ops)), al))))

# win.write appends the window's bytes.
law WP.wout:
  for +to: A.Tr
  for +od: Nat
  for +OUT: List<&2, U32>
  for +olen: U32
  for +tt: A.Tr
  for +w0: U32
  for +tlen: U32
  for +cpl: U32
  for +off: U32
  for +e: EM_.ET
  for +g: EM_.EG
  for +Eo: U32
  for +hpf: {A.T.pf(od, to) == True{} : Bool}
  for +hod: {Nat.cmp(od, 32n) == LT{} : Cmp}
  for +hO: {S.S.has(OUT, to, 0) == True{} : Bool}
  for +hOl: {S.S.len(OUT) == V.U.N(olen) : Nat}
  for +hs: {WP.secs(e, g) == True{} : Bool}
  for +hb: {WS_.WS.hbv(olen, tt, w0, tlen, cpl, off, e, Eo) == True{} : Bool}
  for +hEo: {U32.is_lt(Eo, 2147483648) == True{} : Bool}
  {S.S.has(K.WD.app(OUT, Q.SP.wb(WP.aw(cpl, off, tlen, tt, w0, e, g))), WS_.WS.wto(to, olen, tt, w0, tlen, cpl, off, e), 0) == True{} : Bool}

def WP.wout(to, od, OUT, olen, tt, w0, tlen, cpl, off, e, g, Eo, hpf, hod, hO, hOl, hs, hb, hEo):
  match e g:
    case EM_.ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc} EM_.EG{ops, ph, dd, di, da}:
