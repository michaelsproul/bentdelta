  for +ts: A.Tr
  for +tt: A.Tr
  for +st: SC_.ST
  for +S: U32
  for +hI: {SC_.SC.Is(WS_.WS.sk(E, w0, w1), ts, tt, 0n, st) == True{} : Bool}
  for +hS: {U32.is_le(WS_.WS.slen(E), S) == True{} : Bool}
  {Bool.or(Bool.not(U32.is_lt(0, WS_.WS.cc(E, st))), Bool.and(U32.is_le(WS_.WS.cc(E, st), S), U32.is_le(WS_.WS.co(E, st), U32.sub(S, WS_.WS.cc(E, st))))) == True{} : Bool}

def WP.awwin(E, w0, w1, ts, tt, st, S, hI, hS):
  match E st:
    case N.EK{slen, tlen, wsz, blk, lsh, lmask, ssh, smask, cap} SC_.ST{tl, tb, tv, tio, p, mm, rc, rl, lck, last, nio, cont}:
      SG_.SG.choose_aw(True{}, ts, tt, slen, w0, w1, nio, tio, S, hS, SC_.SC.Iv.ok(ts, tt, slen, w0, w1, 0n, tio, p, mm, nio, hI))

# The next window's emitter
# -------------------------

def WP.gdi(+g: EM_.EG) -> Nat:
  match g:
    case EM_.EG{ops, ph, dd, di, da}:
      di

law WP.gqs_di:
  for +sg: Bool
  for +ops: List<&2, Q.OP>
  for +ph: Q.HF
  for +h: Q.HF
  for +pc: U32
  for +dd: Nat
  for +di: Nat
  for +da: Nat
  {WP.gdi(EM_.EM.gqs(sg, ops, ph, h, pc, dd, di, da)) == di : Nat}

def WP.gqs_di(sg, ops, ph, h, pc, dd, di, da):
  match sg:
    case True{}:
      {==}
    case False{}:
      {==}

# The flush keeps the instruction section's depth.
law WP.gfl_di:
  for +e: EM_.ET
  for +g: EM_.EG
  {WP.gdi(EI_.EI.gfl(e, g)) == WP.gdi(g) : Nat}

def WP.gfl_di(e, g):
  match e g:
    case EM_.ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc} EM_.EG{ops, ph, dd, di, da}:
      WP.gqs_di(U32.is_ne(pt, 0), ops, ph, Q.HN{}, pc, dd, di, da)

