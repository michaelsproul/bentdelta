def WP.tc_flk(td, ta, tc, dl, al, slot, uoff, r):
  match r:
    case EM_.TI{ti, il}:
      {==}

law WP.tc_fl:
  for +e: EM_.ET
  {EM_.EM.tc(EM_.EM.fl(e)) == EM_.EM.tc(e) : A.Tr}

def WP.tc_fl(e):
  match e:
    case EM_.ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      WP.tc_flk(td, ta, tc, dl, al, slot, uoff, EM_.EM.sg(pt, ps, pc, ti, il))

