# The emitter after the write: its sections kept, its counts cleared.
def WS.ez(+e: EM_.ET) -> EM_.ET:
  match e:
    case EM_.ET{td, ti, ta, tc, dl, il, al, slot, uoff, pt, ps, pm, pc}:
      EM_.ET{td, ti, ta, tc, 0, 0, 0, 0, 0, 0, 0, 0, 0}

