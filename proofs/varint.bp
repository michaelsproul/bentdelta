import Base
import ../bytes.bend as B
import ./nat.bend as P
import ./word.bend as W
import ./u32.bend as V
import ./array.bend as A
import ./bytes.bend as Y
import ./seq.bend as S
import ./bits.bend as Z
import ./words.bend as D
import ./copy.bend as C

# Varints (bytes.bend): the bytes B.var.put writes, and B.var.get reading
# them back; single bytes and big-endian words likewise.
#
# Source: proofs/varint.bp (tools/bpp.py writes proofs/varint.bend from it).

# Reading held bytes
# ==================

# A read of a byte the tree holds.
law VI.rd:
  for +td: A.Tr
  for +q: U32
  for +x: U32
  for +rest: List<&2, U32>
  for +h: {S.S.has(x <> rest, td, q) == True{} : Bool}
  {B.B.get(A.A.from(td), q) == (A.A.from(td), U32.and(x, 255)) : Array<U32> & U32}

def VI.rd(td, q, x, rest, h):
  @rw Y.BP.get_from(td, q)
  @rw V.U.is_eq(Y.BP.byt(td, q), U32.and(x, 255), P.Bool.and_l(U32.is_eq(Y.BP.byt(td, q), U32.and(x, 255)), S.S.has(rest, td, U32.add(q, 1)), h))
  {==}

# The rest of a list held.
law VI.tl:
  for +td: A.Tr
  for +q: U32
  for +x: U32
  for +rest: List<&2, U32>
  for +h: {S.S.has(x <> rest, td, q) == True{} : Bool}
  {S.S.has(rest, td, U32.add(q, 1)) == True{} : Bool}

def VI.tl(td, q, x, rest, h):
  P.Bool.and_r(U32.is_eq(Y.BP.byt(td, q), U32.and(x, 255)), S.S.has(rest, td, U32.add(q, 1)), h)

# A position j steps on, below a bound.
law VI.pos:
  for +s: U32
  for +E: U32
  for +j: Nat
  for +h: {Nat.cmp(Nat.add(j, V.U.N(s)), V.U.N(E)) == LT{} : Cmp}
  {V.U.N(D.WD.step(j, s)) == Nat.add(j, V.U.N(s)) : Nat}

def VI.pos(s, E, j, h):
  match j:
    case 0n:
      {==}
    case 1n+q:
      @simp
      @rw V.U.succ_N(D.WD.step(q, s), E, (%Equal.sym(Nat, V.U.N(D.WD.step(q, s)), Nat.add(q, V.U.N(s)), VI.pos(s, E, q, P.Nat.lt_succ_l(Nat.add(q, V.U.N(s)), V.U.N(E), h))) : {Nat.cmp(_, V.U.N(E)) == LT{} : Cmp}; P.Nat.lt_succ_l(Nat.add(q, V.U.N(s)), V.U.N(E), h)))
      @rw VI.pos(s, E, q, P.Nat.lt_succ_l(Nat.add(q, V.U.N(s)), V.U.N(E), h))
      {==}

law VI.pos_lt:
  for +s: U32
  for +E: U32
  for +j: Nat
  for +h: {Nat.cmp(Nat.add(j, V.U.N(s)), V.U.N(E)) == LT{} : Cmp}
  {U32.is_lt(D.WD.step(j, s), E) == True{} : Bool}

def VI.pos_lt(s, E, j, h):
  V.U.N_lt(D.WD.step(j, s), E, (%Equal.sym(Nat, V.U.N(D.WD.step(j, s)), Nat.add(j, V.U.N(s)), VI.pos(s, E, j, h)) : {Nat.cmp(_, V.U.N(E)) == LT{} : Cmp}; h))


# Varints
# =======

# The k low 7-bit groups of v, most significant first, as B.var.put writes
# them.
def VI.go(+k: Nat, +v: U32) -> List<&2, U32>:
  match k:
    case 0n:
      []
    case 1n+p:
      U32.or(B.B.var.flag(p), U32.and(127, U32.shrn(v, Nat.mul(7n, p)))) <> VI.go(p, v)

def VI.var(+v: U32) -> List<&2, U32>:
  VI.go(U32.to_nat(B.B.var.len(v)), v)

law VI.put_go:
  for +k: Nat
  for +t: A.Tr
  for +pos: U32
  for +v: U32
  {B.B.var.put.go(k, A.A.from(t), pos, v) == A.A.from(S.S.puts(VI.go(k, v), t, pos)) : Array<U32>}

def VI.put_go(k, t, pos, v):
  match k:
    case 0n:
      {==}
    case 1n+p:
      @simp
      @rw Y.BP.put_from(t, pos, U32.or(B.B.var.flag(p), U32.and(127, U32.shrn(v, Nat.mul(7n, p)))))
      @rw VI.put_go(p, Y.BP.put(t, pos, U32.or(B.B.var.flag(p), U32.and(127, U32.shrn(v, Nat.mul(7n, p))))), U32.add(pos, 1), v)
      {==}

# B.var.put writes the bytes of the varint and answers the position after.
law VI.put:
  for +t: A.Tr
  for +pos: U32
  for +v: U32
  {B.B.var.put(A.A.from(t), pos, v) == (A.A.from(S.S.puts(VI.var(v), t, pos)), U32.add(pos, B.B.var.len(v))) : Array<U32> & U32}

def VI.put(t, pos, v):
  @unfold B.B.var.put VI.var
  @rw VI.put_go(U32.to_nat(B.B.var.len(v)), t, pos, v)
  {==}

law VI.get1:
  for +td: A.Tr
  for +pos: U32
  for +end: U32
  for +v: U32
  for +rest: List<&2, U32>
  for +h: {S.S.has(D.WD.app(VI.go(1n, v), rest), td, pos) == True{} : Bool}
  for +hb: {Nat.cmp(Nat.add(0n, V.U.N(pos)), V.U.N(end)) == LT{} : Cmp}
  {B.B.var.get(A.A.from(td), pos, end) == B.VR{A.A.from(td), U32.and(v, 127), U32.add(pos, 1), True{}} : B.VR}

def VI.get1(td, pos, end, v, rest, h, hb):
  @unfold B.B.var.get
  @rw VI.rd(td, pos, U32.or(0, U32.and(127, U32.shrn(v, 0n))), rest, h)
  @unfold B.B.var.cont
  @simp
  @rw Z.BB.vf0(U32.shrn(v, 0n))
  @simp
  @rwx VI.pos_lt(pos, end, 0n, hb) : {U32.is_lt(pos, end) == True{} : Bool}
  @simp
  @rw Z.BB.v1(v)
  @simp
  {==}

law VI.get2:
  for +td: A.Tr
  for +pos: U32
  for +end: U32
  for +v: U32
  for +rest: List<&2, U32>
  for +h: {S.S.has(D.WD.app(VI.go(2n, v), rest), td, pos) == True{} : Bool}
  for +hb: {Nat.cmp(Nat.add(1n, V.U.N(pos)), V.U.N(end)) == LT{} : Cmp}
  {B.B.var.get(A.A.from(td), pos, end) == B.VR{A.A.from(td), U32.and(v, 16383), U32.add(U32.add(pos, 1), 1), True{}} : B.VR}

def VI.get2(td, pos, end, v, rest, h, hb):
  @unfold B.B.var.get
  @rw VI.rd(td, pos, U32.or(128, U32.and(127, U32.shrn(v, 7n))), U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, h)
  @unfold B.B.var.cont
  @simp
  @rw Z.BB.vf1(U32.shrn(v, 7n))
  @simp
  @rwx VI.pos_lt(pos, end, 0n, P.Nat.lt_succ_l(Nat.add(0n, V.U.N(pos)), V.U.N(end), hb)) : {U32.is_lt(pos, end) == True{} : Bool}
  @simp
  @rw Z.BB.v2f(v)
  @simp
  @rw VI.rd(td, U32.add(pos, 1), U32.or(0, U32.and(127, U32.shrn(v, 0n))), rest, VI.tl(td, pos, U32.or(128, U32.and(127, U32.shrn(v, 7n))), U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, h))
  @unfold B.B.var.cont
  @simp
  @rw Z.BB.vf0(U32.shrn(v, 0n))
  @simp
  @rw Z.BB.vfit2_1(v)
  @simp
  @rwx VI.pos_lt(pos, end, 1n, hb) : {U32.is_lt(U32.add(pos, 1), end) == True{} : Bool}
  @simp
  @rw Z.BB.v2l(v)
  @simp
  {==}

law VI.get3:
  for +td: A.Tr
  for +pos: U32
  for +end: U32
  for +v: U32
  for +rest: List<&2, U32>
  for +h: {S.S.has(D.WD.app(VI.go(3n, v), rest), td, pos) == True{} : Bool}
  for +hb: {Nat.cmp(Nat.add(2n, V.U.N(pos)), V.U.N(end)) == LT{} : Cmp}
  {B.B.var.get(A.A.from(td), pos, end) == B.VR{A.A.from(td), U32.and(v, 2097151), U32.add(U32.add(U32.add(pos, 1), 1), 1), True{}} : B.VR}

def VI.get3(td, pos, end, v, rest, h, hb):
  @unfold B.B.var.get
  @rw VI.rd(td, pos, U32.or(128, U32.and(127, U32.shrn(v, 14n))), U32.or(128, U32.and(127, U32.shrn(v, 7n))) <> U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, h)
  @unfold B.B.var.cont
  @simp
  @rw Z.BB.vf1(U32.shrn(v, 14n))
  @simp
  @rwx VI.pos_lt(pos, end, 0n, P.Nat.lt_succ_l(Nat.add(0n, V.U.N(pos)), V.U.N(end), P.Nat.lt_succ_l(Nat.add(1n, V.U.N(pos)), V.U.N(end), hb))) : {U32.is_lt(pos, end) == True{} : Bool}
  @simp
  @rw Z.BB.v3f(v)
  @simp
  @rw VI.rd(td, U32.add(pos, 1), U32.or(128, U32.and(127, U32.shrn(v, 7n))), U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, VI.tl(td, pos, U32.or(128, U32.and(127, U32.shrn(v, 14n))), U32.or(128, U32.and(127, U32.shrn(v, 7n))) <> U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, h))
  @unfold B.B.var.cont
  @simp
  @rw Z.BB.vf1(U32.shrn(v, 7n))
  @simp
  @rw Z.BB.vfit3_2(v)
  @simp
  @rwx VI.pos_lt(pos, end, 1n, P.Nat.lt_succ_l(Nat.add(1n, V.U.N(pos)), V.U.N(end), hb)) : {U32.is_lt(U32.add(pos, 1), end) == True{} : Bool}
  @simp
  @rw Z.BB.v3m1(v)
  @simp
  @rw VI.rd(td, U32.add(U32.add(pos, 1), 1), U32.or(0, U32.and(127, U32.shrn(v, 0n))), rest, VI.tl(td, U32.add(pos, 1), U32.or(128, U32.and(127, U32.shrn(v, 7n))), U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, VI.tl(td, pos, U32.or(128, U32.and(127, U32.shrn(v, 14n))), U32.or(128, U32.and(127, U32.shrn(v, 7n))) <> U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, h)))
  @unfold B.B.var.cont
  @simp
  @rw Z.BB.vf0(U32.shrn(v, 0n))
  @simp
  @rw Z.BB.vfit3_1(v)
  @simp
  @rwx VI.pos_lt(pos, end, 2n, hb) : {U32.is_lt(U32.add(U32.add(pos, 1), 1), end) == True{} : Bool}
  @simp
  @rw Z.BB.v3l(v)
  @simp
  {==}

law VI.get4:
  for +td: A.Tr
  for +pos: U32
  for +end: U32
  for +v: U32
  for +rest: List<&2, U32>
  for +h: {S.S.has(D.WD.app(VI.go(4n, v), rest), td, pos) == True{} : Bool}
  for +hb: {Nat.cmp(Nat.add(3n, V.U.N(pos)), V.U.N(end)) == LT{} : Cmp}
  {B.B.var.get(A.A.from(td), pos, end) == B.VR{A.A.from(td), U32.and(v, 268435455), U32.add(U32.add(U32.add(U32.add(pos, 1), 1), 1), 1), True{}} : B.VR}

def VI.get4(td, pos, end, v, rest, h, hb):
  @unfold B.B.var.get
  @rw VI.rd(td, pos, U32.or(128, U32.and(127, U32.shrn(v, 21n))), U32.or(128, U32.and(127, U32.shrn(v, 14n))) <> U32.or(128, U32.and(127, U32.shrn(v, 7n))) <> U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, h)
  @unfold B.B.var.cont
  @simp
  @rw Z.BB.vf1(U32.shrn(v, 21n))
  @simp
  @rwx VI.pos_lt(pos, end, 0n, P.Nat.lt_succ_l(Nat.add(0n, V.U.N(pos)), V.U.N(end), P.Nat.lt_succ_l(Nat.add(1n, V.U.N(pos)), V.U.N(end), P.Nat.lt_succ_l(Nat.add(2n, V.U.N(pos)), V.U.N(end), hb)))) : {U32.is_lt(pos, end) == True{} : Bool}
  @simp
  @rw Z.BB.v4f(v)
  @simp
  @rw VI.rd(td, U32.add(pos, 1), U32.or(128, U32.and(127, U32.shrn(v, 14n))), U32.or(128, U32.and(127, U32.shrn(v, 7n))) <> U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, VI.tl(td, pos, U32.or(128, U32.and(127, U32.shrn(v, 21n))), U32.or(128, U32.and(127, U32.shrn(v, 14n))) <> U32.or(128, U32.and(127, U32.shrn(v, 7n))) <> U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, h))
  @unfold B.B.var.cont
  @simp
  @rw Z.BB.vf1(U32.shrn(v, 14n))
  @simp
  @rw Z.BB.vfit4_3(v)
  @simp
  @rwx VI.pos_lt(pos, end, 1n, P.Nat.lt_succ_l(Nat.add(1n, V.U.N(pos)), V.U.N(end), P.Nat.lt_succ_l(Nat.add(2n, V.U.N(pos)), V.U.N(end), hb))) : {U32.is_lt(U32.add(pos, 1), end) == True{} : Bool}
  @simp
  @rw Z.BB.v4m2(v)
  @simp
  @rw VI.rd(td, U32.add(U32.add(pos, 1), 1), U32.or(128, U32.and(127, U32.shrn(v, 7n))), U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, VI.tl(td, U32.add(pos, 1), U32.or(128, U32.and(127, U32.shrn(v, 14n))), U32.or(128, U32.and(127, U32.shrn(v, 7n))) <> U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, VI.tl(td, pos, U32.or(128, U32.and(127, U32.shrn(v, 21n))), U32.or(128, U32.and(127, U32.shrn(v, 14n))) <> U32.or(128, U32.and(127, U32.shrn(v, 7n))) <> U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, h)))
  @unfold B.B.var.cont
  @simp
  @rw Z.BB.vf1(U32.shrn(v, 7n))
  @simp
  @rw Z.BB.vfit4_2(v)
  @simp
  @rwx VI.pos_lt(pos, end, 2n, P.Nat.lt_succ_l(Nat.add(2n, V.U.N(pos)), V.U.N(end), hb)) : {U32.is_lt(U32.add(U32.add(pos, 1), 1), end) == True{} : Bool}
  @simp
  @rw Z.BB.v4m1(v)
  @simp
  @rw VI.rd(td, U32.add(U32.add(U32.add(pos, 1), 1), 1), U32.or(0, U32.and(127, U32.shrn(v, 0n))), rest, VI.tl(td, U32.add(U32.add(pos, 1), 1), U32.or(128, U32.and(127, U32.shrn(v, 7n))), U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, VI.tl(td, U32.add(pos, 1), U32.or(128, U32.and(127, U32.shrn(v, 14n))), U32.or(128, U32.and(127, U32.shrn(v, 7n))) <> U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, VI.tl(td, pos, U32.or(128, U32.and(127, U32.shrn(v, 21n))), U32.or(128, U32.and(127, U32.shrn(v, 14n))) <> U32.or(128, U32.and(127, U32.shrn(v, 7n))) <> U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, h))))
  @unfold B.B.var.cont
  @simp
  @rw Z.BB.vf0(U32.shrn(v, 0n))
  @simp
  @rw Z.BB.vfit4_1(v)
  @simp
  @rwx VI.pos_lt(pos, end, 3n, hb) : {U32.is_lt(U32.add(U32.add(U32.add(pos, 1), 1), 1), end) == True{} : Bool}
  @simp
  @rw Z.BB.v4l(v)
  @simp
  {==}

law VI.get5:
  for +td: A.Tr
  for +pos: U32
  for +end: U32
  for +v: U32
  for +rest: List<&2, U32>
  for +h: {S.S.has(D.WD.app(VI.go(5n, v), rest), td, pos) == True{} : Bool}
  for +hb: {Nat.cmp(Nat.add(4n, V.U.N(pos)), V.U.N(end)) == LT{} : Cmp}
  {B.B.var.get(A.A.from(td), pos, end) == B.VR{A.A.from(td), v, U32.add(U32.add(U32.add(U32.add(U32.add(pos, 1), 1), 1), 1), 1), True{}} : B.VR}

def VI.get5(td, pos, end, v, rest, h, hb):
  @unfold B.B.var.get
  @rw VI.rd(td, pos, U32.or(128, U32.and(127, U32.shrn(v, 28n))), U32.or(128, U32.and(127, U32.shrn(v, 21n))) <> U32.or(128, U32.and(127, U32.shrn(v, 14n))) <> U32.or(128, U32.and(127, U32.shrn(v, 7n))) <> U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, h)
  @unfold B.B.var.cont
  @simp
  @rw Z.BB.vf1(U32.shrn(v, 28n))
  @simp
  @rwx VI.pos_lt(pos, end, 0n, P.Nat.lt_succ_l(Nat.add(0n, V.U.N(pos)), V.U.N(end), P.Nat.lt_succ_l(Nat.add(1n, V.U.N(pos)), V.U.N(end), P.Nat.lt_succ_l(Nat.add(2n, V.U.N(pos)), V.U.N(end), P.Nat.lt_succ_l(Nat.add(3n, V.U.N(pos)), V.U.N(end), hb))))) : {U32.is_lt(pos, end) == True{} : Bool}
  @simp
  @rw Z.BB.v5f(v)
  @simp
  @rw VI.rd(td, U32.add(pos, 1), U32.or(128, U32.and(127, U32.shrn(v, 21n))), U32.or(128, U32.and(127, U32.shrn(v, 14n))) <> U32.or(128, U32.and(127, U32.shrn(v, 7n))) <> U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, VI.tl(td, pos, U32.or(128, U32.and(127, U32.shrn(v, 28n))), U32.or(128, U32.and(127, U32.shrn(v, 21n))) <> U32.or(128, U32.and(127, U32.shrn(v, 14n))) <> U32.or(128, U32.and(127, U32.shrn(v, 7n))) <> U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, h))
  @unfold B.B.var.cont
  @simp
  @rw Z.BB.vf1(U32.shrn(v, 21n))
  @simp
  @rw Z.BB.vfit5_4(v)
  @simp
  @rwx VI.pos_lt(pos, end, 1n, P.Nat.lt_succ_l(Nat.add(1n, V.U.N(pos)), V.U.N(end), P.Nat.lt_succ_l(Nat.add(2n, V.U.N(pos)), V.U.N(end), P.Nat.lt_succ_l(Nat.add(3n, V.U.N(pos)), V.U.N(end), hb)))) : {U32.is_lt(U32.add(pos, 1), end) == True{} : Bool}
  @simp
  @rw Z.BB.v5m3(v)
  @simp
  @rw VI.rd(td, U32.add(U32.add(pos, 1), 1), U32.or(128, U32.and(127, U32.shrn(v, 14n))), U32.or(128, U32.and(127, U32.shrn(v, 7n))) <> U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, VI.tl(td, U32.add(pos, 1), U32.or(128, U32.and(127, U32.shrn(v, 21n))), U32.or(128, U32.and(127, U32.shrn(v, 14n))) <> U32.or(128, U32.and(127, U32.shrn(v, 7n))) <> U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, VI.tl(td, pos, U32.or(128, U32.and(127, U32.shrn(v, 28n))), U32.or(128, U32.and(127, U32.shrn(v, 21n))) <> U32.or(128, U32.and(127, U32.shrn(v, 14n))) <> U32.or(128, U32.and(127, U32.shrn(v, 7n))) <> U32.or(0, U32.and(127, U32.shrn(v, 0n))) <> rest, h)))
  @unfold B.B.var.cont
  @simp
  @rw Z.BB.vf1(U32.shrn(v, 14n))
  @simp
  @rw Z.BB.vfit5_3(v)
  @simp
  @rwx VI.pos_lt(pos, end, 2n, P.Nat.lt_succ_l(Nat.add(2n, V.U.N(pos)), V.U.N(end), P.Nat.lt_succ_l(Nat.add(3n, V.U.N(pos)), V.U.N(end), hb))) : {U32.is_lt(U32.add(U32.add(pos, 1), 1), end) == True{} : Bool}
  @simp
  @rw Z.BB.v5m2(v)
  @simp
