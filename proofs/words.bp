      @rw WD.at(U32.add(s, 1), U32.add(U32.shrn(s, 2n), 1), 0n, (%Equal.sym(Nat, V.U.N(U32.add(U32.shrn(s, 2n), 1)), 1n+V.U.N(U32.shrn(s, 2n)), V.U.succ_N(U32.shrn(s, 2n), E, WD.word_lt(s, E, 3n, (%eo0 : {V.U.N(s) == Nat.add(P.Nat.bit(_), Nat.double(Nat.add(P.Nat.bit(True{}), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} (%eo1 : {V.U.N(s) == Nat.add(P.Nat.bit(P.Nat.odd(V.U.N(s))), Nat.double(Nat.add(P.Nat.bit(_), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} WD.split4(s))), hb))) : {V.U.N(U32.add(s, 1)) == Nat.add(0n, Nat.double(Nat.double(_))) : Nat} WD.posg(s, E, 3n, Nat.double(Nat.double(V.U.N(U32.shrn(s, 2n)))), 1n, {==}, (%eo0 : {V.U.N(s) == Nat.add(P.Nat.bit(_), Nat.double(Nat.add(P.Nat.bit(True{}), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} (%eo1 : {V.U.N(s) == Nat.add(P.Nat.bit(P.Nat.odd(V.U.N(s))), Nat.double(Nat.add(P.Nat.bit(_), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} WD.split4(s))), hb)), {==})
      @rw WD.lane(U32.add(s, 1), U32.add(U32.shrn(s, 2n), 1), 0n, (%Equal.sym(Nat, V.U.N(U32.add(U32.shrn(s, 2n), 1)), 1n+V.U.N(U32.shrn(s, 2n)), V.U.succ_N(U32.shrn(s, 2n), E, WD.word_lt(s, E, 3n, (%eo0 : {V.U.N(s) == Nat.add(P.Nat.bit(_), Nat.double(Nat.add(P.Nat.bit(True{}), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} (%eo1 : {V.U.N(s) == Nat.add(P.Nat.bit(P.Nat.odd(V.U.N(s))), Nat.double(Nat.add(P.Nat.bit(_), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} WD.split4(s))), hb))) : {V.U.N(U32.add(s, 1)) == Nat.add(0n, Nat.double(Nat.double(_))) : Nat} WD.posg(s, E, 3n, Nat.double(Nat.double(V.U.N(U32.shrn(s, 2n)))), 1n, {==}, (%eo0 : {V.U.N(s) == Nat.add(P.Nat.bit(_), Nat.double(Nat.add(P.Nat.bit(True{}), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} (%eo1 : {V.U.N(s) == Nat.add(P.Nat.bit(P.Nat.odd(V.U.N(s))), Nat.double(Nat.add(P.Nat.bit(_), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} WD.split4(s))), hb)), {==})
      @rw WD.at(U32.add(U32.add(s, 1), 1), U32.add(U32.shrn(s, 2n), 1), 1n, (%Equal.sym(Nat, V.U.N(U32.add(U32.shrn(s, 2n), 1)), 1n+V.U.N(U32.shrn(s, 2n)), V.U.succ_N(U32.shrn(s, 2n), E, WD.word_lt(s, E, 3n, (%eo0 : {V.U.N(s) == Nat.add(P.Nat.bit(_), Nat.double(Nat.add(P.Nat.bit(True{}), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} (%eo1 : {V.U.N(s) == Nat.add(P.Nat.bit(P.Nat.odd(V.U.N(s))), Nat.double(Nat.add(P.Nat.bit(_), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} WD.split4(s))), hb))) : {V.U.N(U32.add(U32.add(s, 1), 1)) == Nat.add(1n, Nat.double(Nat.double(_))) : Nat} WD.posg(s, E, 3n, Nat.double(Nat.double(V.U.N(U32.shrn(s, 2n)))), 2n, {==}, (%eo0 : {V.U.N(s) == Nat.add(P.Nat.bit(_), Nat.double(Nat.add(P.Nat.bit(True{}), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} (%eo1 : {V.U.N(s) == Nat.add(P.Nat.bit(P.Nat.odd(V.U.N(s))), Nat.double(Nat.add(P.Nat.bit(_), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} WD.split4(s))), hb)), {==})
      @rw WD.lane(U32.add(U32.add(s, 1), 1), U32.add(U32.shrn(s, 2n), 1), 1n, (%Equal.sym(Nat, V.U.N(U32.add(U32.shrn(s, 2n), 1)), 1n+V.U.N(U32.shrn(s, 2n)), V.U.succ_N(U32.shrn(s, 2n), E, WD.word_lt(s, E, 3n, (%eo0 : {V.U.N(s) == Nat.add(P.Nat.bit(_), Nat.double(Nat.add(P.Nat.bit(True{}), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} (%eo1 : {V.U.N(s) == Nat.add(P.Nat.bit(P.Nat.odd(V.U.N(s))), Nat.double(Nat.add(P.Nat.bit(_), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} WD.split4(s))), hb))) : {V.U.N(U32.add(U32.add(s, 1), 1)) == Nat.add(1n, Nat.double(Nat.double(_))) : Nat} WD.posg(s, E, 3n, Nat.double(Nat.double(V.U.N(U32.shrn(s, 2n)))), 2n, {==}, (%eo0 : {V.U.N(s) == Nat.add(P.Nat.bit(_), Nat.double(Nat.add(P.Nat.bit(True{}), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} (%eo1 : {V.U.N(s) == Nat.add(P.Nat.bit(P.Nat.odd(V.U.N(s))), Nat.double(Nat.add(P.Nat.bit(_), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} WD.split4(s))), hb)), {==})
      @rw WD.at(U32.add(U32.add(U32.add(s, 1), 1), 1), U32.add(U32.shrn(s, 2n), 1), 2n, (%Equal.sym(Nat, V.U.N(U32.add(U32.shrn(s, 2n), 1)), 1n+V.U.N(U32.shrn(s, 2n)), V.U.succ_N(U32.shrn(s, 2n), E, WD.word_lt(s, E, 3n, (%eo0 : {V.U.N(s) == Nat.add(P.Nat.bit(_), Nat.double(Nat.add(P.Nat.bit(True{}), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} (%eo1 : {V.U.N(s) == Nat.add(P.Nat.bit(P.Nat.odd(V.U.N(s))), Nat.double(Nat.add(P.Nat.bit(_), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} WD.split4(s))), hb))) : {V.U.N(U32.add(U32.add(U32.add(s, 1), 1), 1)) == Nat.add(2n, Nat.double(Nat.double(_))) : Nat} WD.posg(s, E, 3n, Nat.double(Nat.double(V.U.N(U32.shrn(s, 2n)))), 3n, {==}, (%eo0 : {V.U.N(s) == Nat.add(P.Nat.bit(_), Nat.double(Nat.add(P.Nat.bit(True{}), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} (%eo1 : {V.U.N(s) == Nat.add(P.Nat.bit(P.Nat.odd(V.U.N(s))), Nat.double(Nat.add(P.Nat.bit(_), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} WD.split4(s))), hb)), {==})
      @rw WD.lane(U32.add(U32.add(U32.add(s, 1), 1), 1), U32.add(U32.shrn(s, 2n), 1), 2n, (%Equal.sym(Nat, V.U.N(U32.add(U32.shrn(s, 2n), 1)), 1n+V.U.N(U32.shrn(s, 2n)), V.U.succ_N(U32.shrn(s, 2n), E, WD.word_lt(s, E, 3n, (%eo0 : {V.U.N(s) == Nat.add(P.Nat.bit(_), Nat.double(Nat.add(P.Nat.bit(True{}), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} (%eo1 : {V.U.N(s) == Nat.add(P.Nat.bit(P.Nat.odd(V.U.N(s))), Nat.double(Nat.add(P.Nat.bit(_), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} WD.split4(s))), hb))) : {V.U.N(U32.add(U32.add(U32.add(s, 1), 1), 1)) == Nat.add(2n, Nat.double(Nat.double(_))) : Nat} WD.posg(s, E, 3n, Nat.double(Nat.double(V.U.N(U32.shrn(s, 2n)))), 3n, {==}, (%eo0 : {V.U.N(s) == Nat.add(P.Nat.bit(_), Nat.double(Nat.add(P.Nat.bit(True{}), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} (%eo1 : {V.U.N(s) == Nat.add(P.Nat.bit(P.Nat.odd(V.U.N(s))), Nat.double(Nat.add(P.Nat.bit(_), Nat.double(V.U.N(U32.shrn(s, 2n)))))) : Nat} WD.split4(s))), hb)), {==})
      @simp
      {==}

# The four bytes of the word read at s are the bytes at s.
law WD.join:
  for +u: A.Tr
  for +s: U32
  for +E: U32
  for +hb: {Cmp.is_le(Nat.cmp(Nat.add(4n, V.U.N(s)), V.U.N(E))) == True{} : Bool}
  {WD.w4(B.B.join(A.T.word(u, U32.shrn(s, 2n)), A.T.word(u, U32.add(U32.shrn(s, 2n), 1)), B.B.sh(s))) == S.S.sl(4n, u, s) : List<&2, U32>}

def WD.join(u, s, E, hb):
  WD.join.go(u, s, E, hb, P.Nat.odd(V.U.N(s)), P.Nat.odd(P.Nat.half(V.U.N(s))), {==}, {==})

# a + (4 + b) = 4 + (a + b).
law WD.add4r:
  for +a: Nat
  for +b: Nat
  {Nat.add(a, 4n+b) == 4n+Nat.add(a, b) : Nat}

def WD.add4r(a, b):
  @rw P.Nat.add_succ_r(a, 3n+b)
  @rw P.Nat.add_succ_r(a, 2n+b)
  @rw P.Nat.add_succ_r(a, 1n+b)
  @rw P.Nat.add_succ_r(a, b)
  {==}

# The lanes: below 4.
law WD.lane_lt:
  for +o0: Bool
  for +o1: Bool
  {Nat.cmp(Nat.add(P.Nat.bit(o0), Nat.double(P.Nat.bit(o1))), 4n) == LT{} : Cmp}

def WD.lane_lt(o0, o1):
  match o0 o1:
    case False{} False{}:
      {==}
    case False{} True{}:
      {==}
    case True{} False{}:
      {==}
    case True{} True{}:
      {==}

# Four steps from x add 4.
law WD.pos_4:
  for +x: U32
  for +E: U32
  for +hb: {Cmp.is_le(Nat.cmp(Nat.add(4n, V.U.N(x)), V.U.N(E))) == True{} : Bool}
  {V.U.N(WD.step(4n, x)) == 4n+V.U.N(x) : Nat}

def WD.pos_4(x, E, hb):
  WD.succ_at(WD.step(3n, x), E, 3n, V.U.N(x),
    WD.posg(x, E, 0n, V.U.N(x), 3n, {==}, {==}, hb),
    (%Equal.sym(Nat, V.U.N(WD.step(3n, x)), Nat.add(3n, V.U.N(x)), WD.posg(x, E, 0n, V.U.N(x), 3n, {==}, {==}, hb)) :
        {Nat.cmp(_, V.U.N(E)) == LT{} : Cmp};
      WD.lt4(V.U.N(x), V.U.N(E), 3n, {==}, hb)))

# The value split into lane and word, as an equation.
law WD.split_lane:
  for +s: U32
  {V.U.N(s) == Nat.add(Nat.add(P.Nat.bit(P.Nat.odd(V.U.N(s))), Nat.double(P.Nat.bit(P.Nat.odd(P.Nat.half(V.U.N(s)))))), Nat.double(Nat.double(V.U.N(U32.shrn(s, 2n))))) : Nat}

def WD.split_lane(s):
  @rw P.Nat.add_assoc(P.Nat.bit(P.Nat.odd(V.U.N(s))), Nat.double(P.Nat.bit(P.Nat.odd(P.Nat.half(V.U.N(s))))), Nat.double(Nat.double(V.U.N(U32.shrn(s, 2n)))))
  @rw- P.Nat.double_distr(P.Nat.bit(P.Nat.odd(P.Nat.half(V.U.N(s)))), Nat.double(V.U.N(U32.shrn(s, 2n))))
  WD.split4(s)

# Bits and values
# ===============

law WD.and_zero_r.go:
  for +p: Nat
  for +b: Bool
  for +t: Word(p)
  for +ih: {Word.and(p, t, Word.zero(p)) == Word.zero(p) : Word(p)}
  {WCon{Bool.and(b, False{}), Word.and(p, t, Word.zero(p))} == WCon{False{}, Word.zero(p)} : Word(1n+p)}

def WD.and_zero_r.go(p, b, t, ih):
  match b:
    case False{}:
      @rwx ih : {Word.and(p, t, Word.zero(p)) == Word.zero(p) : Word(p)}
      {==}
    case True{}:
      @rwx ih : {Word.and(p, t, Word.zero(p)) == Word.zero(p) : Word(p)}
      {==}

law WD.and_zero_r:
  for +n: Nat
  for +r: Word(n)
  {Word.and(n, r, Word.zero(n)) == Word.zero(n) : Word(n)}

def WD.and_zero_r(n, r):
  match n:
    case 0n:
      match r:
        case WNil{}:
          {==}
    case 1n+p:
      match r:
        case WCon{b, t}:
          WD.and_zero_r.go(p, b, t, WD.and_zero_r(p, t))

law WD.odd_bit:
  for +b: Bool
  {P.Nat.odd(P.Nat.bit(b)) == b : Bool}

def WD.odd_bit(b):
  match b:
    case False{}:
      {==}
    case True{}:
      {==}

law WD.half_bit:
  for +b: Bool
  {P.Nat.half(P.Nat.bit(b)) == 0n : Nat}

def WD.half_bit(b):
  match b:
    case False{}:
      {==}
    case True{}:
      {==}

# The lane of s, as its shift: from the lane's value.
law WD.sh_lane:
  for +s: U32
  {B.B.sh(s) == Y.BP.shv(P.Nat.odd(Nat.add(P.Nat.bit(P.Nat.odd(V.U.N(s))), Nat.double(P.Nat.bit(P.Nat.odd(P.Nat.half(V.U.N(s))))))), P.Nat.odd(P.Nat.half(Nat.add(P.Nat.bit(P.Nat.odd(V.U.N(s))), Nat.double(P.Nat.bit(P.Nat.odd(P.Nat.half(V.U.N(s))))))))) : Nat}

def WD.sh_lane(s):
  @rw WD.sh_N(s)
  @rw P.Nat.odd_add_double(P.Nat.bit(P.Nat.odd(V.U.N(s))), P.Nat.bit(P.Nat.odd(P.Nat.half(V.U.N(s)))))
  @rw P.Nat.half_add_double(P.Nat.bit(P.Nat.odd(V.U.N(s))), P.Nat.bit(P.Nat.odd(P.Nat.half(V.U.N(s)))))
  @rw WD.half_bit(P.Nat.odd(V.U.N(s)))
  @simp
  @rw WD.odd_bit(P.Nat.odd(V.U.N(s)))
  @rw WD.odd_bit(P.Nat.odd(P.Nat.half(V.U.N(s))))
  {==}

law WD.min:
  for +a: U32
  for +b: U32
  {U32.min(a, b) == Bool.pick(U32, U32.is_lt(a, b), a, b) : U32}

def WD.min(a, b):
  match a b:
    case U32{x} U32{y}:
      {==}

law WD.sub_self:
  for +n: U32
  {U32.sub(n, n) == 0 : U32}

def WD.sub_self(n):
  (%V.U.add_zero_r(n) : {U32.sub(_, n) == 0 : U32}; V.U.sub_add_l(n, 0))

# Lists at U32 offsets
# ====================

# A value of 0 is the word 0.
law WD.zero_of:
  for +x: U32
  for +e: {V.U.N(x) == 0n : Nat}
  {x == 0 : U32}

def WD.zero_of(x, e):
  V.U.eq_N(x, 0, e)

# x - 1, for x of value 1 + p, has value p.
law WD.pred_N:
  for +x: U32
  for +p: Nat
  for +e: {V.U.N(x) == 1n+p : Nat}
  {V.U.N(U32.sub(x, 1)) == p : Nat}

def WD.pred_N(x, p, e):
  P.Nat.succ_inj(V.U.N(U32.sub(x, 1)), p,
    (%P.Nat.add_one(V.U.N(U32.sub(x, 1))) : {_ == 1n+p : Nat};
      (%e : {Nat.add(V.U.N(U32.sub(x, 1)), 1n) == _ : Nat};
        V.U.sub_nat(x, 1, V.U.N_le(1, x,
          (%Equal.sym(Nat, V.U.N(x), 1n+p, e) : {Cmp.is_le(Nat.cmp(1n, _)) == True{} : Bool};
            P.Nat.le_zero(p)))))))

# (s + 1) + (x - 1) = s + x.
law WD.add_shift:
  for +s: U32
  for +x: U32
  {U32.add(U32.add(s, 1), U32.sub(x, 1)) == U32.add(s, x) : U32}

def WD.add_shift(s, x):
  @rw V.U.add_assoc(s, 1, U32.sub(x, 1))
  @rw U32.add_comm(1, U32.sub(x, 1))
  @rw V.U.add_sub(x, 1)
  {==}

# The bytes of k + m from s: those of k, then those of m from s + x, where x
# has value k.
law WD.sl_app:
  for +k: Nat
  for +m: Nat
  for +u: A.Tr
  for +s: U32
  for +x: U32
  for +e: {V.U.N(x) == k : Nat}
  {S.S.sl(Nat.add(k, m), u, s) == WD.app(S.S.sl(k, u, s), S.S.sl(m, u, U32.add(s, x))) : List<&2, U32>}

def WD.sl_app(k, m, u, s, x, e):
  match k:
    case 0n:
      @simp
      @rwx WD.zero_of(x, e) : {x == 0 : U32}
      @rw V.U.add_zero_r(s)
      {==}
    case 1n+p:
      @simp
      @rw WD.sl_app(p, m, u, U32.add(s, 1), U32.sub(x, 1), WD.pred_N(x, p, e))
      @rw WD.add_shift(s, x)
      {==}

# Writing xs then ys: ys goes at i + x, where x has the length of xs.
law WD.puts_app:
  for +xs: List<&2, U32>
  for +ys: List<&2, U32>
  for +t: A.Tr
  for +i: U32
  for +x: U32
  for +e: {V.U.N(x) == S.S.len(xs) : Nat}
  {S.S.puts(WD.app(xs, ys), t, i) == S.S.puts(ys, S.S.puts(xs, t, i), U32.add(i, x)) : A.Tr}

def WD.puts_app(xs, ys, t, i, x, e):
  match xs:
    case []:
      @simp
      @rwx WD.zero_of(x, e) : {x == 0 : U32}
      @rw V.U.add_zero_r(i)
      {==}
    case y <> r:
      @simp
      @rw WD.puts_app(r, ys, Y.BP.put(t, i, y), U32.add(i, 1), U32.sub(x, 1), WD.pred_N(x, S.S.len(r), e))
      @rw WD.add_shift(i, x)
      {==}

# Lanes and alignment
# ===================

law WD.and3:
  for +b0: Bool
  for +b1: Bool
  for +r: Word(30n)
  {U32.and(U32{WCon{b0, WCon{b1, r}}}, 3) == U32{WCon{Bool.and(b0, True{}), WCon{Bool.and(b1, True{}), Word.zero(30n)}}} : U32}

def WD.and3(b0, b1, r):
  @goal {U32{WCon{Bool.and(b0, True{}), WCon{Bool.and(b1, True{}), Word.and(30n, r, Word.zero(30n))}}} == U32{WCon{Bool.and(b0, True{}), WCon{Bool.and(b1, True{}), Word.zero(30n)}}} : U32}
  @rw WD.and_zero_r(30n, r)
  {==}

law WD.lane_N.go:
  for +b0: Bool
  for +b1: Bool
  {V.U.N(U32{WCon{Bool.and(b0, True{}), WCon{Bool.and(b1, True{}), Word.zero(30n)}}}) == Nat.add(P.Nat.bit(b0), Nat.double(P.Nat.bit(b1))) : Nat}

def WD.lane_N.go(b0, b1):
  match b0 b1:
    case False{} False{}:
      {==}
    case False{} True{}:
      {==}
    case True{} False{}:
      {==}
    case True{} True{}:
      {==}

# The low two bits of x, as a value: its lane.
law WD.lane_N:
  for +x: U32
  {V.U.N(U32.and(x, 3)) == Nat.add(P.Nat.bit(P.Nat.odd(V.U.N(x))), Nat.double(P.Nat.bit(P.Nat.odd(P.Nat.half(V.U.N(x)))))) : Nat}

def WD.lane_N(x):
  match x:
    case U32{WCon{b0, WCon{b1, r}}}:
      @rw WD.and3(b0, b1, r)
      @rw WD.lane_N.go(b0, b1)
      @goal {Nat.add(P.Nat.bit(b0), Nat.double(P.Nat.bit(b1))) == Nat.add(P.Nat.bit(P.Nat.odd(Word.to_nat(32n, WCon{b0, WCon{b1, r}}))), Nat.double(P.Nat.bit(P.Nat.odd(P.Nat.half(Word.to_nat(32n, WCon{b0, WCon{b1, r}})))))) : Nat}
      @rw W.W.N_cons(31n, b0, WCon{b1, r})
      @rw W.W.N_cons(30n, b1, r)
      @rw P.Nat.odd_add_double(P.Nat.bit(b0), Nat.add(P.Nat.bit(b1), Nat.double(Word.to_nat(30n, r))))
      @rw P.Nat.half_add_double(P.Nat.bit(b0), Nat.add(P.Nat.bit(b1), Nat.double(Word.to_nat(30n, r))))
      @rw WD.half_bit(b0)
      @simp
      @rw P.Nat.odd_add_double(P.Nat.bit(b1), Word.to_nat(30n, r))
      @rw WD.odd_bit(b0)
      @rw WD.odd_bit(b1)
      {==}

# x = (x & 3) + 4 (x >> 2).
law WD.mod4:
  for +x: U32
  {V.U.N(x) == Nat.add(V.U.N(U32.and(x, 3)), Nat.double(Nat.double(V.U.N(U32.shrn(x, 2n))))) : Nat}

def WD.mod4(x):
  @rw WD.lane_N(x)
  WD.split_lane(x)

# A value 4K is its word's value times 4.
law WD.aligned:
  for +y: U32
  for +K: Nat
  for +e: {V.U.N(y) == Nat.double(Nat.double(K)) : Nat}
  {V.U.N(y) == Nat.double(Nat.double(V.U.N(U32.shrn(y, 2n)))) : Nat}

def WD.aligned(y, K, e):
  @rw[1] WD.split_lane(y)
  @rwx e : {V.U.N(y) == Nat.double(Nat.double(K)) : Nat}
  @rw P.Nat.odd_double(Nat.double(K))
  @rw P.Nat.half_double(Nat.double(K))
  @rw P.Nat.odd_double(K)
  @simp
  {==}

# A value shifted down two bits and back up: four times the word.
law WD.shl2:
  for +x: U32
  {V.U.N(U32.shln(U32.shrn(x, 2n), 2n)) == Nat.double(Nat.double(V.U.N(U32.shrn(x, 2n)))) : Nat}

def WD.shl2(x):
  @goal {V.U.N(U32.shl(U32.shl(U32.shrn(x, 2n)))) == Nat.double(Nat.double(V.U.N(U32.shrn(x, 2n)))) : Nat}
  @rw V.U.N_shl(U32.shl(U32.shrn(x, 2n)), (%Equal.sym(Bool, V.U.bit(U32.shl(U32.shrn(x, 2n)), 31n), V.U.bit(U32.shrn(x, 2n), 30n), V.U.bit_shl(U32.shrn(x, 2n), 30n, {==})) : {_ == False{} : Bool}; (%Equal.sym(Bool, V.U.bit(U32.shrn(x, 2n), 30n), V.U.bit(x, 32n), V.U.bit_shrn(x, 2n, 30n)) : {_ == False{} : Bool}; V.U.bit_beyond(x, 32n, {==}))))
  @rw V.U.N_shl(U32.shrn(x, 2n), (%Equal.sym(Bool, V.U.bit(U32.shrn(x, 2n), 31n), V.U.bit(x, 33n), V.U.bit_shrn(x, 2n, 31n)) : {_ == False{} : Bool}; V.U.bit_beyond(x, 33n, {==})))
  {==}

# Four single steps are a step of four.
law WD.step4:
  for +x: U32
  {WD.step(4n, x) == U32.add(x, 4) : U32}

def WD.step4(x):
  @simp
  @rw V.U.add_assoc(x, 1, 1)
  @simp
  @rw V.U.add_assoc(x, 2, 1)
  @simp
  @rw V.U.add_assoc(x, 3, 1)
  @simp
  {==}

law WD.and_assoc:
  for +a: Bool
  for +b: Bool
  for +c: Bool
  {Bool.and(a, Bool.and(b, c)) == Bool.and(Bool.and(a, b), c) : Bool}

def WD.and_assoc(a, b, c):
  match a:
    case False{}:
      {==}
    case True{}:
      {==}

# Holding xs then ys: xs at i and ys at i + x, where x has the length of xs.
law WD.has_app:
  for +xs: List<&2, U32>
  for +ys: List<&2, U32>
  for +t: A.Tr
  for +i: U32
  for +x: U32
  for +e: {V.U.N(x) == S.S.len(xs) : Nat}
  {S.S.has(WD.app(xs, ys), t, i) == Bool.and(S.S.has(xs, t, i), S.S.has(ys, t, U32.add(i, x))) : Bool}

def WD.has_app(xs, ys, t, i, x, e):
  match xs:
    case []:
      @simp
      @rwx WD.zero_of(x, e) : {x == 0 : U32}
      @rw V.U.add_zero_r(i)
      {==}
    case y <> r:
      @simp
      @rw WD.has_app(r, ys, t, U32.add(i, 1), U32.sub(x, 1), WD.pred_N(x, S.S.len(r), e))
      @rw WD.add_shift(i, x)
      WD.and_assoc(U32.is_eq(Y.BP.byt(t, i), U32.and(y, 255)), S.S.has(r, t, U32.add(i, 1)), S.S.has(ys, t, U32.add(i, x)))


law WD.max_eq:
  for +a: U32
  for +b: U32
  {U32.max(a, b) == Bool.pick(U32, U32.is_lt(a, b), b, a) : U32}

def WD.max_eq(a, b):
  match a b:
    case U32{x} U32{y}:
      {==}

# Lists are equal when their heads and tails are.
law WD.cons_inj_h:
  for +x: U32
  for +xs: List<&2, U32>
  for +y: U32
  for +ys: List<&2, U32>
  for +e: {x <> xs == y <> ys : List<&2, U32>}
  {x == y : U32}

def WD.cons_inj_h(x, xs, y, ys, e):
  Equal.cong(List<&2, U32>, U32, l => WD.hd(l), x <> xs, y <> ys, e)

law WD.cons_inj_t:
  for +x: U32
  for +xs: List<&2, U32>
  for +y: U32
  for +ys: List<&2, U32>
  for +e: {x <> xs == y <> ys : List<&2, U32>}
  {xs == ys : List<&2, U32>}

def WD.cons_inj_t(x, xs, y, ys, e):
  Equal.cong(List<&2, U32>, List<&2, U32>, l => WD.tl(l), x <> xs, y <> ys, e)

def WD.hd(+l: List<&2, U32>) -> U32:
  match l:
    case []:
      0
    case x <> r:
      x

def WD.tl(+l: List<&2, U32>) -> List<&2, U32>:
  match l:
    case []:
      []
    case x <> r:
      r

# Equal byte ranges have equal sub-ranges: the first k bytes, and the rest.
law WD.sl_pre:
  for +k: Nat
  for +m: Nat
  for +t1: A.Tr
  for +t2: A.Tr
  for +i: U32
  for +e: {S.S.sl(Nat.add(k, m), t1, i) == S.S.sl(Nat.add(k, m), t2, i) : List<&2, U32>}
  {S.S.sl(k, t1, i) == S.S.sl(k, t2, i) : List<&2, U32>}

def WD.sl_pre(k, m, t1, t2, i, e):
  match k:
    case 0n:
      {==}
    case 1n+p:
      @simp
      @rw WD.cons_inj_h(Y.BP.byt(t1, i), S.S.sl(Nat.add(p, m), t1, U32.add(i, 1)), Y.BP.byt(t2, i), S.S.sl(Nat.add(p, m), t2, U32.add(i, 1)), e)
      @rw WD.sl_pre(p, m, t1, t2, U32.add(i, 1), WD.cons_inj_t(Y.BP.byt(t1, i), S.S.sl(Nat.add(p, m), t1, U32.add(i, 1)), Y.BP.byt(t2, i), S.S.sl(Nat.add(p, m), t2, U32.add(i, 1)), e))
      {==}

law WD.sl_suf:
  for +k: Nat
  for +m: Nat
  for +t1: A.Tr
  for +t2: A.Tr
  for +i: U32
  for +x: U32
  for +ex: {V.U.N(x) == k : Nat}
  for +e: {S.S.sl(Nat.add(k, m), t1, i) == S.S.sl(Nat.add(k, m), t2, i) : List<&2, U32>}
  {S.S.sl(m, t1, U32.add(i, x)) == S.S.sl(m, t2, U32.add(i, x)) : List<&2, U32>}

def WD.sl_suf(k, m, t1, t2, i, x, ex, e):
  match k:
    case 0n:
      @rwx WD.zero_of(x, ex) : {x == 0 : U32}
      @rw V.U.add_zero_r(i)
      e
    case 1n+p:
      @rw- WD.add_shift(i, x)
      WD.sl_suf(p, m, t1, t2, U32.add(i, 1), U32.sub(x, 1), WD.pred_N(x, p, ex), WD.cons_inj_t(Y.BP.byt(t1, i), S.S.sl(Nat.add(p, m), t1, U32.add(i, 1)), Y.BP.byt(t2, i), S.S.sl(Nat.add(p, m), t2, U32.add(i, 1)), e))

# Sums in any order
# =================

law WD.add_lc:
  for +x: U32
  for +y: U32
  for +z: U32
  {U32.add(x, U32.add(y, z)) == U32.add(y, U32.add(x, z)) : U32}

def WD.add_lc(x, y, z):
  @rw- V.U.add_assoc(x, y, z)
  @rw V.U.add_comm(x, y)
  @rw V.U.add_assoc(y, x, z)
  {==}
