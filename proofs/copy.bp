      @rw Y.BP.get_from(CP.mv(Nat.double(Nat.double(V.U.N(U32.shrn(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 2n)))), CP.mv(V.U.N(U32.and(U32.sub(4, U32.and(d, 3)), 3)), t, d, s), U32.add(d, U32.and(U32.sub(4, U32.and(d, 3)), 3)), U32.add(s, U32.and(U32.sub(4, U32.and(d, 3)), 3))), U32.add(U32.add(s, U32.and(U32.sub(4, U32.and(d, 3)), 3)), U32.shln(U32.shrn(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 2n), 2n)))
      @rw CP.mbytes(V.U.N(U32.and(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 3)), CP.mv(Nat.double(Nat.double(V.U.N(U32.shrn(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 2n)))), CP.mv(V.U.N(U32.and(U32.sub(4, U32.and(d, 3)), 3)), t, d, s), U32.add(d, U32.and(U32.sub(4, U32.and(d, 3)), 3)), U32.add(s, U32.and(U32.sub(4, U32.and(d, 3)), 3))), U32.add(U32.add(d, U32.and(U32.sub(4, U32.and(d, 3)), 3)), U32.shln(U32.shrn(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 2n), 2n)), U32.add(U32.add(s, U32.and(U32.sub(4, U32.and(d, 3)), 3)), U32.shln(U32.shrn(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 2n), 2n)))
      @rw- CP.mv_app(Nat.double(Nat.double(V.U.N(U32.shrn(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 2n)))), V.U.N(U32.and(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 3)), CP.mv(V.U.N(U32.and(U32.sub(4, U32.and(d, 3)), 3)), t, d, s), U32.add(d, U32.and(U32.sub(4, U32.and(d, 3)), 3)), U32.add(s, U32.and(U32.sub(4, U32.and(d, 3)), 3)), U32.shln(U32.shrn(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 2n), 2n), D.WD.shl2(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3))))
      @rw- CP.mv_app(V.U.N(U32.and(U32.sub(4, U32.and(d, 3)), 3)), Nat.add(Nat.double(Nat.double(V.U.N(U32.shrn(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 2n)))), V.U.N(U32.and(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 3))), t, d, s, U32.and(U32.sub(4, U32.and(d, 3)), 3), {==})
      @rw P.Nat.add_comm(Nat.double(Nat.double(V.U.N(U32.shrn(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 2n)))), V.U.N(U32.and(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 3)))
      @rw- D.WD.mod4(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)))
      @rw P.Nat.add_comm(V.U.N(U32.and(U32.sub(4, U32.and(d, 3)), 3)), V.U.N(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3))))
      @rw V.U.sub_nat(n, U32.and(U32.sub(4, U32.and(d, 3)), 3), V.U.not_lt(n, U32.and(U32.sub(4, U32.and(d, 3)), 3), ec))
      {==}

law CP.move.go:
  for +t: A.Tr
  for +d: U32
  for +s: U32
  for +n: U32
  for +dp: Nat
  for +E: U32
  for +hp: {A.T.pf(dp, t) == True{} : Bool}
  for +hd: {Nat.cmp(dp, 32n) == LT{} : Cmp}
  for +he: {Cmp.is_le(Nat.cmp(V.U.N(E), Nat.double(Nat.double(P.Nat.pow2(dp))))) == True{} : Bool}
  for +hb: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(n), V.U.N(d)), V.U.N(E))) == True{} : Bool}
  for +hs: {Nat.cmp(V.U.N(s), V.U.N(d)) == LT{} : Cmp}
  for +f: Bool
  for +ef: {U32.is_ge(U32.sub(d, s), 4) == f : Bool}
  {B.B.move(A.A.from(t), d, s, n) == A.A.from(CP.mv(V.U.N(n), t, d, s)) : Array<U32>}

def CP.move.go(t, d, s, n, dp, E, hp, hd, he, hb, hs, f, ef):
  match f:
    case False{}:
      @unfold B.B.move
      @rwx ef : {U32.is_ge(U32.sub(d, s), 4) == False{} : Bool}
      @simp
      @rename U32.to_nat V.U.N
      @rw Y.BP.get_from(t, s)
      CP.mbytes(V.U.N(n), t, d, s)
    case True{}:
      @unfold B.B.move
      @rwx ef : {U32.is_ge(U32.sub(d, s), 4) == True{} : Bool}
      CP.move.fast(t, d, s, n, dp, E, hp, hd, he, hb, (%V.U.sub_nat(d, s, V.U.lt_to_le(s, d, V.U.N_lt(s, d, hs))) : {Cmp.is_le(Nat.cmp(Nat.add(4n, V.U.N(s)), _)) == True{} : Bool}; CP.le_add_r(4n, V.U.N(U32.sub(d, s)), V.U.N(s), V.U.le_N(4, U32.sub(d, s), V.U.ge_le(U32.sub(d, s), 4, ef)))), U32.is_lt(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), {==})

# Moving n bytes from s to d (s before d) in one tree is the forward copy.
law CP.move:
  for +t: A.Tr
  for +d: U32
  for +s: U32
  for +n: U32
  for +dp: Nat
  for +E: U32
  for +hp: {A.T.pf(dp, t) == True{} : Bool}
  for +hd: {Nat.cmp(dp, 32n) == LT{} : Cmp}
  for +he: {Cmp.is_le(Nat.cmp(V.U.N(E), Nat.double(Nat.double(P.Nat.pow2(dp))))) == True{} : Bool}
  for +hb: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(n), V.U.N(d)), V.U.N(E))) == True{} : Bool}
  for +hs: {Nat.cmp(V.U.N(s), V.U.N(d)) == LT{} : Cmp}
  {B.B.move(A.A.from(t), d, s, n) == A.A.from(CP.mv(V.U.N(n), t, d, s)) : Array<U32>}

def CP.move(t, d, s, n, dp, E, hp, hd, he, hb, hs):
  CP.move.go(t, d, s, n, dp, E, hp, hd, he, hb, hs, U32.is_ge(U32.sub(d, s), 4), {==})
