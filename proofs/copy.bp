      @rw P.Nat.add_comm(Nat.double(Nat.double(V.U.N(U32.shrn(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 2n)))), V.U.N(U32.and(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 3)))
