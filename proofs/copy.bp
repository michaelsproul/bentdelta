, U32.and(U32.sub(4, U32.and(d, 3)), 3), ec)), hd)))
      @rw CP.fbytes(V.U.N(U32.and(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 3)), S.S.puts(CP.rep(Nat.double(Nat.double(V.U.N(U32.shrn(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 2n)))), v), S.S.puts(CP.rep(V.U.N(U32.and(U32.sub(4, U32.and(d, 3)), 3)), v), t, d), U32.add(d, U32.and(U32.sub(4, U32.and(d, 3)), 3))), U32.add(U32.add(d, U32.and(U32.sub(4, U32.and(d, 3)), 3)), U32.shln(U32.shrn(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 2n), 2n)), v)
