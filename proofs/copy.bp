# Copying n bytes from s in one array to d in another writes them there.
law CP.copy:
  for +t: A.Tr
  for +d: U32
  for +u: A.Tr
  for +s: U32
  for +n: U32
  for +E: U32
  for +hd: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(n), V.U.N(d)), V.U.N(E))) == True{} : Bool}
  for +hs: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(n), V.U.N(s)), V.U.N(E))) == True{} : Bool}
  {B.B.copy(A.A.from(t), d, A.A.from(u), s, n) == (A.A.from(u), A.A.from(S.S.puts(S.S.sl(V.U.N(n), u, s), t, d))) : Array<U32> & Array<U32>}

def CP.copy(t, d, u, s, n, E, hd, hs):
  CP.copy.go(t, d, u, s, n, E, hd, hs, U32.is_lt(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), {==})

# Filling
# =======

# n copies of v.
def CP.rep(+n: Nat, +v: U32) -> List<&2, U32>:
  match n:
    case 0n:
      []
    case 1n+p:
      v <> CP.rep(p, v)

law CP.len_rep:
  for +n: Nat
  for +v: U32
  {S.S.len(CP.rep(n, v)) == n : Nat}

def CP.len_rep(n, v):
  match n:
    case 0n:
      {==}
    case 1n+p:
      @simp
      @rw CP.len_rep(p, v)
      {==}

law CP.rep_app:
  for +a: Nat
  for +b: Nat
  for +v: U32
  {CP.rep(Nat.add(a, b), v) == D.WD.app(CP.rep(a, v), CP.rep(b, v)) : List<&2, U32>}

def CP.rep_app(a, b, v):
  match a:
    case 0n:
      {==}
    case 1n+p:
      @simp
      @rw CP.rep_app(p, b, v)
      {==}

# A byte is written as its low eight bits.
law CP.put_mask:
  for +t: A.Tr
  for +i: U32
  for +v: U32
  {Y.BP.put(t, i, U32.and(v, 255)) == Y.BP.put(t, i, v) : A.Tr}

def CP.put_mask(t, i, v):
  @unfold Y.BP.put Y.BP.ins
  @rw Z.BB.and255(v)
  {==}

law CP.fbytes:
  for +k: Nat
  for +t: A.Tr
  for +d: U32
  for +v: U32
  {B.B.fill.bytes(k, A.A.from(t), d, v) == A.A.from(S.S.puts(CP.rep(k, v), t, d)) : Array<U32>}

def CP.fbytes(k, t, d, v):
  match k:
    case 0n:
      {==}
    case 1n+p:
      @simp
      @rw Y.BP.put_from(t, d, v)
      @rw CP.fbytes(p, Y.BP.put(t, d, v), U32.add(d, 1), v)
      {==}

# The four bytes of a word of copies of v, written, are copies of v.
law CP.rep4_put:
  for +t: A.Tr
  for +d: U32
  for +v: U32
  {S.S.puts(D.WD.w4(B.B.rep4(v)), t, d) == S.S.puts(CP.rep(4n, v), t, d) : A.Tr}

def CP.rep4_put(t, d, v):
  @unfold D.WD.w4
  @rw Z.BB.rep4_0(v)
  @rw Z.BB.rep4_1(v)
  @rw Z.BB.rep4_2(v)
  @rw Z.BB.rep4_3(v)
  @simp
  @rw CP.put_mask(t, d, v)
  @rw CP.put_mask(Y.BP.put(t, d, v), U32.add(d, 1), v)
  @rw CP.put_mask(Y.BP.put(Y.BP.put(t, d, v), U32.add(d, 1), v), U32.add(U32.add(d, 1), 1), v)
  @rw CP.put_mask(Y.BP.put(Y.BP.put(Y.BP.put(t, d, v), U32.add(d, 1), v), U32.add(U32.add(d, 1), 1), v), U32.add(U32.add(U32.add(d, 1), 1), 1), v)
  {==}

law CP.fwords:
  for +n: Nat
  for +t: A.Tr
  for +dw: U32
  for +d: U32
  for +v: U32
  for +E: U32
  for +ed: {V.U.N(d) == Nat.double(Nat.double(V.U.N(dw))) : Nat}
  for +hd: {Cmp.is_le(Nat.cmp(Nat.add(Nat.double(Nat.double(n)), V.U.N(d)), V.U.N(E))) == True{} : Bool}
  {B.B.fill.words(n, A.A.from(t), dw, B.B.rep4(v)) == A.A.from(S.S.puts(CP.rep(Nat.double(Nat.double(n)), v), t, d)) : Array<U32>}

def CP.fwords(n, t, dw, d, v, E, ed, hd):
  match n:
    case 0n:
      {==}
    case 1n+p:
      @simp
      @rw A.A.set_from(t, dw, B.B.rep4(v))
      @rw CP.fwords(p, A.T.set(t, dw, B.B.rep4(v)), U32.add(dw, 1), D.WD.step(4n, d), v, E, CP.next(d, dw, E, 0n, ed, CP.le4(Nat.double(Nat.double(p)), V.U.N(d), V.U.N(E), hd)), (%Equal.sym(Nat, V.U.N(D.WD.step(4n, d)), 4n+V.U.N(d), D.WD.pos_4(d, E, CP.le4(Nat.double(Nat.double(p)), V.U.N(d), V.U.N(E), hd))) : {Cmp.is_le(Nat.cmp(Nat.add(Nat.double(Nat.double(p)), _), V.U.N(E))) == True{} : Bool}; (%Equal.sym(Nat, Nat.add(Nat.double(Nat.double(p)), 4n+V.U.N(d)), 4n+Nat.add(Nat.double(Nat.double(p)), V.U.N(d)), D.WD.add4r(Nat.double(Nat.double(p)), V.U.N(d))) : {Cmp.is_le(Nat.cmp(_, V.U.N(E))) == True{} : Bool}; hd)))
      @rw- D.WD.put4(t, d, dw, E, B.B.rep4(v), ed, CP.le4(Nat.double(Nat.double(p)), V.U.N(d), V.U.N(E), hd))
      @rw CP.rep4_put(t, d, v)
      @simp
      {==}

law CP.fill.go:
  for +t: A.Tr
  for +d: U32
  for +v: U32
  for +n: U32
  for +E: U32
  for +hd: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(n), V.U.N(d)), V.U.N(E))) == True{} : Bool}
  for +c: Bool
  for +ec: {U32.is_lt(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)) == c : Bool}
  {B.B.fill(A.A.from(t), d, v, n) == A.A.from(S.S.puts(CP.rep(V.U.N(n), v), t, d)) : Array<U32>}

def CP.fill.go(t, d, v, n, E, hd, c, ec):
  match c:
    case True{}:
      @unfold B.B.fill
      @rw D.WD.min(n, U32.and(U32.sub(4, U32.and(d, 3)), 3))
      @rwx ec : {U32.is_lt(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)) == True{} : Bool}
      @simp
      @rename U32.to_nat V.U.N
      @rw CP.fbytes(V.U.N(n), t, d, v)
      @rw D.WD.sub_self(n)
      @unfold B.B.fill.body
      @rename U32.to_nat V.U.N
      @simp
      {==}
    case False{}:
      @unfold B.B.fill
      @rw D.WD.min(n, U32.and(U32.sub(4, U32.and(d, 3)), 3))
      @rwx ec : {U32.is_lt(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)) == False{} : Bool}
      @simp
      @rename U32.to_nat V.U.N
      @rw CP.fbytes(V.U.N(U32.and(U32.sub(4, U32.and(d, 3)), 3)), t, d, v)
