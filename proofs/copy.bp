      @rw- D.WD.puts_app(CP.rep(V.U.N(U32.and(U32.sub(4, U32.and(d, 3)), 3)), v), D.WD.app(CP.rep(Nat.double(Nat.double(V.U.N(U32.shrn(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 2n)))), v), CP.rep(V.U.N(U32.and(U32.sub(n, U32.and(U32.sub(4, U32.and(d, 3)), 3)), 3)), v)), t, d, U32.and(U32.sub(4, U32.and(d, 3)), 3), Equal.sym(Nat, S.S.len(CP.rep(V.U.N(U32.and(U32.sub(4, U32.and(d, 3)), 3)), v)), V.U.N(U32.and(U32.sub(4, U32.and(d, 3)), 3)), CP.len_rep(V.U.N(U32.and(U32.sub(4, U32.and(d, 3)), 3)), v)))
