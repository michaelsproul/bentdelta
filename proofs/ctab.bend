      %Equal.sym(U32, size, 1, V.U.is_eq(size, 1, P.Bool.and_r(U32.is_eq(t, 1), U32.is_eq(size, 1), P.Bool.and_l(Bool.and(U32.is_eq(t, 1), U32.is_eq(size, 1)), U32.is_eq(pt, 3), P.Bool.and_l(Bool.and(Bool.and(U32.is_eq(t, 1), U32.is_eq(size, 1)), U32.is_eq(pt, 3)), U32.is_eq(ps, 4), eca))))) :
        {CT.D(Bool.pick(U32, Bool.and(Bool.and(Bool.and(U32.is_eq(1, 1), U32.is_eq(_, 1)), U32.is_eq(pt, 3)), U32.is_eq(ps, 4)), U32.add(247, pm), Bool.pick(U32, Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(U32.is_eq(1, 3), U32.is_le(4, _)), U32.is_le(_, 18)), U32.is_eq(pt, 1)), U32.is_le(1, ps)), U32.is_le(ps, 4)), U32.is_le(_, 6)), U32.is_le(mode, 5)), U32.add(U32.add(U32.add(163, U32.mul(mode, 12)), U32.mul(U32.sub(ps, 1), 3)), U32.sub(_, 4)), Bool.pick(U32, Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(U32.is_eq(1, 3), U32.is_le(4, _)), U32.is_le(_, 18)), U32.is_eq(pt, 1)), U32.is_le(1, ps)), U32.is_le(ps, 4)), U32.is_eq(_, 4)), U32.is_ge(mode, 6)), U32.add(U32.add(235, U32.mul(U32.sub(mode, 6), 4)), U32.sub(ps, 1)), 0))), pt, ps, pm, 1, _, mode) == True{} : Bool}
      %Equal.sym(U32, pt, 3, V.U.is_eq(pt, 3, P.Bool.and_r(Bool.and(U32.is_eq(t, 1), U32.is_eq(size, 1)), U32.is_eq(pt, 3), P.Bool.and_l(Bool.and(Bool.and(U32.is_eq(t, 1), U32.is_eq(size, 1)), U32.is_eq(pt, 3)), U32.is_eq(ps, 4), eca)))) :
        {CT.D(Bool.pick(U32, Bool.and(Bool.and(Bool.and(U32.is_eq(1, 1), U32.is_eq(1, 1)), U32.is_eq(_, 3)), U32.is_eq(ps, 4)), U32.add(247, pm), Bool.pick(U32, Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(U32.is_eq(1, 3), U32.is_le(4, 1)), U32.is_le(1, 18)), U32.is_eq(_, 1)), U32.is_le(1, ps)), U32.is_le(ps, 4)), U32.is_le(1, 6)), U32.is_le(mode, 5)), U32.add(U32.add(U32.add(163, U32.mul(mode, 12)), U32.mul(U32.sub(ps, 1), 3)), U32.sub(1, 4)), Bool.pick(U32, Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(U32.is_eq(1, 3), U32.is_le(4, 1)), U32.is_le(1, 18)), U32.is_eq(_, 1)), U32.is_le(1, ps)), U32.is_le(ps, 4)), U32.is_eq(1, 4)), U32.is_ge(mode, 6)), U32.add(U32.add(235, U32.mul(U32.sub(mode, 6), 4)), U32.sub(ps, 1)), 0))), _, ps, pm, 1, 1, mode) == True{} : Bool}
