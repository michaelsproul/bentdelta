      %Equal.sym(U32, mode, 8, V.U.eq_N(mode, 8, ekm)) :
        {CT.S(N.op.single(3, 5, _), 3, 5, _) == True{} : Bool}
      {==}
    case 5n 9n+r:
      P.Bool.false_true({CT.S(N.op.single(3, size, mode), 3, size, mode) == True{} : Bool}, hm)
    case 6n 0n:
      %Equal.sym(U32, size, 6, V.U.eq_N(size, 6, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 0, V.U.eq_N(mode, 0, ekm)) :
        {CT.S(N.op.single(3, 6, _), 3, 6, _) == True{} : Bool}
      {==}
    case 6n 1n:
      %Equal.sym(U32, size, 6, V.U.eq_N(size, 6, eks)) :
