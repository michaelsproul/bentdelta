    case False{}:
      CT.dbl.b(pt, ps, pm, t, size, mode, hd, hm, eca, Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(U32.is_eq(t, 3), U32.is_le(4, size)), U32.is_le(size, 18)), U32.is_eq(pt, 1)), U32.is_le(1, ps)), U32.is_le(ps, 4)), U32.is_le(size, 6)), U32.is_le(mode, 5)), {==})

# Two instructions as one double opcode.
law CT.dbl:
  for +pt: U32
  for +ps: U32
  for +pm: U32
  for +t: U32
  for +size: U32
  for +mode: U32
  for +hd: {U32.is_ne(N.op.double(pt, ps, pm, t, size, mode), 0) == True{} : Bool}
  for +hpm: {Cmp.is_le(Nat.cmp(V.U.N(pm), 8n)) == True{} : Bool}
  for +hm: {Cmp.is_le(Nat.cmp(V.U.N(mode), 8n)) == True{} : Bool}
  {CT.D(N.op.double(pt, ps, pm, t, size, mode), pt, ps, pm, t, size, mode) == True{} : Bool}

def CT.dbl(pt, ps, pm, t, size, mode, hd, hpm, hm):
  CT.dbl.a(pt, ps, pm, t, size, mode, hd, hpm, hm, Bool.and(Bool.and(Bool.and(U32.is_eq(t, 1), U32.is_eq(size, 1)), U32.is_eq(pt, 3)), U32.is_eq(ps, 4)), {==})
