    case 6n 8n:
      %Equal.sym(U32, size, 6, V.U.eq_N(size, 6, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 8, V.U.eq_N(mode, 8, ekm)) :
