law CT.dbl.b.e:
  for +pt: U32
  for +ps: U32
  for +pm: U32
  for +t: U32
  for +size: U32
  for +mode: U32
  for +ks: Nat
  for +kp: Nat
  for +km: Nat
  for +eks: {V.U.N(size) == ks : Nat}
  for +ekp: {V.U.N(ps) == kp : Nat}
  for +ekm: {V.U.N(mode) == km : Nat}
  for +et: {t == 3 : U32}
  for +ept: {pt == 1 : U32}
  for +slo: {Cmp.is_le(Nat.cmp(4n, ks)) == True{} : Bool}
  for +shi: {Cmp.is_le(Nat.cmp(ks, 6n)) == True{} : Bool}
  for +plo: {Cmp.is_le(Nat.cmp(1n, kp)) == True{} : Bool}
  for +phi: {Cmp.is_le(Nat.cmp(kp, 4n)) == True{} : Bool}
  for +mhi: {Cmp.is_le(Nat.cmp(km, 5n)) == True{} : Bool}
  {CT.D(N.op.double(pt, ps, pm, t, size, mode), pt, ps, pm, t, size, mode) == True{} : Bool}

def CT.dbl.b.e(pt, ps, pm, t, size, mode, ks, kp, km, eks, ekp, ekm, et, ept, slo, shi, plo, phi, mhi):
  match ks kp km:
    case 0n _ _:
      P.Bool.false_true({CT.D(N.op.double(pt, ps, pm, t, size, mode), pt, ps, pm, t, size, mode) == True{} : Bool}, slo)
    case 1n _ _:
      P.Bool.false_true({CT.D(N.op.double(pt, ps, pm, t, size, mode), pt, ps, pm, t, size, mode) == True{} : Bool}, slo)
    case 2n _ _:
      P.Bool.false_true({CT.D(N.op.double(pt, ps, pm, t, size, mode), pt, ps, pm, t, size, mode) == True{} : Bool}, slo)
    case 3n _ _:
      P.Bool.false_true({CT.D(N.op.double(pt, ps, pm, t, size, mode), pt, ps, pm, t, size, mode) == True{} : Bool}, slo)
    case 4n 0n _:
      P.Bool.false_true({CT.D(N.op.double(pt, ps, pm, t, size, mode), pt, ps, pm, t, size, mode) == True{} : Bool}, plo)
    case 4n 1n 0n:
      %Equal.sym(U32, t, 3, et) :
        {CT.D(N.op.double(pt, ps, pm, _, size, mode), pt, ps, pm, _, size, mode) == True{} : Bool}
      %Equal.sym(U32, pt, 1, ept) :
        {CT.D(N.op.double(_, ps, pm, 3, size, mode), _, ps, pm, 3, size, mode) == True{} : Bool}
      %Equal.sym(U32, size, 4, V.U.eq_N(size, 4, eks)) :
        {CT.D(N.op.double(1, ps, pm, 3, _, mode), 1, ps, pm, 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, ps, 1, V.U.eq_N(ps, 1, ekp)) :
        {CT.D(N.op.double(1, _, pm, 3, 4, mode), 1, _, pm, 3, 4, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 0, V.U.eq_N(mode, 0, ekm)) :
        {CT.D(N.op.double(1, 1, pm, 3, 4, _), 1, 1, pm, 3, 4, _) == True{} : Bool}
      {==}
    case 4n 1n 1n:
      %Equal.sym(U32, t, 3, et) :
        {CT.D(N.op.double(pt, ps, pm, _, size, mode), pt, ps, pm, _, size, mode) == True{} : Bool}
      %Equal.sym(U32, pt, 1, ept) :
        {CT.D(N.op.double(_, ps, pm, 3, size, mode), _, ps, pm, 3, size, mode) == True{} : Bool}
      %Equal.sym(U32, size, 4, V.U.eq_N(size, 4, eks)) :
        {CT.D(N.op.double(1, ps, pm, 3, _, mode), 1, ps, pm, 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, ps, 1, V.U.eq_N(ps, 1, ekp)) :
        {CT.D(N.op.double(1, _, pm, 3, 4, mode), 1, _, pm, 3, 4, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 1, V.U.eq_N(mode, 1, ekm)) :
        {CT.D(N.op.double(1, 1, pm, 3, 4, _), 1, 1, pm, 3, 4, _) == True{} : Bool}
      {==}
    case 4n 1n 2n:
      %Equal.sym(U32, t, 3, et) :
        {CT.D(N.op.double(pt, ps, pm, _, size, mode), pt, ps, pm, _, size, mode) == True{} : Bool}
      %Equal.sym(U32, pt, 1, ept) :
        {CT.D(N.op.double(_, ps, pm, 3, size, mode), _, ps, pm, 3, size, mode) == True{} : Bool}
      %Equal.sym(U32, size, 4, V.U.eq_N(size, 4, eks)) :
        {CT.D(N.op.double(1, ps, pm, 3, _, mode), 1, ps, pm, 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, ps, 1, V.U.eq_N(ps, 1, ekp)) :
        {CT.D(N.op.double(1, _, pm, 3, 4, mode), 1, _, pm, 3, 4, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 2, V.U.eq_N(mode, 2, ekm)) :
        {CT.D(N.op.double(1, 1, pm, 3, 4, _), 1, 1, pm, 3, 4, _) == True{} : Bool}
      {==}
    case 4n 1n 3n:
      %Equal.sym(U32, t, 3, et) :
        {CT.D(N.op.double(pt, ps, pm, _, size, mode), pt, ps, pm, _, size, mode) == True{} : Bool}
      %Equal.sym(U32, pt, 1, ept) :
        {CT.D(N.op.double(_, ps, pm, 3, size, mode), _, ps, pm, 3, size, mode) == True{} : Bool}
      %Equal.sym(U32, size, 4, V.U.eq_N(size, 4, eks)) :
        {CT.D(N.op.double(1, ps, pm, 3, _, mode), 1, ps, pm, 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, ps, 1, V.U.eq_N(ps, 1, ekp)) :
        {CT.D(N.op.double(1, _, pm, 3, 4, mode), 1, _, pm, 3, 4, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 3, V.U.eq_N(mode, 3, ekm)) :
        {CT.D(N.op.double(1, 1, pm, 3, 4, _), 1, 1, pm, 3, 4, _) == True{} : Bool}
      {==}
    case 4n 1n 4n:
      %Equal.sym(U32, t, 3, et) :
        {CT.D(N.op.double(pt, ps, pm, _, size, mode), pt, ps, pm, _, size, mode) == True{} : Bool}
      %Equal.sym(U32, pt, 1, ept) :
        {CT.D(N.op.double(_, ps, pm, 3, size, mode), _, ps, pm, 3, size, mode) == True{} : Bool}
      %Equal.sym(U32, size, 4, V.U.eq_N(size, 4, eks)) :
        {CT.D(N.op.double(1, ps, pm, 3, _, mode), 1, ps, pm, 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, ps, 1, V.U.eq_N(ps, 1, ekp)) :
        {CT.D(N.op.double(1, _, pm, 3, 4, mode), 1, _, pm, 3, 4, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 4, V.U.eq_N(mode, 4, ekm)) :
        {CT.D(N.op.double(1, 1, pm, 3, 4, _), 1, 1, pm, 3, 4, _) == True{} : Bool}
      {==}
    case 4n 1n 5n:
      %Equal.sym(U32, t, 3, et) :
        {CT.D(N.op.double(pt, ps, pm, _, size, mode), pt, ps, pm, _, size, mode) == True{} : Bool}
      %Equal.sym(U32, pt, 1, ept) :
        {CT.D(N.op.double(_, ps, pm, 3, size, mode), _, ps, pm, 3, size, mode) == True{} : Bool}
      %Equal.sym(U32, size, 4, V.U.eq_N(size, 4, eks)) :
        {CT.D(N.op.double(1, ps, pm, 3, _, mode), 1, ps, pm, 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, ps, 1, V.U.eq_N(ps, 1, ekp)) :
        {CT.D(N.op.double(1, _, pm, 3, 4, mode), 1, _, pm, 3, 4, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 5, V.U.eq_N(mode, 5, ekm)) :
