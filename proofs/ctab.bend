import Base
import ../bytes.bend as B
import ../vcdiff.bend as D
import ../encode.bend as N
import ./nat.bend as P
import ./u32.bend as V
import ./array.bend as A
import ./spec.bend as Q

# The encoder's opcodes fit the code table: op.single and op.double pick
# entries whose halves are the instructions written, with sizes in the
# instruction section exactly when op.sized says. Each is checked case by
# case over the values the encoder uses.
#
# Source: proofs/ctab.bp (generated by a script; tools/bpp.py writes
# proofs/ctab.bend from it).

# A table half fits an instruction of type k, size n and mode m (as
# Q.SP.hok does for a half of that type, size and mode).
def CT.hok3(+h: U32, +k: U32, +n: U32, +m: U32) -> Bool:
  U32.is_eq(Q.SP.ht(h), k)
    && (U32.is_eq(Q.SP.hs(h), 0) || U32.is_eq(Q.SP.hs(h), n))
    && (U32.is_ne(k, 3) || U32.is_eq(Q.SP.hm(h), m))

# A single opcode c for an instruction (k, n, m).
def CT.S(+c: U32, +k: U32, +n: U32, +m: U32) -> Bool:
  Bool.and(U32.is_lt(c, 256), Bool.and(CT.hok3(Q.SP.e1(c), k, n, m), Bool.and(CT.hok3(Q.SP.e2(c), 0, 0, 0),
    Bool.and(Bool.or(Bool.and(Q.SP.z(Q.SP.e1(c)), N.op.sized(c)), Bool.and(Bool.not(Q.SP.z(Q.SP.e1(c))), Bool.not(N.op.sized(c)))), Bool.not(Q.SP.z(Q.SP.e2(c)))))))

# A double opcode c for instructions (pt, ps, pm) then (t, size, mode).
def CT.D(+c: U32, +pt: U32, +ps: U32, +pm: U32, +t: U32, +size: U32, +mode: U32) -> Bool:
  Bool.and(U32.is_lt(c, 256), Bool.and(CT.hok3(Q.SP.e1(c), pt, ps, pm), Bool.and(CT.hok3(Q.SP.e2(c), t, size, mode),
    Bool.and(Bool.not(Q.SP.z(Q.SP.e1(c))), Bool.not(Q.SP.z(Q.SP.e2(c)))))))

law CT.add.e:
  for +size: U32
  for +k: Nat
  for +ek: {V.U.N(size) == k : Nat}
  for +hb: {Cmp.is_le(Nat.cmp(k, 17n)) == True{} : Bool}
  {CT.S(N.op.single(1, size, 0), 1, size, 0) == True{} : Bool}

def CT.add.e(size, k, ek, hb):
  match k:
    case 0n:
      %Equal.sym(U32, size, 0, V.U.eq_N(size, 0, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 1n:
      %Equal.sym(U32, size, 1, V.U.eq_N(size, 1, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 2n:
      %Equal.sym(U32, size, 2, V.U.eq_N(size, 2, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 3n:
      %Equal.sym(U32, size, 3, V.U.eq_N(size, 3, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 4n:
      %Equal.sym(U32, size, 4, V.U.eq_N(size, 4, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 5n:
      %Equal.sym(U32, size, 5, V.U.eq_N(size, 5, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 6n:
      %Equal.sym(U32, size, 6, V.U.eq_N(size, 6, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 7n:
      %Equal.sym(U32, size, 7, V.U.eq_N(size, 7, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 8n:
      %Equal.sym(U32, size, 8, V.U.eq_N(size, 8, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 9n:
      %Equal.sym(U32, size, 9, V.U.eq_N(size, 9, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 10n:
      %Equal.sym(U32, size, 10, V.U.eq_N(size, 10, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 11n:
      %Equal.sym(U32, size, 11, V.U.eq_N(size, 11, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 12n:
      %Equal.sym(U32, size, 12, V.U.eq_N(size, 12, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 13n:
      %Equal.sym(U32, size, 13, V.U.eq_N(size, 13, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 14n:
      %Equal.sym(U32, size, 14, V.U.eq_N(size, 14, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 15n:
      %Equal.sym(U32, size, 15, V.U.eq_N(size, 15, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 16n:
      %Equal.sym(U32, size, 16, V.U.eq_N(size, 16, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 17n:
      %Equal.sym(U32, size, 17, V.U.eq_N(size, 17, ek)) :
        {CT.S(N.op.single(1, _, 0), 1, _, 0) == True{} : Bool}
      {==}
    case 18n+r:
      P.Bool.false_true({CT.S(N.op.single(1, size, 0), 1, size, 0) == True{} : Bool}, hb)

law CT.add.c:
  for +size: U32
  for +c: Bool
  for +ec: {U32.is_le(size, 17) == c : Bool}
  {CT.S(N.op.single(1, size, 0), 1, size, 0) == True{} : Bool}

def CT.add.c(size, c, ec):
  match c:
    case True{}:
      CT.add.e(size, V.U.N(size), {==}, V.U.le_N(size, 17, ec))
    case False{}:
      %Equal.sym(Bool, U32.is_le(size, 17), False{}, ec) :
        {CT.S(Bool.pick(U32, _, U32.add(1, size), 1), 1, size, 0) == True{} : Bool}
      {==}

# An ADD alone.
law CT.add:
  for +size: U32
  {CT.S(N.op.single(1, size, 0), 1, size, 0) == True{} : Bool}

def CT.add(size):
  CT.add.c(size, U32.is_le(size, 17), {==})

# A RUN alone.
law CT.run:
  for +size: U32
  {CT.S(N.op.single(2, size, 0), 2, size, 0) == True{} : Bool}

def CT.run(size):
  {==}

law CT.copy.e:
  for +size: U32
  for +mode: U32
  for +ks: Nat
  for +km: Nat
  for +eks: {V.U.N(size) == ks : Nat}
  for +ekm: {V.U.N(mode) == km : Nat}
  for +lo: {Cmp.is_le(Nat.cmp(4n, ks)) == True{} : Bool}
  for +hi: {Cmp.is_le(Nat.cmp(ks, 18n)) == True{} : Bool}
  for +hm: {Cmp.is_le(Nat.cmp(km, 8n)) == True{} : Bool}
  {CT.S(N.op.single(3, size, mode), 3, size, mode) == True{} : Bool}

def CT.copy.e(size, mode, ks, km, eks, ekm, lo, hi, hm):
  match ks km:
    case 0n _:
      P.Bool.false_true({CT.S(N.op.single(3, size, mode), 3, size, mode) == True{} : Bool}, lo)
    case 1n _:
      P.Bool.false_true({CT.S(N.op.single(3, size, mode), 3, size, mode) == True{} : Bool}, lo)
    case 2n _:
      P.Bool.false_true({CT.S(N.op.single(3, size, mode), 3, size, mode) == True{} : Bool}, lo)
    case 3n _:
      P.Bool.false_true({CT.S(N.op.single(3, size, mode), 3, size, mode) == True{} : Bool}, lo)
    case 4n 0n:
      %Equal.sym(U32, size, 4, V.U.eq_N(size, 4, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 0, V.U.eq_N(mode, 0, ekm)) :
        {CT.S(N.op.single(3, 4, _), 3, 4, _) == True{} : Bool}
      {==}
    case 4n 1n:
      %Equal.sym(U32, size, 4, V.U.eq_N(size, 4, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 1, V.U.eq_N(mode, 1, ekm)) :
        {CT.S(N.op.single(3, 4, _), 3, 4, _) == True{} : Bool}
      {==}
    case 4n 2n:
      %Equal.sym(U32, size, 4, V.U.eq_N(size, 4, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 2, V.U.eq_N(mode, 2, ekm)) :
        {CT.S(N.op.single(3, 4, _), 3, 4, _) == True{} : Bool}
      {==}
    case 4n 3n:
      %Equal.sym(U32, size, 4, V.U.eq_N(size, 4, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 3, V.U.eq_N(mode, 3, ekm)) :
        {CT.S(N.op.single(3, 4, _), 3, 4, _) == True{} : Bool}
      {==}
    case 4n 4n:
      %Equal.sym(U32, size, 4, V.U.eq_N(size, 4, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 4, V.U.eq_N(mode, 4, ekm)) :
        {CT.S(N.op.single(3, 4, _), 3, 4, _) == True{} : Bool}
      {==}
    case 4n 5n:
      %Equal.sym(U32, size, 4, V.U.eq_N(size, 4, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 5, V.U.eq_N(mode, 5, ekm)) :
        {CT.S(N.op.single(3, 4, _), 3, 4, _) == True{} : Bool}
      {==}
    case 4n 6n:
      %Equal.sym(U32, size, 4, V.U.eq_N(size, 4, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 6, V.U.eq_N(mode, 6, ekm)) :
        {CT.S(N.op.single(3, 4, _), 3, 4, _) == True{} : Bool}
      {==}
    case 4n 7n:
      %Equal.sym(U32, size, 4, V.U.eq_N(size, 4, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 7, V.U.eq_N(mode, 7, ekm)) :
        {CT.S(N.op.single(3, 4, _), 3, 4, _) == True{} : Bool}
      {==}
    case 4n 8n:
      %Equal.sym(U32, size, 4, V.U.eq_N(size, 4, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 8, V.U.eq_N(mode, 8, ekm)) :
        {CT.S(N.op.single(3, 4, _), 3, 4, _) == True{} : Bool}
      {==}
    case 4n 9n+r:
      P.Bool.false_true({CT.S(N.op.single(3, size, mode), 3, size, mode) == True{} : Bool}, hm)
    case 5n 0n:
      %Equal.sym(U32, size, 5, V.U.eq_N(size, 5, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 0, V.U.eq_N(mode, 0, ekm)) :
        {CT.S(N.op.single(3, 5, _), 3, 5, _) == True{} : Bool}
      {==}
    case 5n 1n:
      %Equal.sym(U32, size, 5, V.U.eq_N(size, 5, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 1, V.U.eq_N(mode, 1, ekm)) :
        {CT.S(N.op.single(3, 5, _), 3, 5, _) == True{} : Bool}
      {==}
    case 5n 2n:
      %Equal.sym(U32, size, 5, V.U.eq_N(size, 5, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 2, V.U.eq_N(mode, 2, ekm)) :
        {CT.S(N.op.single(3, 5, _), 3, 5, _) == True{} : Bool}
      {==}
    case 5n 3n:
      %Equal.sym(U32, size, 5, V.U.eq_N(size, 5, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 3, V.U.eq_N(mode, 3, ekm)) :
        {CT.S(N.op.single(3, 5, _), 3, 5, _) == True{} : Bool}
      {==}
    case 5n 4n:
      %Equal.sym(U32, size, 5, V.U.eq_N(size, 5, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 4, V.U.eq_N(mode, 4, ekm)) :
        {CT.S(N.op.single(3, 5, _), 3, 5, _) == True{} : Bool}
      {==}
    case 5n 5n:
      %Equal.sym(U32, size, 5, V.U.eq_N(size, 5, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 5, V.U.eq_N(mode, 5, ekm)) :
        {CT.S(N.op.single(3, 5, _), 3, 5, _) == True{} : Bool}
      {==}
    case 5n 6n:
      %Equal.sym(U32, size, 5, V.U.eq_N(size, 5, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 6, V.U.eq_N(mode, 6, ekm)) :
        {CT.S(N.op.single(3, 5, _), 3, 5, _) == True{} : Bool}
      {==}
    case 5n 7n:
      %Equal.sym(U32, size, 5, V.U.eq_N(size, 5, eks)) :
        {CT.S(N.op.single(3, _, mode), 3, _, mode) == True{} : Bool}
      %Equal.sym(U32, mode, 7, V.U.eq_N(mode, 7, ekm)) :
        {CT.S(N.op.single(3, 5, _), 3, 5, _) == True{} : Bool}
