law CT.copy.f:
  for +size: U32
  for +mode: U32
  for +km: Nat
  for +ekm: {V.U.N(mode) == km : Nat}
  for +hm: {Cmp.is_le(Nat.cmp(km, 8n)) == True{} : Bool}
  {CT.S(U32.add(U32.add(19, U32.mul(16, mode)), 0), 3, size, mode) == True{} : Bool}

def CT.copy.f(size, mode, km, ekm, hm):
  match km:
    case 0n:
      %Equal.sym(U32, mode, 0, V.U.eq_N(mode, 0, ekm)) :
        {CT.S(U32.add(U32.add(19, U32.mul(16, _)), 0), 3, size, _) == True{} : Bool}
      {==}
    case 1n:
      %Equal.sym(U32, mode, 1, V.U.eq_N(mode, 1, ekm)) :
        {CT.S(U32.add(U32.add(19, U32.mul(16, _)), 0), 3, size, _) == True{} : Bool}
      {==}
    case 2n:
      %Equal.sym(U32, mode, 2, V.U.eq_N(mode, 2, ekm)) :
        {CT.S(U32.add(U32.add(19, U32.mul(16, _)), 0), 3, size, _) == True{} : Bool}
      {==}
    case 3n:
      %Equal.sym(U32, mode, 3, V.U.eq_N(mode, 3, ekm)) :
        {CT.S(U32.add(U32.add(19, U32.mul(16, _)), 0), 3, size, _) == True{} : Bool}
      {==}
    case 4n:
      %Equal.sym(U32, mode, 4, V.U.eq_N(mode, 4, ekm)) :
        {CT.S(U32.add(U32.add(19, U32.mul(16, _)), 0), 3, size, _) == True{} : Bool}
      {==}
    case 5n:
      %Equal.sym(U32, mode, 5, V.U.eq_N(mode, 5, ekm)) :
        {CT.S(U32.add(U32.add(19, U32.mul(16, _)), 0), 3, size, _) == True{} : Bool}
      {==}
    case 6n:
      %Equal.sym(U32, mode, 6, V.U.eq_N(mode, 6, ekm)) :
        {CT.S(U32.add(U32.add(19, U32.mul(16, _)), 0), 3, size, _) == True{} : Bool}
      {==}
    case 7n:
      %Equal.sym(U32, mode, 7, V.U.eq_N(mode, 7, ekm)) :
        {CT.S(U32.add(U32.add(19, U32.mul(16, _)), 0), 3, size, _) == True{} : Bool}
      {==}
    case 8n:
      %Equal.sym(U32, mode, 8, V.U.eq_N(mode, 8, ekm)) :
        {CT.S(U32.add(U32.add(19, U32.mul(16, _)), 0), 3, size, _) == True{} : Bool}
      {==}
    case 9n+r:
      P.Bool.false_true({CT.S(U32.add(U32.add(19, U32.mul(16, mode)), 0), 3, size, mode) == True{} : Bool}, hm)

law CT.copy.c:
  for +size: U32
  for +mode: U32
  for +hm: {Cmp.is_le(Nat.cmp(V.U.N(mode), 8n)) == True{} : Bool}
  for +c: Bool
  for +ec: {Bool.and(U32.is_le(4, size), U32.is_le(size, 18)) == c : Bool}
  {CT.S(N.op.single(3, size, mode), 3, size, mode) == True{} : Bool}

def CT.copy.c(size, mode, hm, c, ec):
  match c:
    case True{}:
      CT.copy.e(size, mode, V.U.N(size), V.U.N(mode), {==}, {==},
        V.U.le_N(4, size, P.Bool.and_l(U32.is_le(4, size), U32.is_le(size, 18), ec)),
        V.U.le_N(size, 18, P.Bool.and_r(U32.is_le(4, size), U32.is_le(size, 18), ec)), hm)
    case False{}:
      %Equal.sym(Bool, Bool.and(U32.is_le(4, size), U32.is_le(size, 18)), False{}, ec) :
        {CT.S(U32.add(U32.add(19, U32.mul(16, mode)), Bool.pick(U32, _, U32.sub(size, 3), 0)), 3, size, mode) == True{} : Bool}
      CT.copy.f(size, mode, V.U.N(mode), {==}, hm)

# A COPY alone.
law CT.copy:
  for +size: U32
  for +mode: U32
  for +hm: {Cmp.is_le(Nat.cmp(V.U.N(mode), 8n)) == True{} : Bool}
  {CT.S(N.op.single(3, size, mode), 3, size, mode) == True{} : Bool}

def CT.copy(size, mode, hm):
  CT.copy.c(size, mode, hm, Bool.and(U32.is_le(4, size), U32.is_le(size, 18)), {==})

law CT.dbl.a.e:
  for +pm: U32
  for +mode: U32
  for +k: Nat
  for +ek: {V.U.N(pm) == k : Nat}
  for +hb: {Cmp.is_le(Nat.cmp(k, 8n)) == True{} : Bool}
