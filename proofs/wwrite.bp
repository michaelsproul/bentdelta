# Reading the pieces back
# -----------------------

law WW.has_pre:
  for +pre: List<&2, U32>
  for +piece: List<&2, U32>
  for +t: A.Tr
  for +p0: U32
  for +pk: U32
  for +hk: {V.U.N(pk) == Nat.add(V.U.N(p0), S.S.len(pre)) : Nat}
  for +h: {S.S.has(K.WD.app(pre, piece), t, p0) == True{} : Bool}
  {S.S.has(pre, t, p0) == True{} : Bool}

def WW.has_pre(pre, piece, t, p0, pk, hk, h):
  P.Bool.and_l(S.S.has(pre, t, p0), S.S.has(piece, t, U32.add(p0, U32.sub(pk, p0))),
    (%K.WD.has_app(pre, piece, t, p0, U32.sub(pk, p0), WW.off(pre, p0, pk, hk)) : {_ == True{} : Bool}; h))

law WW.has_suf:
  for +pre: List<&2, U32>
  for +piece: List<&2, U32>
  for +t: A.Tr
  for +p0: U32
  for +pk: U32
  for +hk: {V.U.N(pk) == Nat.add(V.U.N(p0), S.S.len(pre)) : Nat}
  for +h: {S.S.has(K.WD.app(pre, piece), t, p0) == True{} : Bool}
  {S.S.has(piece, t, pk) == True{} : Bool}

def WW.has_suf(pre, piece, t, p0, pk, hk, h):
  %WW.addsub(p0, pk) : {S.S.has(piece, t, _) == True{} : Bool}
  P.Bool.and_r(S.S.has(pre, t, p0), S.S.has(piece, t, U32.add(p0, U32.sub(pk, p0))),
    (%K.WD.has_app(pre, piece, t, p0, U32.sub(pk, p0), WW.off(pre, p0, pk, hk)) : {_ == True{} : Bool}; h))

law WW.has_cons:
  for +piece: List<&2, U32>
  for +rest: List<&2, U32>
  for +t: A.Tr
  for +pk: U32
  for +pk2: U32
  for +hk: {V.U.N(pk2) == Nat.add(V.U.N(pk), S.S.len(piece)) : Nat}
  for +h1: {S.S.has(piece, t, pk) == True{} : Bool}
  for +h2: {S.S.has(rest, t, pk2) == True{} : Bool}
  {S.S.has(K.WD.app(piece, rest), t, pk) == True{} : Bool}

def WW.has_cons(piece, rest, t, pk, pk2, hk, h1, h2):
  @rw K.WD.has_app(piece, rest, t, pk, U32.sub(pk2, pk), WW.off(piece, pk, pk2, hk))
  @rw WW.addsub(pk, pk2)
  EM_.EM.and2(S.S.has(piece, t, pk), S.S.has(rest, t, pk2), h1, h2)

# A list held in u is held wherever u's bytes are copied.
law WW.has_tr:
  for +xs: List<&2, U32>
  for +u: A.Tr
  for +i: U32
  for +t: A.Tr
  for +q: U32
  for +h1: {S.S.has(xs, u, i) == True{} : Bool}
  for +h2: {S.S.has(S.S.sl(S.S.len(xs), u, i), t, q) == True{} : Bool}
  {S.S.has(xs, t, q) == True{} : Bool}

def WW.has_tr(xs, u, i, t, q, h1, h2):
  match xs:
    case []:
      {==}
    case x <> r:
      @simp
      @rw V.U.is_eq(Y.BP.byt(t, q), U32.and(Y.BP.byt(u, i), 255), P.Bool.and_l(U32.is_eq(Y.BP.byt(t, q), U32.and(Y.BP.byt(u, i), 255)), S.S.has(S.S.sl(S.S.len(r), u, U32.add(i, 1)), t, U32.add(q, 1)), h2))
      @rw V.U.is_eq(Y.BP.byt(u, i), U32.and(x, 255), P.Bool.and_l(U32.is_eq(Y.BP.byt(u, i), U32.and(x, 255)), S.S.has(r, u, U32.add(i, 1)), h1))
      @rw Z.BB.and255(x)
      @rw V.U.is_eq_refl(U32.and(x, 255))
      @simp
      WW.has_tr(r, u, U32.add(i, 1), t, U32.add(q, 1), P.Bool.and_r(U32.is_eq(Y.BP.byt(u, i), U32.and(x, 255)), S.S.has(r, u, U32.add(i, 1)), h1), P.Bool.and_r(U32.is_eq(Y.BP.byt(t, q), U32.and(Y.BP.byt(u, i), 255)), S.S.has(S.S.sl(S.S.len(r), u, U32.add(i, 1)), t, U32.add(q, 1)), h2))

law WW.sb_segb:
  for +z: Bool
  for +cpl: U32
  for +off: U32
  for +ez: {U32.is_lt(0, cpl) == z : Bool}
  {WW.sb(z, cpl, off) == Q.SP.segb(cpl, off) : List<&2, U32>}

def WW.sb_segb(z, cpl, off, ez):
  match z:
    case True{}:
      @unfold Q.SP.segb
      @rwx ez : {U32.is_lt(0, cpl) == True{} : Bool}
      @simp -K.WD.app -R.VI.var
      {==}
    case False{}:
      @unfold Q.SP.segb
      @rwx ez : {U32.is_lt(0, cpl) == False{} : Bool}
      @simp
      {==}

law WW.hdr_eq:
  for +tlen: U32
  for +cpl: U32
  for +off: U32
  for +dl: U32
  for +il: U32
