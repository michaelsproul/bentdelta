# Writing a window
# ================
#
# What win.write appends to the output: the window's bytes as the decoder
# reads them (Q.SP.wb).

# The bytes written from p0 so far are pre, and pk is just past them.
law WW.step:
  for +pre: List<&2, U32>
  for +piece: List<&2, U32>
  for +t: A.Tr
  for +p0: U32
  for +pk: U32
  for +hk: {V.U.N(pk) == Nat.add(V.U.N(p0), S.S.len(pre)) : Nat}
  {S.S.puts(piece, S.S.puts(pre, t, p0), pk) == S.S.puts(K.WD.app(pre, piece), t, p0) : A.Tr}

def WW.step(pre, piece, t, p0, pk, hk):
  @rw K.WD.puts_app(pre, piece, t, p0, U32.sub(pk, p0), WW.off(pre, p0, pk, hk))
  @rw WW.addsub(p0, pk)
  {==}

law WW.addsub:
  for +n: U32
  for +a: U32
  {U32.add(n, U32.sub(a, n)) == a : U32}

def WW.addsub(n, a):
  @rw V.U.add_comm(n, U32.sub(a, n))
  @rw V.U.add_sub(a, n)
  {==}

law WW.off:
  for +pre: List<&2, U32>
  for +p0: U32
  for +pk: U32
  for +hk: {V.U.N(pk) == Nat.add(V.U.N(p0), S.S.len(pre)) : Nat}
  {V.U.N(U32.sub(pk, p0)) == S.S.len(pre) : Nat}

def WW.off(pre, p0, pk, hk):
  P.Nat.add_cancel_l(V.U.N(p0), V.U.N(U32.sub(pk, p0)), S.S.len(pre),
    (%P.Nat.add_comm(V.U.N(U32.sub(pk, p0)), V.U.N(p0)) : {_ == Nat.add(V.U.N(p0), S.S.len(pre)) : Nat};
      (%Equal.sym(Nat, Nat.add(V.U.N(U32.sub(pk, p0)), V.U.N(p0)), V.U.N(pk), V.U.sub_nat(pk, p0, V.U.N_le(p0, pk, (%Equal.sym(Nat, V.U.N(pk), Nat.add(V.U.N(p0), S.S.len(pre)), hk) : {Cmp.is_le(Nat.cmp(V.U.N(p0), _)) == True{} : Bool}; P.Nat.cmp_add_r(V.U.N(p0), S.S.len(pre)))))) : {_ == Nat.add(V.U.N(p0), S.S.len(pre)) : Nat};
        hk)))

# The position after a piece of x bytes.
law WW.pos:
  for +pre: List<&2, U32>
  for +piece: List<&2, U32>
  for +p0: U32
  for +pk: U32
  for +x: U32
  for +Eo: U32
  for +hk: {V.U.N(pk) == Nat.add(V.U.N(p0), S.S.len(pre)) : Nat}
  for +hx: {V.U.N(x) == S.S.len(piece) : Nat}
  for +hb: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(p0), S.S.len(K.WD.app(pre, piece))), V.U.N(Eo))) == True{} : Bool}
  {V.U.N(U32.add(pk, x)) == Nat.add(V.U.N(p0), S.S.len(K.WD.app(pre, piece))) : Nat}

def WW.pos(pre, piece, p0, pk, x, Eo, hk, hx, hb):
  @rw K.WD.len_app(pre, piece)
  @rw- P.Nat.add_assoc(V.U.N(p0), S.S.len(pre), S.S.len(piece))
  @rwx- hk : {V.U.N(pk) == Nat.add(V.U.N(p0), S.S.len(pre)) : Nat}
  @rwx- hx : {V.U.N(x) == S.S.len(piece) : Nat}
  V.U.add_N(pk, x, Eo, WW.pos.b(pre, piece, p0, pk, x, Eo, hk, hx, hb))

law WW.pos.b:
  for +pre: List<&2, U32>
  for +piece: List<&2, U32>
  for +p0: U32
  for +pk: U32
  for +x: U32
  for +Eo: U32
  for +hk: {V.U.N(pk) == Nat.add(V.U.N(p0), S.S.len(pre)) : Nat}
  for +hx: {V.U.N(x) == S.S.len(piece) : Nat}
  for +hb: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(p0), S.S.len(K.WD.app(pre, piece))), V.U.N(Eo))) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(pk), V.U.N(x)), V.U.N(Eo))) == True{} : Bool}

def WW.pos.b(pre, piece, p0, pk, x, Eo, hk, hx, hb):
  @rwx hk : {V.U.N(pk) == Nat.add(V.U.N(p0), S.S.len(pre)) : Nat}
  @rwx hx : {V.U.N(x) == S.S.len(piece) : Nat}
  @rw P.Nat.add_assoc(V.U.N(p0), S.S.len(pre), S.S.len(piece))
  @rw- K.WD.len_app(pre, piece)
  hb

law WW.byte:
  for +v: U32
  for +pre: List<&2, U32>
  for +t: A.Tr
  for +p0: U32
  for +pk: U32
  for +hk: {V.U.N(pk) == Nat.add(V.U.N(p0), S.S.len(pre)) : Nat}
  {N.wr.byte(v, (A.A.from(S.S.puts(pre, t, p0)), pk)) == (A.A.from(S.S.puts(K.WD.app(pre, v <> []), t, p0)), U32.add(pk, 1)) : Array<U32> & U32}

def WW.byte(v, pre, t, p0, pk, hk):
  @unfold N.wr.byte
  @simp -S.S.puts -K.WD.app
  @rw Y.BP.put_from(S.S.puts(pre, t, p0), pk, v)
  @rw- WW.step(pre, v <> [], t, p0, pk, hk)
  @simp -Y.BP.put
  {==}

law WW.var:
  for +v: U32
  for +pre: List<&2, U32>
  for +t: A.Tr
  for +p0: U32
  for +pk: U32
  for +hk: {V.U.N(pk) == Nat.add(V.U.N(p0), S.S.len(pre)) : Nat}
  {N.wr.var(v, (A.A.from(S.S.puts(pre, t, p0)), pk)) == (A.A.from(S.S.puts(K.WD.app(pre, R.VI.var(v)), t, p0)), U32.add(pk, B.B.var.len(v))) : Array<U32> & U32}

def WW.var(v, pre, t, p0, pk, hk):
  @unfold N.wr.var
  @simp -S.S.puts -K.WD.app -B.B.var.put
  @rw R.VI.put(S.S.puts(pre, t, p0), pk, v)
  @rw WW.step(pre, R.VI.var(v), t, p0, pk, hk)
  {==}

law WW.copy:
  for +u: A.Tr
  for +n: U32
  for +pre: List<&2, U32>
  for +t: A.Tr
  for +p0: U32
  for +pk: U32
  for +Eo: U32
  for +hk: {V.U.N(pk) == Nat.add(V.U.N(p0), S.S.len(pre)) : Nat}
  for +hd: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(n), V.U.N(pk)), V.U.N(Eo))) == True{} : Bool}
  for +hs: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(n), V.U.N(0)), V.U.N(Eo))) == True{} : Bool}
  {B.B.copy(A.A.from(S.S.puts(pre, t, p0)), pk, A.A.from(u), 0, n) == (A.A.from(u), A.A.from(S.S.puts(K.WD.app(pre, S.S.sl(V.U.N(n), u, 0)), t, p0))) : Array<U32> & Array<U32>}

def WW.copy(u, n, pre, t, p0, pk, Eo, hk, hd, hs):
  @rw C.CP.copy(S.S.puts(pre, t, p0), pk, u, 0, n, Eo, hd, hs)
  @rw WW.step(pre, S.S.sl(V.U.N(n), u, 0), t, p0, pk, hk)
  {==}

# The copy segment's fields, if there is a segment.
def WW.sb(+z: Bool, +cpl: U32, +off: U32) -> List<&2, U32>:
  match z:
    case True{}:
      K.WD.app(R.VI.var(cpl), R.VI.var(off))
    case False{}:
      []

def WW.sp(+z: Bool, +cpl: U32, +off: U32, +pk: U32) -> U32:
  match z:
    case True{}:
      U32.add(U32.add(pk, B.B.var.len(cpl)), B.B.var.len(off))
    case False{}:
      pk

law WW.seg:
  for +z: Bool
  for +cpl: U32
  for +off: U32
  for +pre: List<&2, U32>
  for +t: A.Tr
  for +p0: U32
  for +pk: U32
  for +Eo: U32
  for +hk: {V.U.N(pk) == Nat.add(V.U.N(p0), S.S.len(pre)) : Nat}
  for +hb: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(p0), S.S.len(K.WD.app(pre, WW.sb(z, cpl, off)))), V.U.N(Eo))) == True{} : Bool}
  {N.wr.seg(z, cpl, off, (A.A.from(S.S.puts(pre, t, p0)), pk)) == (A.A.from(S.S.puts(K.WD.app(pre, WW.sb(z, cpl, off)), t, p0)), WW.sp(z, cpl, off, pk)) : Array<U32> & U32}

def WW.seg(z, cpl, off, pre, t, p0, pk, Eo, hk, hb):
  match z:
    case True{}:
      @unfold N.wr.seg WW.sb WW.sp
      @simp -S.S.puts -K.WD.app -N.wr.var -R.VI.var -B.B.var.len
      @rw WW.var(cpl, pre, t, p0, pk, hk)
      @rw WW.var(off, K.WD.app(pre, R.VI.var(cpl)), t, p0, U32.add(pk, B.B.var.len(cpl)), WW.pos(pre, R.VI.var(cpl), p0, pk, B.B.var.len(cpl), Eo, hk, Equal.sym(Nat, S.S.len(R.VI.var(cpl)), V.U.N(B.B.var.len(cpl)), R.VI.len_var(cpl)), WW.segb1(cpl, off, pre, p0, Eo, hb)))
      @rw K.WD.app_assoc(pre, R.VI.var(cpl), R.VI.var(off))
      {==}
    case False{}:
      @unfold N.wr.seg WW.sb WW.sp
      @simp -S.S.puts -K.WD.app
      @rw K.WD.app_nil(pre)
      {==}

law WW.segb1:
  for +cpl: U32
  for +off: U32
  for +pre: List<&2, U32>
  for +p0: U32
  for +Eo: U32
  for +hb: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(p0), S.S.len(K.WD.app(pre, K.WD.app(R.VI.var(cpl), R.VI.var(off))))), V.U.N(Eo))) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(p0), S.S.len(K.WD.app(pre, R.VI.var(cpl)))), V.U.N(Eo))) == True{} : Bool}

def WW.segb1(cpl, off, pre, p0, Eo, hb):
  P.Nat.le_trans(Nat.add(V.U.N(p0), S.S.len(K.WD.app(pre, R.VI.var(cpl)))), Nat.add(V.U.N(p0), S.S.len(K.WD.app(pre, K.WD.app(R.VI.var(cpl), R.VI.var(off))))), V.U.N(Eo),
    WW.lea(V.U.N(p0), S.S.len(K.WD.app(pre, R.VI.var(cpl))), S.S.len(K.WD.app(pre, K.WD.app(R.VI.var(cpl), R.VI.var(off)))),
      (%K.WD.app_assoc(pre, R.VI.var(cpl), R.VI.var(off)) : {Cmp.is_le(Nat.cmp(S.S.len(K.WD.app(pre, R.VI.var(cpl))), S.S.len(_))) == True{} : Bool};
        WW.len_le(K.WD.app(pre, R.VI.var(cpl)), R.VI.var(off)))),
    hb)

law WW.lea:
  for +a: Nat
  for +x: Nat
  for +y: Nat
  for +h: {Cmp.is_le(Nat.cmp(x, y)) == True{} : Bool}
  {Cmp.is_le(Nat.cmp(Nat.add(a, x), Nat.add(a, y))) == True{} : Bool}

def WW.lea(a, x, y, h):
  %Equal.sym(Cmp, Nat.cmp(Nat.add(a, x), Nat.add(a, y)), Nat.cmp(x, y), P.Nat.cmp_add_l(a, x, y)) : {Cmp.is_le(_) == True{} : Bool}
  h

# A list is no longer than itself and more.
law WW.len_le:
  for +xs: List<&2, U32>
  for +ys: List<&2, U32>
  {Cmp.is_le(Nat.cmp(S.S.len(xs), S.S.len(K.WD.app(xs, ys)))) == True{} : Bool}

def WW.len_le(xs, ys):
  @rw K.WD.len_app(xs, ys)
  P.Nat.cmp_add_r(S.S.len(xs), S.S.len(ys))

law WW.byte0:
  for +v: U32
  for +t: A.Tr
  for +p: U32
  {N.wr.byte(v, (A.A.from(t), p)) == (A.A.from(S.S.puts(v <> [], t, p)), U32.add(p, 1)) : Array<U32> & U32}

def WW.byte0(v, t, p):
  @unfold N.wr.byte
  @simp -Y.BP.put
  @rw Y.BP.put_from(t, p, v)
  {==}

law WW.seg_pos:
  for +z: Bool
  for +cpl: U32
  for +off: U32
  for +pre: List<&2, U32>
  for +p0: U32
  for +pk: U32
  for +Eo: U32
  for +hk: {V.U.N(pk) == Nat.add(V.U.N(p0), S.S.len(pre)) : Nat}
  for +hb: {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(p0), S.S.len(K.WD.app(pre, WW.sb(z, cpl, off)))), V.U.N(Eo))) == True{} : Bool}
  {V.U.N(WW.sp(z, cpl, off, pk)) == Nat.add(V.U.N(p0), S.S.len(K.WD.app(pre, WW.sb(z, cpl, off)))) : Nat}

def WW.seg_pos(z, cpl, off, pre, p0, pk, Eo, hk, hb):
  match z:
    case True{}:
      @unfold WW.sp WW.sb
      @rw- K.WD.app_assoc(pre, R.VI.var(cpl), R.VI.var(off))
      WW.pos(K.WD.app(pre, R.VI.var(cpl)), R.VI.var(off), p0, U32.add(pk, B.B.var.len(cpl)), B.B.var.len(off), Eo,
        WW.pos(pre, R.VI.var(cpl), p0, pk, B.B.var.len(cpl), Eo, hk, Equal.sym(Nat, S.S.len(R.VI.var(cpl)), V.U.N(B.B.var.len(cpl)), R.VI.len_var(cpl)), WW.segb1(cpl, off, pre, p0, Eo, hb)),
        Equal.sym(Nat, S.S.len(R.VI.var(off)), V.U.N(B.B.var.len(off)), R.VI.len_var(off)),
        (%Equal.sym(List<&2, U32>, K.WD.app(K.WD.app(pre, R.VI.var(cpl)), R.VI.var(off)), K.WD.app(pre, K.WD.app(R.VI.var(cpl), R.VI.var(off))), K.WD.app_assoc(pre, R.VI.var(cpl), R.VI.var(off))) : {Cmp.is_le(Nat.cmp(Nat.add(V.U.N(p0), S.S.len(_)), V.U.N(Eo))) == True{} : Bool}; hb))
    case False{}:
      @unfold WW.sp WW.sb
      @rw K.WD.app_nil(pre)
      hk

